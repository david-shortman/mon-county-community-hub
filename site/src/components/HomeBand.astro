---
// "There's more to Mon County here" (#1038): six question cards below search
// on the home page, from content/home-band.yaml. Text only. A card shows only
// when its page exists, so no card leads to a missing page.
import fs from 'node:fs';
import path from 'node:path';
import YAML from 'yaml';
import { CONTENT_DIR } from '../lib/content.mjs';
import { loadPages } from '../lib/pages.mjs';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const file = path.join(CONTENT_DIR, 'home-band.yaml');
const band = fs.existsSync(file) ? YAML.parse(fs.readFileSync(file, 'utf8')) ?? {} : {};
const pages = await loadPages();
const live = (href) => pages.has(href.split(/[?#]/)[0]);
const cards = (band.cards ?? []).filter((c) => live(c.href)).slice(0, 6);
const more = (band.more ?? []).filter((m) => live(m.href));
---
{cards.length > 0 && (
  <section class="home-band" aria-labelledby="home-band-h">
    <h2 id="home-band-h">{band.title}</h2>
    <ul>
      {cards.map((c) => (
        <li><a href={`${base}${c.href}`}><strong>{c.q}</strong><span>{c.hint}</span></a></li>
      ))}
    </ul>
    {more.length > 0 && <p class="home-band-more">{more.map((m) => <a href={`${base}${m.href}`}>{m.text}</a>)}</p>}
  </section>
)}

<style>
  .home-band { margin: 24px 0; }
  .home-band ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: 8px; }
  @media (min-width: 560px) { .home-band ul { grid-template-columns: 1fr 1fr; } }
  .home-band a { display: block; min-height: 44px; }
  .home-band li a { height: 100%; box-sizing: border-box; padding: 10px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--card); color: var(--fg); text-decoration: none; }
  .home-band li a:hover strong { text-decoration: underline; }
  .home-band strong { display: block; color: var(--accent); }
  .home-band span { display: block; color: var(--muted); font-size: 0.95rem; }
  .home-band-more { display: flex; flex-wrap: wrap; gap: 0 20px; margin: 10px 0 0; }
  .home-band-more a { display: inline-flex; align-items: center; }
</style>
