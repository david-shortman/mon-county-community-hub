---
// A short "I'm a ..." starting page for one resident group (#261). It only
// links to pages on this site, so it states no facts of its own: every phone,
// date and cost lives on the linked page with its source. A link shows only
// once its page exists, and a section with no live links is left out, so the
// page grows as the group's build issues ship. Research: docs/groups/.
//
// sections: [{ title, links: [{ href, text }] }]
// href is a site route, and may carry a ?pick= or #part (checked by path).
import { loadPages } from '../lib/pages.mjs';
const { sections } = Astro.props;
const pages = await loadPages();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const live = sections
  .map((s) => ({
    ...s,
    links: s.links
      .filter((l) => pages.has(l.href.split(/[?#]/)[0]))
      .map((l) => ({ ...l, label: l.label ?? pages.get(l.href.split(/[?#]/)[0]).label })),
  }))
  .filter((s) => s.links.length);
---
{live.map((s) => (
  <section>
    <h2>{s.title}</h2>
    <ul class="group-links">
      {s.links.map((l) => <li><a href={`${base}${l.href}`}><strong>{l.label}</strong></a>: {l.text}</li>)}
    </ul>
  </section>
))}
<p class="meta">This page links to our other pages, where each listing shows its source and the date we checked it. More links appear here as we add pages. Something missing? <a href="https://github.com/david-shortman/mon-county-community-hub/issues/new?template=suggest-resource.yml">Tell us</a>.</p>

<style>
  .group-links { padding-left: 1.2rem; }
  .group-links li { margin-bottom: 0.5rem; }
</style>
