---
// A PDF page record (#393, content/pdf-pages/): each section is a heading and
// a short list, each item a bold name with labeled lines under it. No wide
// tables, so nothing squeezes or runs off the edge on a phone (#917). Under
// the record: where it came from, the date printed on the PDF, a link to the
// original, and our checked date.
//   d: the record, from pdfPage(slug)
//   level: heading level for section headings (default 2)
import SourceLine from './SourceLine.astro';
import { pdfPageDue } from '../lib/pdf-pages.mjs';
const { d, level = 2 } = Astro.props;
const H = `h${level}`;
const sid = (s, i) => s.id ?? `${d.slug}-${i + 1}`;
---
<div class="from-pdf">
  {d.pdf && (
    <p class="pdf-origin">
      From: {d.publisher}, <a href={d.pdf}>{d.title} (PDF)</a>. The PDF says: {d.pdf_date}.
      {d.found_on && <> It is linked from <a href={d.found_on}>this page<span class="sr-only"> on the {d.publisher} website</span></a>.</>}
    </p>
  )}
  {d.intro && <p>{d.intro}</p>}
  {d.sections.map((s, i) => (
    <section aria-labelledby={sid(s, i)}>
      <H id={sid(s, i)}>{s.heading}</H>
      {s.note && <p>{s.note}</p>}
      <ul class="pdf-items">
        {s.items.map((it) => typeof it === 'string' ? <li>{it}</li> : (
          it.lines?.length === 1 && !it.links?.length ? <li><strong>{it.name}:</strong> {it.lines[0]}</li> : <li>
            <strong class="pdf-item-name">{it.name}</strong>
            {it.lines?.length > 0 && (
              <ul class="pdf-lines">{it.lines.map((l) => <li>{l}</li>)}</ul>
            )}
            {it.links?.length > 0 && (
              <ul class="pdf-links">{it.links.map((l) => <li><a href={l.url} lang={l.lang}>{l.label}<span class="sr-only"> for {it.name}</span></a>{l.date && <> (the PDF says: {l.date})</>}</li>)}</ul>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}
  <SourceLine sources={d.sources} about={d.title} stale={pdfPageDue(d)} />
</div>

<style>
  .pdf-origin { font-size: 0.95rem; }
  .pdf-items { list-style: none; padding-left: 0; }
  .pdf-items > li { padding: 10px 0; border-bottom: 1px solid var(--line); overflow-wrap: break-word; }
  .pdf-items > li:last-child { border-bottom: none; }
  .pdf-item-name { display: block; }
  .pdf-lines, .pdf-links { margin: 4px 0 0; padding-left: 1.2em; }
  .pdf-links li { margin: 6px 0; }
  .pdf-links a { display: inline-block; padding: 6px 0; }
</style>
