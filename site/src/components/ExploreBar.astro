---
// The explorer's bar on /topics/ (#2027): shown by the ExploreChips script
// once something is picked. It sits at the end of the explorer wrapper in
// topics.astro with position: sticky, so it stays at the bottom of the screen
// while you read the rest of the page, can never sit over Help now (above the
// wrapper), and takes its own space at the end so it never covers the last
// line. Hidden with no script. Close hides it until the next visit.
---
<div class="explore-bar" id="explore-bar" role="region" aria-label="Your picks" hidden>
  <button class="eb-btn" type="button" data-act="surprise">Surprise me</button>
  <button class="eb-btn" type="button" data-act="clear">Clear picks</button>
  <button class="eb-btn eb-close" type="button" data-act="close" aria-label="Close this bar">Close</button>
</div>

<style>
  /* On phones the site menu is a fixed tab bar at the bottom (--tabbar in Base.astro), so this sits just above it. */
  .explore-bar { position: sticky; bottom: var(--tabbar, env(safe-area-inset-bottom)); z-index: 5; display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin: 16px -8px 0; padding: 6px 8px; background: var(--bg); border-top: 2px solid var(--accent); }
  .explore-bar[hidden] { display: none; }
  .eb-btn { display: inline-flex; align-items: center; min-height: 44px; padding: 4px 12px; border: 2px solid var(--accent); border-radius: 22px; background: var(--card); color: var(--fg); font: inherit; font-size: 0.95rem; font-weight: 600; text-decoration: none; cursor: pointer; }
  .eb-btn:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .eb-close { margin-left: auto; }
  @media print { .explore-bar { display: none !important; } }
</style>
