---
// One door's guided page (#248, piloted as Get care in #235). Same shape for
// every door, from content/doors/<slug>.yaml:
//   1. Title and one line, then the "can't wait" strip.
//   2. "What's going on? Pick all that fit." Without scripts, plain links to
//      each situation's page. With scripts, checkboxes in a form whose picks
//      ride in the web address (?pick=a&pick=b), so nothing is stored and a
//      person can text or bookmark their steps.
//   3. Your steps: one list for everything picked, grouped Today, This week,
//      When it opens, each step ending in an action (Trailhead, #237).
//   4. Often goes with this, dates for this door, the door's own sections
//      (the slot), every page in the door, and a person to talk to.
// A situation shows only once its page exists. Steps carry no facts of their
// own: phone, link, cost and source come from the step's resource record.
import Actions from './Actions.astro';
import EventCard from './EventCard.astro';
import SourceLine from './SourceLine.astro';
import AfterHours from './AfterHours.astro';
import { loadDoors, loadDoorPage, loadCalendarWithFeeds, upcoming, telHref, resource, websiteLabel } from '../lib/content.mjs';
import { loadPages, doorTopics } from '../lib/pages.mjs';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// A topic guide (like /grow/, #437) uses the same layout from
// content/guides/<guide>.yaml: it names its door, topic and page.
const { slug, guide } = Astro.props;
const data = guide ? loadDoorPage(guide, 'guides') : loadDoorPage(slug);
const door = loadDoors().bySlug[guide ? data.door : slug];
const home = guide ? data.page : door.page;
const ask = data.ask ?? "What's going on? Pick all that fit.";
const pages = await loadPages();
const live = (href) => pages.has(href.split(/[?#]/)[0]);
const situations = data.situations.filter((s) => live(s.page));
const groups = [['today', 'Today'], ['week', 'This week'], ['season', 'This season'], ['opens', 'When it opens']];
// Each step once, with every live situation that uses it.
const stepSits = (id) => situations.filter((s) => (s.steps ?? []).includes(id));
// A situation with no steps (a whole section, like Community centers) shows as a
// "Start here" link to its page instead.
const pageOnly = situations.filter((s) => !(s.steps ?? []).length);
const steps = Object.values(data.steps).filter((st) => stepSits(st.id).length);
const also = data.also.filter((a) => live(a.href));
const topics = guide ? [data.topic] : Object.keys(door.topics);
const dates = upcoming(await loadCalendarWithFeeds(), undefined, 120).filter((e) => (e.topics ?? []).some((t) => topics.includes(t))).slice(0, 4);
const inDoor = (await doorTopics(door.slug)).filter((t) => !guide || t.topic === data.topic).map((t) => ({ ...t, pages: t.pages.filter((p) => p.route !== home) })).filter((t) => t.pages.length);
const cw = data.cant_wait && resource(data.cant_wait.resource);
// The text line: set in the door file (988 texts at its own number), or the record's text line (211 texts at 898-211).
const cwSms = cw && (data.cant_wait.sms ?? cw.contact.text);
const r211 = resource('wv-211');
// The after hours box (#192) shows on the doors people use to get help, with
// any step that can be started online.
const helpDoor = !guide && ['this-month', 'care', 'family'].includes(slug);
const online = steps.map((st) => resource(st.resource)).filter((r, i, a) => r?.contact?.url_label === 'Apply online' && a.indexOf(r) === i);
---
<p class="lede">{data.lede}</p>

{cw && (
  <section class="right-now cant-wait" aria-label="Can't wait">
    <p>{data.cant_wait.text}</p>
    <div class="crisis-btns">
      <a class="btn" href={telHref(cw.contact.phone)}><span>Call {cw.contact.phone}<span class="sr-only">, {cw.title}</span></span></a>
      {cwSms && <a class="btn" href={`sms:${cwSms.replace(/[^\d]/g, '')}`}><span>Text {cwSms}<span class="sr-only">, {cw.title}{cw.contact.text ? ', send your ZIP code' : ''}</span></span></a>}
      {data.cant_wait.emergency && <a class="btn" href="tel:911"><span>Call 911<span class="sr-only">, emergency</span></span></a>}
    </div>
    <SourceLine sources={cw.sources} org={cw.org} about={cw.title}>{data.cant_wait.emergency && ' 911 is the standard emergency number.'}</SourceLine>
  </section>
)}

{helpDoor && <AfterHours online={online} />}

<h2 id="pick-h">{ask}</h2>
<ul class="topic-list sit-links" id="door-links">
  {situations.map((s) => <li><a href={`${base}${s.page}`}>{s.label}</a></li>)}
</ul>
<form class="door-pick" id="door-pick" method="get" action={`${base}${home}`} hidden aria-labelledby="pick-h">
  <fieldset>
    <legend class="sr-only">{ask}</legend>
    <ul class="pick">
      {situations.map((s) => (
        <li><label><input type="checkbox" name="pick" value={s.id} /><span>{s.label}</span></label></li>
      ))}
    </ul>
  </fieldset>
  <button class="btn btn-primary" type="submit">Show my steps</button>
</form>
<p class="note" id="door-nomatch" hidden>We could not find steps for that link. Pick what is going on above, or call or text 211.</p>

<section class="door-plan" id="door-plan" hidden aria-labelledby="door-plan-h">
  <h2 id="door-plan-h" tabindex="-1">Your steps</h2>
  {pageOnly.length > 0 && (
    <div class="step-group">
      <h3>Start here</h3>
      <ol class="steps">
        {pageOnly.map((s) => <li class="step" data-sits={s.id}><p><a href={`${base}${s.page}`}>{s.label}</a>{s.text && ` ${s.text}`}</p></li>)}
      </ol>
    </div>
  )}
  {groups.map(([when, label]) => {
    const list = steps.filter((st) => st.when === when);
    return list.length > 0 && (
      <div class="step-group">
        <h3>{label}</h3>
        <ol class="steps">
          {list.map((st) => {
            const r = st.record;
            const first = stepSits(st.id)[0];
            return (
              <li class="step" data-sits={stepSits(st.id).map((s) => s.id).join(' ')}>
                <p>{st.text}</p>
                <Actions callFirst phone={r.contact?.phone} phoneLabel={r.title} link={r.contact?.url} linkLabel={st.action ?? websiteLabel(r)} place={r.contact?.place} about={r.title} />
                {r.cost && <p class="step-cost"><strong>Cost:</strong> {r.cost === 'free' ? 'Free.' : r.cost}</p>}
                <SourceLine sources={r.sources} org={r.org} about={r.title}><Fragment slot="before">More on this: <a href={`${base}${first.page}`}>{first.label}</a>{/[?!.]$/.test(first.label) ? ' ' : '. '}</Fragment></SourceLine>
              </li>
            );
          })}
        </ol>
      </div>
    );
  })}
  <div class="actions keep-steps">
    <a class="btn" id="text-steps" href="sms:"><span>Text these steps to myself</span></a>
    <button class="btn" type="button" id="print-steps"><span>Print</span></button>
  </div>
  <p><a href={`${base}${home}`}>Start over</a>. Your picks are only in this page's web address. Nothing is saved.</p>
</section>

{also.length > 0 && (
  <>
    <h2>Often goes with this</h2>
    <ul class="topic-list">{also.map((a) => <li><a href={`${base}${a.href}`}>{a.text}</a></li>)}</ul>
  </>
)}

<h2>Dates for this</h2>
{dates.length ? dates.map((e) => <EventCard e={e} />) : <p>No dates for this on our calendar right now. <a href={`${base}/calendar/`}>See all dates</a>.</p>}

<slot />

{inDoor.length > 0 && <h2>{guide ? `Every ${door.topics[data.topic]} page` : `Every ${door.name} page`}</h2>}
{inDoor.map((t) => (
  <>
    <h3>{t.label}</h3>
    <ul class="topic-list">{t.pages.map((p) => <li><a href={`${base}${p.route}`}>{p.label}</a><span class="hint">{p.summary}</span></li>)}</ul>
  </>
))}

<section class="note" aria-labelledby="person-h">
  <h2 id="person-h">Rather talk to a person?</h2>
  <p>Call <a href={telHref(r211.contact.phone)}>{r211.contact.phone}</a>. It is a free West Virginia help line, open any hour. Tell them what is going on and they will point you to local help.</p>
</section>

<script is:inline>
  // Optional: the page works without it. Turns the links into checkboxes and
  // shows the steps for the picks in the web address.
  (function () {
    var form = document.getElementById('door-pick');
    var links = document.getElementById('door-links');
    var plan = document.getElementById('door-plan');
    if (!form || !plan) return;
    form.hidden = false; links.hidden = true;
    var picks = new URLSearchParams(location.search).getAll('pick');
    form.querySelectorAll('input[name="pick"]').forEach(function (i) { i.checked = picks.indexOf(i.value) > -1; });
    if (!picks.length) return;
    var shown = 0;
    plan.querySelectorAll('.step').forEach(function (s) {
      var on = s.dataset.sits.split(' ').some(function (x) { return picks.indexOf(x) > -1; });
      s.hidden = !on; if (on) shown++;
    });
    plan.querySelectorAll('.step-group').forEach(function (g) { g.hidden = !g.querySelector('.step:not([hidden])'); });
    if (!shown) { links.hidden = false; form.hidden = true; document.getElementById('door-nomatch').hidden = false; return; }
    plan.hidden = false;
    // Text the link to these steps (the picks are in it), or print them.
    document.getElementById('text-steps').href = 'sms:?&body=' + encodeURIComponent(location.href);
    document.getElementById('print-steps').addEventListener('click', function () { window.print(); });
    // Land with "Your steps" at the top of the screen (#449). A plain focus()
    // scrolls only far enough to show the heading, often at the bottom.
    var h = document.getElementById('door-plan-h');
    h.focus({ preventScroll: true });
    h.scrollIntoView({ block: 'start' });
  })();
</script>
