---
// One date on the calendar, phone first: when it is, what it is, then big
// buttons to act on it. Sources and topics sit in the small print below.
import Actions from './Actions.astro';
import PassItOn from './PassItOn.astro';
import Icon from './Icon.astro';
import { townLine } from '../lib/towns.mjs';
import { prettyDate, prettyRange, prettyTimes, chipDate, relativeLabel, sourceLabel, isGovSite, todayYmd, oldestChecked, isStale, reportUrl, loadDoors } from '../lib/content.mjs';
const { e } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const today = todayYmd();
// Turn phone numbers in the text into tappable links: 304-555-1234,
// (304) 555-1234, 1-800-555-1234, and an extension like "ext. 12" (#149).
const phoneRe = /((?:1[-. ])?\(?\d{3}\)?[-. ]\d{3}[-. ]\d{4}(?:,? (?:ext\.?|x) ?\d+)?)/i;
const phoneHref = (t) => { const [main, ext] = t.split(/,? (?:ext\.?|x) ?/i); return `tel:${main.replace(/\D/g, '')}${ext ? `,${ext}` : ''}`; };
const parts = (e.what_to_do || '').split(phoneRe);
// The oldest source date, so a card never looks fresher than it is (#39).
const checked = oldestChecked(e.sources);
// Feed entries say which feed and when; hand-written ones say when a person checked.
const fetchedOn = e.feed ? new Intl.DateTimeFormat('en-CA', { timeZone: 'America/New_York' }).format(new Date(e.feed.fetched)) : null;

// Share points at this card on the page it is shown on, so the link always lands on it.
const shareUrl = new URL(`${Astro.url.pathname}#${e.slug}`, Astro.site).href;
// The source link is skipped when it is the same page as the main button.
const extraSources = e.sources.filter((s) => s.url !== e.url);
// Topics in the words people see on the doors ("Bills and money"), not the tags (#146).
const doors = loadDoors();
const topicLabel = (t) => doors.bySlug[doors.topicDoor[t]]?.topics[t] ?? t;
---
<article class="card event" id={e.slug}>
  <p class="date-chip">
    <span><time datetime={e.starts}>{chipDate(e.starts, today)}</time>{e.ends !== e.starts && <> to <time datetime={e.ends}>{chipDate(e.ends, today)}</time></>}</span>
    {e.start_time && <span class="time">{prettyTimes(e.start_time, e.end_time)}</span>}
    <span class="rel" data-starts={e.starts} data-ends={e.ends}>{relativeLabel(e.starts, e.ends, today)}</span>
  </p>
  <h3>{e.title}</h3>
  {townLine(e) && <p class="town-line"><Icon name="pin" /><span><span class="sr-only">Where: </span>{townLine(e)}</span></p>}
  <p>{e.who_it_is_for}{' '}{parts.map((t, i) => (i % 2 ? <a href={phoneHref(t)}>{t}</a> : t))}</p>
  {e.start_time && <p class="meta"><strong>{e.phone ? 'Call to confirm the time.' : 'Check the details page to confirm the time.'}</strong></p>}
  <Actions
    link={e.url} linkLabel="More details"
    phone={e.phone} phoneLabel={e.phone_label ?? e.org_name}
    place={e.place}
    ics={`${base}/calendar/${e.slug}.ics`}
    shareUrl={shareUrl} shareTitle={e.title}
    about={`${e.title}, ${prettyDate(e.starts)}`}
  />
  <p class="meta">
    {e.feed ? (
      <>Pulled from the <a href={e.feed.page_url}>{e.feed.name}</a> on {prettyDate(fetchedOn)}.</>
    ) : (
      <>Run by {e.org_name}.
      {extraSources.length ? <> Source: {extraSources.map((s, i) => (<>{i > 0 && ', '}<a href={s.url}>{sourceLabel(s.url)}</a>{isGovSite(s.url) && ' (government site)'}</>))}.</> : <> Source: {sourceLabel(e.url)}{isGovSite(e.url) ? ' (the details page, a government site)' : ' (the details page)'}.</>}
      {' '}Checked against the source on {prettyDate(checked)}.{isStale(checked, today) && <strong> This may be out of date, so check the details page before you go.</strong>}</>
    )}
    {e.topics?.length ? <> Topics: {e.topics.map(topicLabel).join(', ')}.</> : null}
    {' '}<a href={reportUrl({ title: e.title, slug: e.slug, url: e.sources?.[0]?.url ?? e.url })}>Report a problem<span class="sr-only"> with {e.title} (opens GitHub)</span></a>.
  </p>
  <PassItOn title={`${e.title}, ${prettyRange(e.starts, e.ends)}`} slug={e.slug} phone={e.phone} place={e.place} checked={checked} share={false} />
</article>

<style is:global>
  /* Town or neighborhood under the title (#395): plain text, not a link. */
  .town-line { display: flex; align-items: center; gap: 6px; margin: 0 0 6px; font-weight: 600; color: var(--muted); }
  .town-line .icon { width: 18px; height: 18px; }
</style>
