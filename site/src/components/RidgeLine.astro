---
// The hub's one local motif: a straight line with very small silhouettes of
// places here sitting on it (trees, the knob, brick downtown, hillside
// houses, the glass factory stack, the rail-trail bridge, the Wharf
// warehouses). It is the bottom border of the header on wide screens and the
// top edge of the tab bar on phones. Decorative only, hidden from screen
// readers. Shapes and sources: src/lib/skyline.mjs. Rules:
// docs/design/identity.md.
import { SKYLINE } from '../lib/skyline.mjs';
const { class: cls = '' } = Astro.props;
---
<svg class={`ridge ${cls}`} aria-hidden="true" focusable="false" viewBox={`0 0 ${SKYLINE.width} ${SKYLINE.height}`} preserveAspectRatio="xMidYMax slice">
  <path class="ridge-shapes" d={SKYLINE.fill} />
  <path class="ridge-line" d={SKYLINE.line} />
</svg>
