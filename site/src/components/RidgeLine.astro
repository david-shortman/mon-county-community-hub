---
// The hub's one local motif: the line of wooded hills that rings Morgantown,
// drawn as a single thin stroke. Decorative only, hidden from screen readers.
// `filled` paints the area under the hills (used on the phone tab bar, so the
// hills read as the bar's top edge). Rules: docs/design/identity.md.
const { filled = false, class: cls = '' } = Astro.props;
const d = "M0 12l24-1l24 2l24 3l24 1l24-1l24-1l24 0l24 1l24-1l24-1l24 1l24 3l24 5l24 1l24 0l24 0l24 0l24 0l24-3l24-3l24-3l24 1l24 2l24 0l24-1l24-1l24 0l24 0l24-2l24-3l24-2l24 2l24 4l24 2l24 2l24 2l24 3l24 0l24 0l24-3l24-2l24 1l24 1l24 0l24-1l24 0l24 1l24 1l24-3l24-4l24-3l24-1l24 0l24 0l24 0l24 2l24 4l24 3l24 1l24-2l24-1l24 1l24 1l24 0l24-1l24 2l24 3l24 0l24 0l24-1l24-3l24-2l24-2l24-3l24-2l24 0l24 2l24 3l24 0l24 0l24-1l24 1l24 1l24-2l24-1l24 2l24 3l24 4l24 1l24 0l24 0l24 0l24 0l24-3l24-4l24-2l24 1l24 1l24 0l24-1l24 0l24 1l24-1l24-2l24-3l24-1l24 2l24 3l24 2l24 1l24 3l24 3l24 0l24 0l24-3l24-1l24 0l24 1l24-1l24-1l24 1l24 1l24 0l24-3l24-4";
---
<svg class={`ridge ${cls}`} aria-hidden="true" focusable="false" viewBox="0 0 3000 24" preserveAspectRatio="xMidYMax slice">
  {filled && <path class="ridge-fill" d={`${d} L3000 24 L0 24 Z`} />}
  <path class="ridge-line" d={d} />
</svg>
