---
// "Also called" (#529): other plain words people use for what a page covers,
// from content/also-called.yaml, shown at the end of the page so the site
// search finds it by those words too. It is a visible line for readers, never
// hidden text. A word belongs here only when the page really answers it.
import fs from 'node:fs';
import path from 'node:path';
import YAML from 'yaml';
import { CONTENT_DIR } from '../lib/content.mjs';
const { route } = Astro.props;
const file = path.join(CONTENT_DIR, 'also-called.yaml');
const map = fs.existsSync(file) ? YAML.parse(fs.readFileSync(file, 'utf8')) ?? {} : {};
const words = map[route] ?? [];
---
{words.length > 0 && (
  <p class="also-called meta" data-pagefind-weight="7"><strong>Also called:</strong>{' '}{words.join(', ')}.</p>
)}
