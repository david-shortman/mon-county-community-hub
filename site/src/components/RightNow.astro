---
// The pinned "help right now" box for the Front Door: 211 by call or text,
// 988 for a mental health crisis, 911 for danger. Facts come from
// content/resources/wv-211.yaml and content/resources/988-lifeline.yaml.
import Actions from './Actions.astro';
import { resource, prettyDate, ymd } from '../lib/content.mjs';
const r211 = resource('wv-211');
const r988 = resource('988-lifeline');
const checked = (r) => prettyDate(r.sources.map((s) => ymd(s.checked)).sort().at(-1));
---
<section class="right-now" aria-labelledby="right-now-h">
  <h2 id="right-now-h">Need help right now?</h2>
  <p>Call 211, or text your ZIP code to 898-211. Free, any hour. They point you to local help.</p>
  <div class="pair"><Actions callFirst phone="211" phoneLabel="West Virginia 211" sms="898-211" smsLabel="West Virginia 211, send your ZIP code" /></div>
  <p class="crisis">Mental health crisis: call or text <a href="tel:988">988</a>. In danger: call <a href="tel:911">911</a>.</p>
  <p class="meta">Sources: <a href={r211.sources[0].url}>West Virginia 211</a>, checked {checked(r211)}; <a href={r988.sources[0].url}>988 Lifeline</a>, checked {checked(r988)}.</p>
</section>
