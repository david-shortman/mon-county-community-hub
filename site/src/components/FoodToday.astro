---
// Results for "food today or this week". Only sourced records: 211, The Rack
// (WVU students), free meals from content/places, Scott's Run, food dates from
// the calendar (next 62 days; seniors-only dates left off the student view),
// and SNAP. Food dates and free meals added in the #516 review (Oct 31, 2026).
import ResourceCard from './ResourceCard.astro';
import EventCard from './EventCard.astro';
import Actions from './Actions.astro';
import SourceLine from './SourceLine.astro';
import { resource, org, loadCalendarWithFeeds, upcoming, loadDir } from '../lib/content.mjs';
const { student = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const forSeniorsOnly = (e) => /\bseniors?\b/i.test(e.title || '');
const pantries = upcoming(await loadCalendarWithFeeds(), undefined, 62).filter((e) => (e.topics || []).includes('food')).filter((e) => !(student && forSeniorsOnly(e))).slice(0, 6);
const MEALS = ['morgantown-community-kitchen-weekday-lunch', 'salvation-army-morgantown-family-dinner'];
const meals = loadDir('places').filter((p) => MEALS.includes(p.slug));
const srsh = org('scotts-run-settlement-house');
---
<h2>Where to start</h2>
<ol class="results">
  {student && <li><ResourceCard r={resource('the-rack-wvu-student-food-pantry')} lead="Start here: free for WVU students." /></li>}
  <li><ResourceCard r={resource('wv-211')} sms={resource('wv-211').contact.text} smsLabel="send your ZIP code" lead={student ? 'If The Rack is closed, or you need more:' : 'Start here: call or text, any hour.'} /></li>
  <li>
    <article class="card">
      <h3>{srsh.name}</h3>
      <p>{srsh.summary}</p>
      <Actions callFirst phone={srsh.phone} phoneLabel={srsh.name} sms={srsh.phone} smsLabel={srsh.name} link={srsh.website} linkLabel="Website" about={srsh.name} />
      <SourceLine sources={srsh.sources} org={srsh.slug} about={srsh.name} />
    </article>
  </li>
</ol>
{meals.length > 0 && <h2>Meals you can walk in for</h2>}
{meals.map((m) => (
  <article class="card">
    <h3>{m.name}</h3>
    <p><strong>When:</strong>{' '}{m.regular.join('; ')}</p>
    <p><strong>Where:</strong>{' '}{m.contact.place}</p>
    {m.cost && <p><strong>Cost:</strong>{' '}{m.cost}</p>}
    {(m.notes || []).map((n) => <p>{n}</p>)}
    <Actions callFirst phone={m.contact.phone} phoneLabel={m.name} link={m.contact.url} linkLabel="Website" about={m.name} />
    <SourceLine sources={m.sources} about={m.name} />
  </article>
))}
<h2>Free food dates coming up</h2>
{pantries.length ? pantries.map((e) => <EventCard e={e} />) : <p>No pantry dates are on our calendar for the next two months. Call or text 211 to ask what is open near you.</p>}
<h2>Help every month</h2>
<p>SNAP (food stamps) puts money for groceries on a card each month. Only the state decides who qualifies, so apply even if you are not sure. <a href={`${base}/help/food/monthly/`}>How to apply</a>.</p>
