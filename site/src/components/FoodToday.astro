---
// Results for "food today or this week". Only sourced records: 211, The Rack
// (WVU students), mobile pantry dates from the calendar, Scott's Run, and SNAP.
import ResourceCard from './ResourceCard.astro';
import EventCard from './EventCard.astro';
import Actions from './Actions.astro';
import SourceLine from './SourceLine.astro';
import { resource, org, loadCalendarWithFeeds, upcoming } from '../lib/content.mjs';
const { student = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pantries = upcoming(await loadCalendarWithFeeds(), undefined, 31).filter((e) => (e.topics || []).includes('food')).slice(0, 4);
const srsh = org('scotts-run-settlement-house');
---
<h2>Where to start</h2>
<ol class="results">
  {student && <li><ResourceCard r={resource('the-rack-wvu-student-food-pantry')} lead="Start here: free for WVU students." /></li>}
  <li><ResourceCard r={resource('wv-211')} sms={resource('wv-211').contact.text} smsLabel="send your ZIP code" lead={student ? 'If The Rack is closed, or you need more:' : 'Start here: call or text, any hour.'} /></li>
  <li>
    <article class="card">
      <h3>{srsh.name}</h3>
      <p>{srsh.summary}</p>
      <Actions callFirst phone={srsh.phone} phoneLabel={srsh.name} sms={srsh.phone} smsLabel={srsh.name} link={srsh.website} linkLabel="Website" about={srsh.name} />
      <SourceLine sources={srsh.sources} org={srsh.slug} about={srsh.name} />
    </article>
  </li>
</ol>
<h2>Free food dates coming up</h2>
{pantries.length ? pantries.map((e) => <EventCard e={e} />) : <p>No pantry dates are on our calendar for the next month. Call or text 211 to ask what is open near you.</p>}
<h2>Help every month</h2>
<p>SNAP (food stamps) puts money for groceries on a card each month. Only the state decides who qualifies, so apply even if you are not sure. <a href={`${base}/help/food/monthly/`}>How to apply</a>.</p>
