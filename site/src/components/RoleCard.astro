---
// One helper role card (#404): for each thing a person might say, two or three
// steps. A step is a page on this site, a resource record (its phone and
// source come from the record), or a plain line (like "call 911"). Built from
// site/src/lib/helper-roles.mjs. Prints on its own page.
import Actions from './Actions.astro';
import SourceLine from './SourceLine.astro';
import { resource, websiteLabel } from '../lib/content.mjs';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { r } = Astro.props;
const steps = (s) => s.steps.map((st) => ({ ...st, record: st.resource ? resource(st.resource) : null }));
---
<div class="role-card">
  {r.situations.map((s, i) => (
    <section class="role-sit" aria-labelledby={`${r.slug}-${i}`}>
      <h2 id={`${r.slug}-${i}`}>If someone tells you: "{s.hears}"</h2>
      <ol class="role-steps">
        {steps(s).map((st) => (
          <li>
            {st.page && <p>{st.text} <a href={`${base}${st.page}`}>Go to the page<span class="sr-only"> for: {s.hears}</span></a>. <span class="print-url">everythingmorgantown.org{st.page.split('?')[0]}</span></p>}
            {st.record && (
              <>
                <p><strong>{st.record.title}.</strong>{' '}{st.text}{(st.record.contact?.phone || st.record.contact?.text) && <span class="print-url"> {st.record.contact?.phone && `Call ${st.record.contact.phone}`}{st.record.contact?.phone && st.record.contact?.text && ', or text '}{!st.record.contact?.phone && st.record.contact?.text && 'Text '}{st.record.contact?.text}.</span>}</p>
                <Actions callFirst phone={st.record.contact?.phone} phoneLabel={st.record.title} sms={st.record.contact?.text} link={st.record.contact?.url} linkLabel={websiteLabel(st.record)} about={st.record.title} />
                <SourceLine sources={st.record.sources} org={st.record.org} about={st.record.title} />
              </>
            )}
            {!st.page && !st.record && <p><strong>{st.text}</strong></p>}
          </li>
        ))}
      </ol>
    </section>
  ))}
</div>

<style>
  .role-sit { border-top: 2px solid var(--line); margin-top: 18px; }
  .role-sit h2 { font-size: 1.2rem; }
  .role-steps { padding-left: 1.4rem; display: grid; gap: 10px; }
  .role-steps p { margin: 4px 0; }
  .print-url { display: none; }
  @media print {
    @page { margin: 0.5in; }
    .role-card { font-size: 10pt; line-height: 1.3; }
    .print-url { display: inline; font-weight: 700; }
    .role-sit { margin-top: 8px; }
    .role-sit h2 { font-size: 11.5pt; margin: 6px 0 2px; }
    .role-steps { gap: 3px; margin: 2px 0; }
    .role-steps li { break-inside: avoid; }
    .role-steps :global(.actions) { display: none; }
    .role-steps :global(.meta) { font-size: 8pt; margin: 0 0 2px; }
  }
</style>
