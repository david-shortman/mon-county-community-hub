---
// The facts block on an answer page, read from one content/resources entry,
// so the page shows only what the entry says, with its sources and dates.
import Actions from './Actions.astro';
import SourceLine from './SourceLine.astro';
import { resource, org as orgOf } from '../lib/content.mjs';

const { slug, linkLabel = 'Go to the official site' } = Astro.props;
// Throws when the slug is missing; a hidden record comes back with no facts (#519).
const r = resource(slug);
const org = r.org ? orgOf(r.org) : null;
---
{r.hidden ? (
<section class="card" aria-labelledby={`${slug}-h`}>
  <h2 id={`${slug}-h`}>{r.title}</h2>
  <SourceLine sources={[]} about={r.title} slug={r.slug} />
</section>
) : (
<section class="card" aria-labelledby={`${slug}-h`}>
  <h2 id={`${slug}-h`}>{r.title}</h2>
  <Actions link={r.contact?.url} linkLabel={linkLabel} phone={r.contact?.phone} phoneLabel={org?.name} about={r.title} />
  <p><strong>Who can get it:</strong>{' '}{r.who_it_is_for}</p>
  <p><strong>What to do:</strong>{' '}{r.what_to_do}</p>
  {r.options?.length > 0 && <ul class="card-steps">{r.options.map((t) => <li>{t}</li>)}</ul>}
  {r.notes?.map((t) => <p>{t}</p>)}
  <p><strong>Cost:</strong>{' '}{r.cost === 'free' ? 'Free.' : r.cost}</p>
  <SourceLine sources={r.sources} phone={r.phone_confirmed} org={r.org} about={r.title} slug={r.slug}>{org && <Fragment slot="before">Run by {org.name}. </Fragment>}</SourceLine>
</section>
)}
