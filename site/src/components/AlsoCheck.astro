---
// "Also check" (#224): 2 to 4 links at the end of a topic page to pages that
// often go with it, from content/also-check.yaml. Link text is each page's own
// label and summary, so nothing here can go stale on its own. A link shows
// only once its page exists; the block shows only with at least one link.
import fs from 'node:fs';
import path from 'node:path';
import YAML from 'yaml';
import { CONTENT_DIR } from '../lib/content.mjs';
import { loadPages } from '../lib/pages.mjs';
const { route } = Astro.props;
const file = path.join(CONTENT_DIR, 'also-check.yaml');
const map = fs.existsSync(file) ? YAML.parse(fs.readFileSync(file, 'utf8')) ?? {} : {};
const pages = await loadPages();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = (map[route] ?? []).map((href) => pages.get(href)).filter((p) => p && p.route !== route);
---
{links.length > 0 && (
  <nav class="also-check" aria-labelledby="also-check-h">
    <h2 id="also-check-h">Also check</h2>
    <ul class="topic-list">
      {links.map((p) => <li><a href={`${base}${p.route}`}>{p.label}</a>{p.summary && <span class="hint">{p.summary}</span>}</li>)}
    </ul>
  </nav>
)}
