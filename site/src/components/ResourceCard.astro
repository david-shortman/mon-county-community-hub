---
// One sourced resource from content/resources, phone first: what it is, who it
// is for, what to do, then big buttons. Source and checked date in small print.
import Actions from './Actions.astro';
import { prettyDate, ymd, shortUrl } from '../lib/content.mjs';
const { r, sms, smsLabel, lead, showCost = false } = Astro.props;
const checked = r.sources.map((s) => ymd(s.checked)).sort().at(-1);
const host = r.contact?.url ? new URL(r.contact.url).hostname.replace(/^www\./, '') : null;
---
<article class="card resource" id={r.slug}>
  <h3>{r.title}</h3>
  {lead && <p><strong>{lead}</strong></p>}
  <p>{r.who_it_is_for} {r.what_to_do}</p>
  {showCost && r.cost && r.cost !== 'free' && <p><strong>Cost:</strong> {r.cost}</p>}
  <Actions callFirst
    phone={r.contact?.phone} phoneLabel={r.title}
    sms={sms} smsLabel={smsLabel}
    link={r.contact?.url} linkLabel={host && `Open ${host}`}
    about={r.title}
  />
  <p class="meta">Source: {r.sources.map((s, i) => (<>{i > 0 && ', '}<a href={s.url}>{shortUrl(s.url)}</a></>))}. Checked by hand on {prettyDate(checked)}.{r.cost === 'free' && ' Free.'}</p>
</article>
