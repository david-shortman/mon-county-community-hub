---
// One sourced resource from content/resources, phone first: what it is, who it
// is for, what to do, then big buttons. Source and checked date in small print,
// naming who published the source (#327).
import WhatHappensNext from './WhatHappensNext.astro';
import BusLink from './BusLink.astro';
import Actions from './Actions.astro';
import SourceLine from './SourceLine.astro';
import PassItOn from './PassItOn.astro';
import RelayLine from './RelayLine.astro';
import { websiteLabel, oldestChecked, staleDaysFor } from '../lib/content.mjs';
// headingLevel: 3 by default; use 2 when cards sit right under the page's h1.
// checkFirst: false hides the "check with them first" line (#942), for example on lines that are always open.
const { r, sms, smsLabel, lead, showCost = false, headingLevel = 3, checkFirst = true } = Astro.props;
// Crisis and emergency lines are always open, so no reminder to check first.
const ALWAYS_OPEN = ['988-lifeline', 'veterans-crisis-line', 'wv-211', 'rdvic-hotline', 'va-homeless-veterans-line'];
const remind = checkFirst && !ALWAYS_OPEN.includes(r.slug);
const H = `h${headingLevel}`;
---
{r.hidden ? (
<article class="card resource" id={r.slug}>
  <H>{r.title}</H>
  <SourceLine sources={[]} about={r.title} slug={r.slug} />
</article>
) : (
<article class="card resource" id={r.slug}>
  <H>{r.title}</H>
  {lead && <p><strong>{lead}</strong></p>}
  <p>{r.who_it_is_for}{' '}{r.what_to_do}</p>
  {r.steps?.length > 0 && <ol class="card-steps">{r.steps.map((t) => <li>{t}</li>)}</ol>}
  {r.options?.length > 0 && <ul class="card-steps">{r.options.map((t) => <li>{t}</li>)}</ul>}
  {r.notes?.map((t) => <p>{t}</p>)}
  {showCost && r.cost && r.cost !== 'free' && <p><strong>Cost:</strong> {r.cost}</p>}
  <Actions callFirst
    phone={r.contact?.phone} phoneLabel={r.title}
    sms={sms} smsLabel={smsLabel}
    link={r.contact?.url} linkLabel={websiteLabel(r)}
    about={r.title}
  />
  <RelayLine phone={r.contact?.phone} sms={sms} text={r.contact?.text} />
  <BusLink place={r.contact?.place} about={r.title} />
  <WhatHappensNext r={r} />
  <SourceLine sources={r.sources} phone={r.phone_confirmed} staleDays={staleDaysFor(r)} remind={remind} org={r.org} about={r.title} slug={r.slug}>{r.cost === 'free' && ' Free.'}</SourceLine>
  <PassItOn title={r.title} slug={r.slug} org={r.org} privateTrace={r.private_trace} phone={r.contact?.phone} place={r.contact?.place} hours={r.hours} checked={oldestChecked(r.sources)} />
</article>
)}
