---
// A row of big, thumb-sized action buttons. Each one shows only when we have
// what it needs: a link, a phone number, or a place the source published.
// Share is a button that the page script turns on (Web Share API, or copy link).
import Icon from './Icon.astro';
import { mapsUrl, telHref } from '../lib/content.mjs';
// `about` names the thing the buttons act on, for screen readers, so two
// "Add to calendar" buttons on one page never sound the same.
// `sms` adds a Text button (for example 211's text line, 898-211).
// `callFirst` makes Call the big filled button and the link a plain one (for
// help lines, where calling matters more than the website).
const { callFirst = false, link, linkLabel, phone, phoneLabel, sms, smsLabel, place, ics, shareUrl, shareTitle, about } = Astro.props;
const ctx = about ? `: ${about}` : '';
---
<div class="actions">
  {callFirst && phone && <a class="btn btn-primary" href={telHref(phone)}><Icon name="phone" /><span>Call <span class="nowrap" translate="no">{phone}</span>{phoneLabel && <span class="sr-only">, {phoneLabel}</span>}</span></a>}
  {link && <a class:list={['btn', !callFirst && 'btn-primary']} href={link}><Icon name="open" /><span>{linkLabel}<span class="sr-only">{ctx}</span></span></a>}
  {!callFirst && phone && <a class="btn btn-wide" href={telHref(phone)}><Icon name="phone" /><span>Call <span class="nowrap" translate="no">{phone}</span>{phoneLabel && <span class="sr-only">, {phoneLabel}</span>}</span></a>}
  {sms && <a class="btn" href={`sms:${String(sms).replace(/[^\d+]/g, '')}`}><Icon name="text" /><span>Text <span class="nowrap" translate="no">{sms}</span>{smsLabel && <span class="sr-only">, {smsLabel}</span>}</span></a>}
  {place && <a class="btn" href={mapsUrl(place)}><Icon name="pin" /><span>Directions<span class="sr-only"> to {place} (opens a map)</span></span></a>}
  {ics && <a class="btn" href={ics}><Icon name="calendar-add" /><span>Add to calendar<span class="sr-only">{ctx}</span></span></a>}
  {shareUrl && <button class="btn share" type="button" hidden data-url={shareUrl} data-title={shareTitle}><Icon name="share" /><span><span class="label">Share</span><span class="sr-only">{ctx}</span></span></button>}
</div>
