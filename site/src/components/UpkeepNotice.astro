---
// Site-wide notice when upkeep has stopped (#497). Shown at build time when the
// newest re-check is older than UPKEEP_NOTICE_DAYS, and turned on in the
// browser too, so it still appears if the daily rebuild has stopped.
import { lastUpkeep, upkeepLapsed, UPKEEP_NOTICE_DAYS } from '../lib/upkeep.mjs';
import { prettyDate } from '../lib/content.mjs';
const last = lastUpkeep();
const on = upkeepLapsed();
---
{UPKEEP_NOTICE_DAYS > 0 && last && (
  <>
    {/* While the notice is off, its words wait in a <template>, so search
        engines and AI tools that read the raw page do not quote a warning
        that is not true (found by the visibility run on 2026-11-04). */}
    <section class="note upkeep" role="note" data-pagefind-ignore aria-label={on ? 'This site is not being kept up' : undefined} data-upkeep-last={last} data-upkeep-days={UPKEEP_NOTICE_DAYS} hidden={!on}>
      {on ? (
        <p><strong>This site is not being kept up right now.</strong> Nobody has re-checked a listing since {prettyDate(last)}, so phone numbers, hours and dates may be out of date. Check with the group directly before you go, or call <a href="tel:211">211</a> for help.</p>
      ) : (
        <template data-upkeep-text><p><strong>This site is not being kept up right now.</strong> Nobody has re-checked a listing since {prettyDate(last)}, so phone numbers, hours and dates may be out of date. Check with the group directly before you go, or call <a href="tel:211">211</a> for help.</p></template>
      )}
    </section>
    <script is:inline>
      (function () {
        var el = document.querySelector('[data-upkeep-last]');
        if (!el) return;
        var days = (Date.now() - Date.parse(el.dataset.upkeepLast + 'T12:00:00Z')) / 86400000;
        if (days > Number(el.dataset.upkeepDays)) {
          var t = el.querySelector('template[data-upkeep-text]');
          if (t) el.replaceChildren(t.content.cloneNode(true));
          el.setAttribute('aria-label', 'This site is not being kept up');
          el.hidden = false;
        }
      })();
    </script>
  </>
)}
