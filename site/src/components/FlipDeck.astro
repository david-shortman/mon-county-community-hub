---
// Flip through (#2028, part of the Topics explorer, #2025): an opt-in deck of
// topic cards in a <dialog>, opened only by a "Flip through" button on
// /topics/. It shows the "Picked for you" pages, or the starter list from
// content/explore-chips.yaml when nothing is picked.
//
// Each card: the page's door, label and summary, with Skip, Open page and
// Save. Above it: Close, "3 of 12", Back (undo the last Save or Skip) and a
// progress bar. Saved pages go to My list (localStorage em-explore-saved,
// #2029). Pages Pass it on hides (isQuietPage) get no Save button.
//
// Shortcuts, never the only way: swipe or drag the card right to Save, left
// to Skip; keys Right arrow Save, Left arrow Skip, Enter opens the page,
// Backspace goes back, Escape closes. The dialog never opens by itself and
// never takes over the page scroll. The fly-off and the card peeking behind
// move only when motionAllowed() is true (docs/design/motion.md); with motion
// off, the next card just appears. With no script there is no deck and no
// button: "Picked for you" and /topics/pick/ pages do the same job.
---
<dialog class="flip-deck" id="flip-deck" aria-labelledby="fd-title" aria-describedby="fd-keys">
  <div class="fd-top">
    <button type="button" class="fd-btn" data-fd="close">Close</button>
    <p class="fd-count" id="fd-count">1 of 1</p>
    <button type="button" class="fd-btn" data-fd="back">Back</button>
  </div>
  <div class="fd-progress" aria-hidden="true"><span id="fd-bar"></span></div>

  <div class="fd-stage" id="fd-stage">
    <div class="fd-peek" aria-hidden="true"></div>
    <article class="fd-card" id="fd-card">
      <p class="fd-door" id="fd-door"></p>
      <h2 id="fd-title" tabindex="-1"></h2>
      <p class="fd-summary" id="fd-summary"></p>
      <span class="fd-stamp" id="fd-stamp" aria-hidden="true"></span>
    </article>
    <div class="fd-actions" id="fd-actions">
      <button type="button" class="fd-btn" data-fd="skip">Skip</button>
      <a class="fd-btn fd-open" id="fd-open" href="#">Open page</a>
      <button type="button" class="fd-btn fd-save" data-fd="save">Save</button>
    </div>
    <p class="fd-keys" id="fd-keys">Swipe right or press the right arrow to save. Swipe left or press the left arrow to skip.</p>
  </div>

  <div class="fd-end" id="fd-end" hidden>
    <h2 id="fd-end-h" tabindex="-1"></h2>
    <div class="fd-actions">
      <button type="button" class="fd-btn" data-fd="again">Start over</button>
      <button type="button" class="fd-btn" data-fd="close">Close</button>
    </div>
  </div>
  <p class="sr-only" id="fd-live" aria-live="polite"></p>
</dialog>

<style>
  .flip-deck { box-sizing: border-box; width: 100%; max-width: 480px; height: 100%; max-height: 100dvh; margin: auto; padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); border: 0; background: var(--bg); color: var(--fg); overflow: auto; overscroll-behavior: contain; }
  .flip-deck::backdrop { background: rgba(0, 0, 0, 0.6); }
  .fd-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .fd-count { margin: 0; font-weight: 700; }
  .fd-progress { height: 4px; margin: 8px 0 16px; background: var(--line); border-radius: 2px; overflow: hidden; }
  .fd-progress span { display: block; height: 100%; width: 0; background: var(--accent); }
  .fd-stage { position: relative; }
  .fd-card, .fd-peek { box-sizing: border-box; min-height: 220px; padding: 20px; border: 2px solid var(--accent); border-radius: 12px; background: var(--card); }
  .fd-card { position: relative; z-index: 1; touch-action: pan-y; user-select: none; }
  .fd-peek { position: absolute; inset: 10px -6px auto 6px; z-index: 0; border-style: dashed; opacity: 0.6; }
  .fd-door { margin: 0 0 6px; font-size: 0.9rem; color: var(--muted); }
  .fd-card h2 { margin: 0 0 10px; font-size: 1.5rem; }
  .fd-card h2:focus { outline: none; }
  .fd-card h2:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
  .fd-stamp { position: absolute; top: 12px; right: 12px; padding: 2px 10px; border: 3px solid currentColor; border-radius: 6px; font-weight: 800; text-transform: uppercase; opacity: 0; }
  .fd-stamp[data-show] { opacity: 1; }
  .fd-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .fd-actions .fd-btn { flex: 1 1 auto; justify-content: center; }
  .fd-btn { display: inline-flex; align-items: center; min-height: 44px; padding: 6px 16px; border: 2px solid var(--accent); border-radius: 22px; background: var(--card); color: var(--fg); font: inherit; font-weight: 700; text-decoration: none; cursor: pointer; }
  .fd-btn:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .fd-btn:disabled { opacity: 0.5; cursor: default; }
  .fd-save { background: var(--accent); color: var(--bg); }
  .fd-keys { margin: 12px 0 0; font-size: 0.9rem; color: var(--muted); }
  /* Motion only when allowed: the device setting and the site's switch (html[data-motion-off]). */
  @media (prefers-reduced-motion: no-preference) {
    :root:not([data-motion-off]) .fd-card[data-fly] { transition: transform 180ms ease-in, opacity 180ms ease-in; opacity: 0; }
    :root:not([data-motion-off]) .fd-card[data-fly="save"] { transform: translateX(120%) rotate(8deg); }
    :root:not([data-motion-off]) .fd-card[data-fly="skip"] { transform: translateX(-120%) rotate(-8deg); }
    :root:not([data-motion-off]) .fd-card[data-snap] { transition: transform 160ms ease-out; }
  }
  :root[data-motion-off] .fd-peek { display: none; }
  @media (prefers-reduced-motion: reduce) { .fd-peek { display: none; } }
</style>

<script>
  import { newDeck, deckAct, deckSavedCount, isQuietPage } from '../lib/explore-rank.mjs';
  import { motionAllowed } from '../lib/motion-client.mjs';
  const SAVED = 'em-explore-saved';
  const dlg = document.getElementById('flip-deck') as HTMLDialogElement | null;
  const dataEl = document.getElementById('explore-data');
  if (dlg && dataEl && typeof dlg.showModal === 'function') {
    const data = JSON.parse(dataEl.textContent || '{}');
    const $ = (id: string) => dlg.querySelector('#' + id) as HTMLElement;
    const card = $('fd-card'), stamp = $('fd-stamp'), open = $('fd-open') as HTMLAnchorElement;
    const saveBtn = dlg.querySelector('[data-fd="save"]') as HTMLButtonElement;
    const backBtn = dlg.querySelector('[data-fd="back"]') as HTMLButtonElement;
    // The chips script may have run first; it keeps its last picks here too.
    let picks: string[] = (window as any).__emPicks?.pages ?? [];
    let state = newDeck([]);
    let opener: HTMLElement | null = null;
    let busy = false;

    const readSaved = (): string[] => {
      try { const v = JSON.parse(localStorage.getItem(SAVED) ?? '[]'); return Array.isArray(v) ? v.filter((r) => typeof r === 'string' && data.pages[r] && !isQuietPage(r, data.pages[r])) : []; } catch (e) { return []; }
    };
    const writeSaved = (list: string[]) => {
      try { list.length ? localStorage.setItem(SAVED, JSON.stringify(list)) : localStorage.removeItem(SAVED); } catch (e) {}
      document.dispatchEvent(new CustomEvent('explore:saved', { detail: { saved: [...list] } }));
    };

    // Which pages the deck shows: the current picks, or the starter list.
    document.addEventListener('explore:picks', (e) => { picks = (e as CustomEvent).detail.pages; label(); });
    function deckRoutes() { return (picks.length ? picks : data.starter).filter((r: string) => data.pages[r]); }
    function label() {
      const n = deckRoutes().length;
      document.querySelectorAll<HTMLElement>('[data-flip]').forEach((b) => {
        b.hidden = false;
        const full = picks.length ? `Flip through ${n} pages picked for you` : `Flip through ${n} pages to start`;
        // The bar's button is short, so the bar stays one row on a phone; its name still says it all.
        if (b.dataset.flip === 'short') { b.textContent = `Flip through ${n}`; b.setAttribute('aria-label', full); }
        else b.textContent = full;
      });
    }

    function show(announce = true) {
      const total = state.routes.length;
      const done = state.i >= total;
      $('fd-stage').hidden = done;
      $('fd-end').hidden = !done;
      ($('fd-bar') as HTMLElement).style.width = `${total ? Math.round((state.i / total) * 100) : 0}%`;
      backBtn.disabled = state.log.length === 0;
      card.removeAttribute('data-fly');
      card.style.transform = '';
      stamp.removeAttribute('data-show');
      if (done) {
        $('fd-count').textContent = `${total} of ${total}`;
        $('fd-end-h').textContent = `You saved ${deckSavedCount(state)} of ${total}`;
        $('fd-end-h').focus();
        $('fd-live').textContent = `Done. You saved ${deckSavedCount(state)} of ${total}.`;
        return;
      }
      const route = state.routes[state.i];
      const p = data.pages[route];
      $('fd-count').textContent = `${state.i + 1} of ${total}`;
      $('fd-door').textContent = p.door ?? '';
      $('fd-title').textContent = p.label;
      $('fd-summary').textContent = p.summary ?? '';
      open.href = `${data.base}${route}`;
      const quiet = isQuietPage(route, p);
      saveBtn.hidden = quiet;
      saveBtn.textContent = readSaved().includes(route) ? 'Saved, next' : 'Save';
      ($('fd-keys') as HTMLElement).textContent = quiet
        ? 'Swipe left or press the left arrow to skip.'
        : 'Swipe right or press the right arrow to save. Swipe left or press the left arrow to skip.';
      if (announce) $('fd-live').textContent = `Card ${state.i + 1} of ${total}: ${p.label}`;
    }

    function act(a: 'save' | 'skip' | 'back') {
      if (busy) return;
      if (a === 'save' && state.i < state.routes.length) {
        const route = state.routes[state.i];
        if (isQuietPage(route, data.pages[route])) return;
      }
      const next = deckAct(state, readSaved(), a);
      if (next.state === state) return;
      const go = () => { state = next.state; writeSaved(next.saved); busy = false; show(); };
      if (a !== 'back' && motionAllowed()) {
        busy = true;
        card.style.transform = '';
        card.setAttribute('data-fly', a);
        setTimeout(go, 190);
      } else go();
    }

    function start(from: HTMLElement | null) {
      opener = from;
      state = newDeck(deckRoutes());
      dlg!.showModal();
      show();
      $('fd-title').focus();
    }

    document.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest?.('[data-flip]') as HTMLElement | null;
      if (b) start(b);
    });
    dlg.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest?.('[data-fd]') as HTMLElement | null;
      if (!t) return;
      const what = t.dataset.fd;
      if (what === 'close') dlg.close();
      else if (what === 'again') { state = newDeck(deckRoutes()); show(); $('fd-title').focus(); }
      else act(what as 'save' | 'skip' | 'back');
    });
    dlg.addEventListener('close', () => { opener?.focus(); });

    dlg.addEventListener('keydown', (e) => {
      if (e.altKey || e.ctrlKey || e.metaKey) return;
      const onButton = (e.target as HTMLElement).closest?.('button, a');
      if (e.key === 'ArrowRight') { e.preventDefault(); act('save'); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); act('skip'); }
      else if (e.key === 'Backspace') { e.preventDefault(); act('back'); }
      else if (e.key === 'Enter' && !onButton && state.i < state.routes.length) { e.preventDefault(); open.click(); }
    });

    // Swipe or drag: a shortcut for Save and Skip. A short drag springs back.
    let x0 = 0, y0 = 0, dx = 0, dragging = false;
    card.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 || busy) return;
      x0 = e.clientX; y0 = e.clientY; dx = 0; dragging = true;
      card.setPointerCapture(e.pointerId);
      card.removeAttribute('data-snap');
    });
    card.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      dx = e.clientX - x0;
      if (Math.abs(e.clientY - y0) > Math.abs(dx) && Math.abs(dx) < 10) return;
      const quiet = isQuietPage(state.routes[state.i], data.pages[state.routes[state.i]]);
      const dir = dx > 0 && !quiet ? 'Save' : dx < 0 ? 'Skip' : '';
      stamp.textContent = dir;
      stamp.toggleAttribute('data-show', Math.abs(dx) > 30 && Boolean(dir));
      if (motionAllowed()) card.style.transform = `translateX(${dx}px) rotate(${dx / 30}deg)`;
    });
    const end = () => {
      if (!dragging) return;
      dragging = false;
      stamp.removeAttribute('data-show');
      if (dx > 80) act('save');
      else if (dx < -80) act('skip');
      else { card.setAttribute('data-snap', ''); card.style.transform = ''; }
    };
    card.addEventListener('pointerup', end);
    card.addEventListener('pointercancel', () => { dx = 0; end(); });

    label();
  }
</script>
