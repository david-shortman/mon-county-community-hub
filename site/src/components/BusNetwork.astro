---
// How the routes fit together (#1445, redone in #1656): where the Mountain Line
// routes meet, on /bus-routes/. Built from
// content/pdf-pages/mountain-line-routes.yaml by src/lib/bus-network.mjs, and
// every count in the words is worked out from that file.
// The first version was a network drawing with a scroll story. With 20 routes
// its lines crossed everywhere on a phone, so this is a plain table instead:
// one row per route, one column per busy stop, a dot where the route stops.
// It reads the same with no script, no motion and a screen reader. Never
// promises a connection: a shared stop does not mean buses wait.
import { pdfPage } from '../lib/pdf-pages.mjs';
import { routesFrom, grid, sharedStops, rideText } from '../lib/bus-network.mjs';
const rec = pdfPage('mountain-line-routes');
const routes = routesFrom(rec);
const { cols, groups } = grid(routes);
const shared = sharedStops(routes);
const SHORT = { 'Pifer Terminal': 'Pifer', "Colasante's Shelter": "Colasante's", 'Public Safety Building': 'Public Safety' };
const label = (s) => SHORT[s] ?? s;
const short = (n) => n.replace(/^Route \d+ /, '');
const rowName = (n) => n.replace(/^Route /, '');
const list = (xs) => (xs.length > 1 ? `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}` : xs[0] ?? '');
const plural = (n, one, many) => `${n} ${n === 1 ? one : many}`;
const title = (g) => (g.hub ? `Through ${g.hub}${g.not.length ? `, not ${list(g.not.map(label))}` : ''}` : 'Other routes');
// Takeaways: the first two groups and what is left.
const [g1, g2] = groups;
const also1 = g1 && cols[1] ? g1.rows.filter((row) => row.on[1]).length : 0;
const rest = groups.filter((g) => g !== g1 && g !== g2).flatMap((g) => g.rows);
const take = [
  g1 && `${g1.rows.length} of the ${routes.length} routes stop at ${g1.hub}${g1.hub === 'Pifer Terminal' ? ' in Westover' : ''}. ${also1 ? `${also1} of them also stop at ${cols[1]}.` : ''}`,
  g2 && `${shared.find(([s]) => s === g2.hub)?.[1].length ?? 0} routes stop at ${g2.hub}. For ${plural(g2.rows.length, 'route', 'routes')} that never reach ${list(g2.not.map(label))}, ${g2.hub} is the main place to meet the rest.`,
  rest.length && `The other ${plural(rest.length, 'route', 'routes')} share only a few stops with the rest. Those stops are listed under each one.`,
].filter(Boolean);
---
<section class="net-x" id="net-explainer" aria-labelledby="net-h">
  <h2 id="net-h">How the routes fit together</h2>
  <p>Most routes meet at a few busy stops, where you could get off one bus and onto another. Find your route to see where it meets the others.</p>
  <ul class="net-take">{take.map((t) => <li>{t}</li>)}</ul>
  <div class="net-wrap" role="region" aria-labelledby="net-cap" tabindex="0">
    <table class="net-grid">
      <caption id="net-cap">Which routes stop at the {cols.length} busiest stops</caption>
      <thead>
        <tr><th scope="col" class="net-rh">Route</th>{cols.map((c) => <th scope="col" class="net-ch"><span>{label(c)}</span></th>)}</tr>
      </thead>
      {groups.map((g) => (
        <tbody>
          <tr class="net-g"><th scope="colgroup" colspan={cols.length + 1}>{title(g)} <span class="net-n">({plural(g.rows.length, 'route', 'routes')})</span></th></tr>
          {g.rows.map((row) => (
            <tr>
              <th scope="row">{rowName(row.r.name)}{!g.hub && <span class="net-also">{row.also.length ? `Also meets others at ${list(row.also)}` : 'Shares no stops with other routes'}</span>}</th>
              {row.on.map((on, i) => (
                <td class={cols[i] === g.hub ? 'net-hub' : undefined}>{on ? <><span class="net-dot" aria-hidden="true"></span><span class="sr-only">Stops here</span></> : <span class="sr-only">No</span>}</td>
              ))}
            </tr>
          ))}
        </tbody>
      ))}
    </table>
  </div>
  <p class="net-key">A dot means the route stops there. Busiest stops are those on {cols.length ? shared.find(([s]) => s === cols[cols.length - 1])?.[1].length : 0} or more routes. RideMon vans have no fixed route, so they are not listed. A shared stop is a place you could change buses, but buses do not wait for each other.</p>
  <details class="net-all">
    <summary>All {shared.length} stops on more than one route</summary>
    <table class="net-table">
      <thead><tr><th scope="col">Stop</th><th scope="col">Routes</th></tr></thead>
      <tbody>{shared.map(([s, rs]) => <tr><th scope="row">{s}</th><td>{rs.length}: {rs.map(short).join(', ')}</td></tr>)}</tbody>
    </table>
  </details>
  <details class="net-all">
    <summary>Every route: its stops and where it meets other routes</summary>
    <ul>{routes.map((r) => <li>{rideText(routes, r)}</li>)}</ul>
  </details>
  <p class="meta">From each route's "Stops along the way" on busride.org, read {rec.sources?.[0]?.checked ?? ''}. Those lists name the main stops, not every stop. A few stop names are spelled more than one way there; we joined only clear spelling differences (like "Public Safety Bldg." and "Public Safety Building").</p>
</section>

<style is:global>
  /* ===== How the routes fit together (#1445, #1656). Press tokens only; scoped to #net-explainer. ===== */
  #net-explainer .net-take { margin: 0 0 var(--s5); }
  #net-explainer .net-take li { margin-bottom: var(--s2); }
  #net-explainer .net-wrap { overflow-x: auto; margin: 0 0 var(--s3); background: var(--card); border: 1px solid var(--line); border-top: 2px solid var(--fg); border-radius: 2px; }
  #net-explainer .net-wrap:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  #net-explainer .net-grid { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  #net-explainer .net-grid caption { text-align: left; font-weight: 700; padding: var(--s3) var(--s3) var(--s2); }
  #net-explainer .net-grid :is(th, td) { padding: var(--s1) var(--s1); border-top: 1px solid var(--line); }
  #net-explainer .net-grid thead th { border-top: 0; vertical-align: bottom; font-size: 0.85rem; color: var(--muted); }
  #net-explainer .net-grid .net-rh { text-align: left; padding-left: var(--s3); }
  /* Stop names stand on end so six columns fit a phone. */
  #net-explainer .net-grid .net-ch { width: 2.25rem; padding-bottom: var(--s2); }
  #net-explainer .net-grid .net-ch span { writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; display: inline-block; font-weight: 700; color: var(--fg); }
  #net-explainer .net-grid tbody th[scope="row"] { text-align: left; font-weight: 600; padding-left: var(--s3); line-height: 1.3; }
  #net-explainer .net-grid td { text-align: center; vertical-align: middle; height: 2.25rem; }
  #net-explainer .net-grid .net-g th { text-align: left; padding: var(--s3) var(--s3) var(--s1); border-top: 2px solid var(--fg); font-family: var(--kicker); font-weight: 800; font-size: 0.9rem; }
  #net-explainer .net-grid .net-n { font-weight: 400; color: var(--muted); }
  #net-explainer .net-grid td.net-hub { background: var(--accent-bg); }
  #net-explainer .net-dot { display: inline-block; width: 0.9rem; height: 0.9rem; border-radius: 50%; background: var(--accent); vertical-align: middle; forced-color-adjust: none; }
  @media (forced-colors: active) { #net-explainer .net-dot { background: CanvasText; } }
  #net-explainer .net-also { display: block; font-weight: 400; font-size: 0.85rem; color: var(--muted); }
  #net-explainer .net-key { font-size: 0.95rem; color: var(--muted); }
  #net-explainer .net-table { width: 100%; table-layout: fixed; border-collapse: collapse; font-size: 1rem; overflow-wrap: anywhere; }
  #net-explainer .net-table thead th:first-child { width: 40%; }
  #net-explainer .net-table :is(th, td) { text-align: left; vertical-align: top; padding: var(--s2) var(--s2) var(--s2) 0; border-top: 1px solid var(--line); }
  #net-explainer .net-all { margin: var(--s4) 0; }
  #net-explainer .net-all summary { min-height: 44px; display: flex; align-items: center; cursor: pointer; color: var(--accent); font-weight: 700; }
</style>
