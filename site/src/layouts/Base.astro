---
import RidgeLine from '../components/RidgeLine.astro';
const { title, description = 'Plain-language help for life in Morgantown and Monongalia County, WV.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = new URL(`${base}/share.png`, Astro.site).href;
const fullTitle = title ? `${title} | Mon County Community Hub` : 'Mon County Community Hub';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mon County Community Hub" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content="Mon County Community Hub" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <style is:global>
      /* Local identity tokens. Source of truth and contrast ratios: docs/design/identity.md */
      :root {
        --bg: #f9f7f2; --fg: #1d1d1b; --muted: #5b5a55; --line: #ddd6ca;
        --accent: #1f5c4a; --accent-bg: #e6f0ec; --card: #ffffff;
        --brick: #9b4a34; --ridge: #a9bcb1;
        color-scheme: light dark;
      }
      @media (prefers-color-scheme: dark) {
        :root { --bg: #161714; --fg: #ecebe6; --muted: #a9a79f; --line: #363830; --accent: #8fd1b5; --accent-bg: #1f2c26; --card: #1d1f1b; --brick: #d98c72; --ridge: #3f5449; }
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--fg); font: 18px/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
      a { color: var(--accent); text-underline-offset: 3px; }
      a:focus-visible, button:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
      .wrap { max-width: 46rem; margin: 0 auto; padding: 0 16px; }
      header.site { border-bottom: 1px solid var(--line); }
      header.site .ridge { display: block; width: 100%; height: 16px; margin-top: -6px; }
      header.site .ridge path { fill: none; stroke: var(--ridge); stroke-width: 1.5; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
      header.site .wrap { display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: baseline; padding-block: 14px; }
      header.site .brand { font-weight: 700; color: var(--fg); text-decoration: none; margin-right: auto; }
      header.site nav { display: flex; gap: 16px; }
      main { padding-block: 24px 48px; }
      h1 { font-size: 1.9rem; line-height: 1.2; margin: 0.4em 0; }
      h2 { font-size: 1.35rem; margin-top: 2em; }
      .lede { font-size: 1.15rem; color: var(--muted); }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 16px 18px; margin: 14px 0; }
      .card h3 { margin: 0 0 4px; font-size: 1.1rem; }
      .when { font-weight: 600; color: var(--accent); }
      .meta { font-size: 0.85rem; color: var(--muted); }
      .tag { display: inline-block; font-size: 0.8rem; background: var(--accent-bg); color: var(--accent); border-radius: 999px; padding: 1px 10px; margin-right: 4px; }
      .note { background: var(--accent-bg); border-left: 4px solid var(--brick); border-radius: 4px 10px 10px 4px; padding: 12px 16px; }
      footer.site { border-top: 2px solid var(--brick); font-size: 0.9rem; color: var(--muted); padding-block: 20px 40px; }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={`${base}/`}>Mon County Community Hub</a>
        <nav aria-label="Main">
          <a href={`${base}/calendar/`}>Deadlines</a>
          <a href={`${base}/stay-tonight/`}>Stay tonight</a>
          <a href={`${base}/recycling/`}>Recycling</a>
          <a href={`${base}/about/`}>About</a>
        </nav>
      </div>
      <RidgeLine />
    </header>
    <main class="wrap"><slot /></main>
    <footer class="site">
      <div class="wrap">
        <p>An open experiment for Morgantown and Monongalia County, WV. Every item links to its source and says when we last checked it. Something wrong or missing? <a href="https://github.com/david-shortman/mon-county-community-hub/issues/new?template=suggest-resource.yml">Tell us</a>.</p>
      </div>
    </footer>
  </body>
</html>
