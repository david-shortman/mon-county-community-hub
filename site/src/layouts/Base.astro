---
import RidgeLine from '../components/RidgeLine.astro';
import Icon from '../components/Icon.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { loadPages } from '../lib/pages.mjs';
import { loadDoors } from '../lib/content.mjs';
const { searchable = true, title, description = 'Plain-language help for life in Morgantown and Monongalia County, WV.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(/\.\w+$/.test(Astro.url.pathname) ? Astro.url.pathname : Astro.url.pathname.replace(/\/?$/, '/'), Astro.site).href;
const shareImage = new URL(`${base}/share.png`, Astro.site).href;
// Main menu. On phones it becomes a tab bar at the bottom of the screen,
// where a thumb can reach it: the `tab` pages (the most urgent needs first)
// plus More, which lists every page. `aria-current` marks the page you are on.
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const navItems = [
  { href: `${base}/`, label: 'Home', icon: 'home', tab: true, wide: false },
  { href: `${base}/calendar/`, label: 'Deadlines', icon: 'calendar', tab: true },
  { href: `${base}/stay-tonight/`, label: 'Stay tonight', icon: 'bed', tab: true },
  { href: `${base}/recycling/`, label: 'Recycling', icon: 'recycle' },
  { href: `${base}/utility-bills/`, label: 'Bill help', icon: 'bulb', tab: true },
  { href: `${base}/money/`, label: 'Money help', icon: 'bulb' },
  { href: `${base}/snap/`, label: 'Apply for SNAP', icon: 'info' },
  { href: `${base}/flu-shots/`, label: 'Flu and COVID shots', icon: 'info' },
  { href: `${base}/staying-well/`, label: 'Staying well', icon: 'health' },
  { href: `${base}/the-idea/`, label: 'The idea behind this site', icon: 'info' },
  { href: `${base}/about/`, label: 'About', icon: 'info' },
  { href: `${base}/topics/`, label: 'All topics', icon: 'more' },
].map((n) => ({ ...n, current: n.href.replace(/\/$/, '') === here.replace(/^\/$/, '') }));
// On phones, a page that is only under More marks the More tab instead.
const moreCurrent = navItems.find((n) => n.current && !n.tab);
// Heading face: Atkinson Hyperlegible Next (SIL Open Font License, see
// public/fonts/OFL.txt), self-hosted, one weight, Latin only, about 11 KB.
// font-display: optional means text never waits for it and never shifts.
const headingFont = `${base}/fonts/atkinson-hyperlegible-next-800.woff2`;
const fontFace = `@font-face { font-family: "Atkinson Hyperlegible Next"; font-weight: 800; font-style: normal; font-display: optional; src: url("${headingFont}") format("woff2"); }`;
// This page's door and topic tags (#249): a breadcrumb, and search filters.
const route = `${here.slice(base.length)}/`.replace(/^\/*/, '/');
const tags = (await loadPages()).get(route);
const doors = loadDoors();
const tagDoor = tags && doors.bySlug[tags.door];
const tagTopic = tagDoor?.topics?.[tags.topic];
const fullTitle = title ? `${title} | Mon County Community Hub` : 'Mon County Community Hub';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mon County Community Hub" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content="Mon County Community Hub" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <style set:html={fontFace}></style>
    <style is:global>
      /* Local identity tokens. Source of truth and contrast ratios: docs/design/identity.md */
      :root {
        --bg: #f9f7f2; --fg: #1d1d1b; --muted: #4f4e4a; --line: #ddd6ca;
        --accent: #1e5847; --accent-bg: #e6f0ec; --card: #ffffff;
        --display: "Atkinson Hyperlegible Next", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        --brick: #9b4a34; --ridge: #a9bcb1;
        color-scheme: light dark;
      }
      @media (prefers-color-scheme: dark) {
        :root { --bg: #161714; --fg: #ecebe6; --muted: #b7b5ae; --line: #363830; --accent: #8fd1b5; --accent-bg: #1f2c26; --card: #1d1f1b; --brick: #d98c72; --ridge: #3f5449; }
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--fg); font: 1.125rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
      a { color: var(--accent); text-underline-offset: 3px; }
      a:focus-visible, button:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
      .wrap { max-width: 46rem; margin: 0 auto; padding: 0 16px; }
      header.site { border-bottom: 1px solid var(--line); }
      header.site .wrap { display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: baseline; padding-block: 14px; }
      header.site .brand { color: var(--fg); text-decoration: none; margin-right: auto; }
      .ridge { display: block; width: 100%; height: 16px; }
      .ridge .ridge-line { fill: none; stroke: var(--ridge); stroke-width: 1.5; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
      .ridge .ridge-fill { fill: var(--card); }
      header.site .header-ridge { margin-top: -6px; }
      nav.main { display: flex; flex-wrap: wrap; gap: 4px 16px; position: relative; }
      nav.main > a { display: inline-flex; align-items: center; min-height: 24px; }
      nav.main > a[aria-current="page"] { color: var(--fg); font-weight: 700; text-decoration-thickness: 3px; }
      nav.main .short { display: none; }
      nav.main .icon, nav.main .ridge, nav.main .narrow-only, nav.main .more, nav.main .more-link { display: none; }
      nav.main .tab span, nav.main .extra span { white-space: nowrap; }
      .more-menu { inset: auto max(8px, env(safe-area-inset-right)) calc(var(--tabbar, 0px) + 12px) auto; margin: 0; min-width: 14rem;
        padding: 8px; background: var(--card); color: var(--fg); border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 6px 24px rgb(0 0 0 / 0.18); }
      .more-menu .more-title { margin: 4px 12px; font-size: 0.875rem; font-weight: 700; color: var(--muted); }
      .more-menu ul, .all-pages ul { list-style: none; margin: 0; padding: 0; }
      .more-menu a { display: flex; align-items: center; min-height: 48px; padding: 0 12px; border-radius: 8px; font-weight: 600; }
      .more-menu a[aria-current="page"] { background: var(--accent-bg); }
      .all-pages ul { display: flex; flex-wrap: wrap; gap: 4px 18px; }
      .all-pages a { display: inline-flex; align-items: center; min-height: 44px; }
      .skip { position: absolute; left: 8px; top: -100px; z-index: 20; padding: 10px 14px; background: var(--card); border: 2px solid var(--accent); border-radius: 8px; }
      .skip:focus { top: 8px; }
      main:focus { outline: none; }
      .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
      /* Phones: the menu is a tab bar at the bottom, in reach of a thumb. */
      @media (max-width: 40rem) {
        :root { --tabbar: calc(64px + env(safe-area-inset-bottom)); }
        html { scroll-padding-bottom: calc(var(--tabbar) + 16px); }
        body { padding-bottom: var(--tabbar); }
        header.site .wrap { padding-block: 12px 10px; }
        header.site .header-ridge { display: none; }
        nav.main { position: fixed; z-index: 10; inset: auto 0 0 0; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 0;
          background: var(--card); padding: 4px max(4px, env(safe-area-inset-right)) env(safe-area-inset-bottom) max(4px, env(safe-area-inset-left)); }
        nav.main .ridge { display: block; position: absolute; left: 0; right: 0; bottom: 100%; height: 14px; }
        nav.main .extra { display: none; }
        nav.main .narrow-only, nav.main .more { display: flex; }
        nav.main .more { border: 0; background: none; font: inherit; cursor: pointer; -webkit-appearance: none; appearance: none; margin: 0; width: 100%; }
        nav.main > a, nav.main .more { flex-direction: column; align-items: center; justify-content: center; gap: 2px; min-height: 56px; padding: 0 2px; font-size: min(0.875rem, 14px); min-width: 0; overflow-wrap: anywhere; font-weight: 600; line-height: 1.15; text-align: center; text-decoration: none; color: var(--muted); }
        nav.main .tab span { white-space: normal; }
        nav.main .icon { display: block; width: 26px; height: 26px; padding: 2px 10px; box-sizing: content-box; border-radius: 999px; }
        nav.main > a[aria-current="page"] { color: var(--accent); font-weight: 700; }
        nav.main .tab .long.has-short { display: none; }
        nav.main .short { display: inline; }
        nav.main > a[aria-current="page"] .icon, nav.main .more.has-current .icon { background: var(--accent-bg); }
        nav.main .more.has-current { color: var(--accent); font-weight: 700; }
        nav.main > a:focus-visible, nav.main .more:focus-visible { outline-offset: -3px; border-radius: 10px; }
        @supports not selector(:popover-open) {
          nav.main .more, .more-menu { display: none; }
          nav.main .more-link { display: flex; }
        }
      }
      .icon { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex: none; }
      main { padding-block: 24px 48px; }
      h1, h2, h3, header.site .brand { font-family: var(--display); font-weight: 800; text-wrap: balance; }
      h1 { font-size: 1.9rem; line-height: 1.2; margin: 0.4em 0; }
      h2 { font-size: 1.35rem; margin-top: 2em; }
      .lede { font-size: 1.15rem; color: var(--muted); }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 16px 18px; margin: 14px 0; }
      .card h3 { margin: 0 0 4px; font-size: 1.1rem; }
      .when { font-weight: 600; color: var(--accent); }
      .meta { font-size: 0.85rem; color: var(--muted); overflow-wrap: anywhere; }
      .event h3 { margin-top: 2px; }
      .date-chip { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; margin: 0 0 6px; font-size: 1.25rem; font-weight: 700; line-height: 1.3; color: var(--accent); }
      .date-chip .time { font-size: 1.05rem; }
      .date-chip .rel { font-size: 0.9rem; font-weight: 600; color: var(--muted); }
      .actions { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(9.5rem, 100%), 1fr)); gap: 8px; margin: 14px 0; }
      .actions > * { min-width: 0; }
      .btn .nowrap { white-space: normal; }
      main { overflow-wrap: anywhere; }
      .btn { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; padding: 8px 12px; border: 1.5px solid var(--accent); border-radius: 10px;
        background: var(--card); color: var(--accent); font: inherit; font-size: 1rem; font-weight: 600; line-height: 1.25; text-align: center; text-decoration: none; cursor: pointer; }
      .btn:hover { background: var(--accent-bg); }
      .btn-primary { grid-column: 1 / -1; background: var(--accent); color: var(--card); }
      .btn-primary:hover { background: var(--accent); text-decoration: underline; }
      .btn[hidden] { display: none; }
      .btn-wide { grid-column: 1 / -1; }
      .nowrap { white-space: nowrap; }
      .actions .icon { width: 20px; height: 20px; }
      .note { background: var(--accent-bg); border-left: 4px solid var(--brick); border-radius: 4px 10px 10px 4px; padding: 12px 16px; }
      .add-cal { background: var(--accent-bg); border-left: 4px solid var(--brick); border-radius: 4px 10px 10px 4px; padding: 4px 16px 12px; margin: 16px 0; }
      .add-cal h2 { margin-top: 0.6em; }
      .add-cal summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; }
      .add-cal input { width: 100%; min-height: 44px; font: inherit; font-size: 0.9rem; padding: 6px 10px; color: var(--fg); background: var(--card); border: 1px solid var(--line); border-radius: 6px; }
      /* Front Door (identity v2, direction B) */
      h1.front-q { font-size: clamp(1.9rem, 1.5rem + 2vw, 2.8rem); line-height: 1.1; margin: 0.15em 0 0.4em; }
      .right-now { background: var(--accent-bg); border-left: 4px solid var(--brick); border-radius: 4px 12px 12px 4px; padding: 4px 16px 12px; }
      .right-now h2 { margin: 0.5em 0 0; font-size: 1.2rem; }
      .right-now .actions { margin: 10px 0 8px; }
      .right-now .pair .actions { grid-template-columns: 1fr 1fr; }
      .right-now .pair .btn-primary { grid-column: auto; }
      .right-now p { margin: 6px 0; }
      .right-now .crisis { font-weight: 600; margin-top: 10px; }
      .crisis-btns { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 6px 0 10px; }
      .crisis-btns .btn { padding: 8px 6px; gap: 6px; }
      .crisis-btns .icon { display: none; }
      .crisis-btns span { white-space: nowrap; }
      .search { display: grid; grid-template-columns: minmax(0, 1fr); gap: 6px; margin: 24px 0 8px; }
      .search label { font-family: var(--display); font-weight: 800; font-size: 1.15rem; }
      .search[hidden] { display: none; }
      .search-row { display: flex; gap: 8px; }
      .search input { flex: 1; min-width: 0; min-height: 52px; padding: 8px 14px; font: inherit; color: var(--fg); background: var(--card); border: 2px solid var(--fg); border-radius: 12px; }
      .search input:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
      .btn-search { flex: none; min-height: 52px; background: var(--accent); color: var(--card); border-radius: 12px; padding: 8px 18px; }
      .btn-search:hover { background: var(--accent); text-decoration: underline; }
      .needs ul { list-style: none; margin: 16px 0 8px; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 9.5rem), 1fr)); gap: 10px; }
      .need { display: grid; grid-template-rows: auto auto 1fr; gap: 4px; min-height: 120px; height: 100%; padding: 14px; border-radius: 12px; background: var(--card); border: 2px solid var(--line); color: var(--fg); text-decoration: none; }
      .need:hover { border-color: var(--accent); }
      .need .icon { width: 28px; height: 28px; color: var(--accent); }
      .need-label { font-family: var(--display); font-weight: 800; font-size: 1.1rem; line-height: 1.2; }
      .need-hint { font-size: 0.9rem; line-height: 1.35; color: var(--muted); }
      .question .q-step { font-weight: 600; color: var(--muted); margin-bottom: 4px; }
      .choices { list-style: none; margin: 8px 0 16px; padding: 0; display: grid; gap: 10px; }
      .choice { display: grid; gap: 2px; min-height: 64px; padding: 14px 16px; border: 2px solid var(--accent); border-radius: 12px; background: var(--card); color: var(--fg); text-decoration: none; }
      .choice:hover { background: var(--accent-bg); }
      .choice-label { font-family: var(--display); font-weight: 800; font-size: 1.2rem; color: var(--accent); }
      .choice-hint { color: var(--muted); font-size: 0.95rem; }
      .results { list-style: none; margin: 0; padding: 0; }
      .search-status { font-weight: 600; min-height: 1.6em; }
      .search-results { overflow-wrap: anywhere; margin: 8px 0 24px; padding-left: 1.4rem; display: grid; gap: 14px; }
      .search-results a { font-weight: 700; font-size: 1.1rem; }
      .search-results p { margin: 2px 0 0; color: var(--muted); }
      .search-results mark { background: var(--accent-bg); color: var(--fg); font-weight: 600; }
      .crumbs ol { list-style: none; margin: 0 0 4px; padding: 0; display: flex; flex-wrap: wrap; gap: 2px 8px; font-size: 0.95rem; line-height: 1.3; }
      .crumbs li { display: flex; align-items: center; gap: 6px; }
      .crumbs li + li::before { content: "›"; color: var(--muted); }
      .crumbs a { display: inline-flex; align-items: center; min-height: 32px; }
      .topic-door { margin-top: 2.2em; }
      .topic-door > p { margin: 0 0 8px; color: var(--muted); }
      .topic-list { margin: 4px 0 16px; padding-left: 1.2rem; display: grid; gap: 6px; }
      .topic-list .hint { display: block; font-size: 0.95rem; color: var(--muted); }
      footer.site { border-top: 2px solid var(--brick); font-size: 0.9rem; color: var(--muted); padding-block: 20px 40px; }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={`${base}/`}>Mon County Community Hub</a>
        <nav class="main" aria-label="Main">
          <RidgeLine filled />
          {navItems.map((n) => (
            <a class:list={[n.tab ? 'tab' : 'extra', n.wide === false && 'narrow-only']} href={n.href} aria-current={n.current ? 'page' : undefined}><Icon name={n.icon} /><span class:list={['long', n.tabLabel && 'has-short']}>{n.label}</span>{n.tabLabel && <span class="short">{n.tabLabel}</span>}</a>
          ))}
          <button class:list={['tab more', moreCurrent && 'has-current']} type="button" popovertarget="more-menu"><Icon name="more" /><span>More{moreCurrent && <span class="sr-only">, you are on {moreCurrent.label}</span>}</span></button>
          <a class="tab more-link" href="#all-pages"><Icon name="more" /><span>More</span></a>
          <div id="more-menu" class="more-menu" popover>
            <p class="more-title">All pages</p>
            <ul>{navItems.map((n) => <li><a href={n.href} aria-current={n.current ? 'page' : undefined}>{n.label}</a></li>)}</ul>
          </div>
        </nav>
      </div>
      <RidgeLine class="header-ridge" />
    </header>
    <main class="wrap" id="main" tabindex="-1" data-pagefind-body={searchable ? '' : undefined}>
      <Breadcrumb route={route} />
      {searchable && tagDoor && <p hidden data-pagefind-filter="door">{tagDoor.name}</p>}
      {searchable && tagTopic && <p hidden data-pagefind-filter="topic">{tagTopic}</p>}
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <nav id="all-pages" class="all-pages" aria-label="All pages">
          <ul>{navItems.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
        </nav>
        <p>An open experiment for Morgantown and Monongalia County, WV. Every item links to its source and says when we last checked it. Something wrong or missing? <a href="https://github.com/david-shortman/mon-county-community-hub/issues/new?template=suggest-resource.yml">Tell us</a>.</p>
      </div>
    </footer>
    <div class="sr-only" role="status" id="announce"></div>
    <script is:inline>
      // Small and optional: the page works without it.
      // 1. Keep "in 3 days" labels right between daily rebuilds (Eastern time).
      (function () {
        var today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/New_York' }).format(new Date());
        var days = function (a, b) { return Math.round((Date.parse(b + 'T12:00:00Z') - Date.parse(a + 'T12:00:00Z')) / 864e5); };
        var inDays = function (n) { return n === 1 ? 'tomorrow' : 'in ' + n + ' days'; };
        document.querySelectorAll('.rel[data-starts]').forEach(function (el) {
          var s = el.dataset.starts, e = el.dataset.ends;
          el.textContent = s > today ? inDays(days(today, s)) : e < today ? 'over' : s === e ? 'today' : e === today ? 'last day is today' : 'open now, ends ' + inDays(days(today, e));
        });
        // 2. Share: the phone's share sheet when there is one, otherwise copy the link.
        var say = function (t) { var a = document.getElementById('announce'); a.textContent = ''; setTimeout(function () { a.textContent = t; }, 50); };
        document.querySelectorAll('button.share').forEach(function (b) {
          if (!navigator.share && !(navigator.clipboard && window.isSecureContext)) return;
          if (!navigator.share) b.querySelector('.label').textContent = 'Copy link';
          b.hidden = false;
          b.addEventListener('click', function () {
            if (navigator.share) { navigator.share({ title: b.dataset.title, url: b.dataset.url }).catch(function () {}); return; }
            navigator.clipboard.writeText(b.dataset.url).then(function () { say('Link copied'); });
          });
        });
      })();
    </script>
  </body>
</html>
