---
import RidgeLine from '../components/RidgeLine.astro';
import Icon from '../components/Icon.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CrisisStrip from '../components/CrisisStrip.astro';
import AppShell from '../components/AppShell.astro';
import { loadPages, doorHref } from '../lib/pages.mjs';
import { loadDoors } from '../lib/content.mjs';
const { crisis = false, searchable = true, title, description = 'Local help for life in Morgantown and Monongalia County, WV.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(/\.\w+$/.test(Astro.url.pathname) ? Astro.url.pathname : Astro.url.pathname.replace(/\/?$/, '/'), Astro.site).href;
const shareImage = new URL(`${base}/share.png`, Astro.site).href;
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
// Heading face: Atkinson Hyperlegible Next (SIL Open Font License, see
// public/fonts/OFL.txt), self-hosted, one weight, Latin only, about 11 KB.
// font-display: optional means text never waits for it and never shifts.
const headingFont = `${base}/fonts/atkinson-hyperlegible-next-800.woff2`;
const fontFace = `@font-face { font-family: "Atkinson Hyperlegible Next"; font-weight: 800; font-style: normal; font-display: optional; src: url("${headingFont}") format("woff2"); }`;
// This page's door and topic tags (#249): a breadcrumb, and search filters.
const route = `${here.slice(base.length)}/`.replace(/^\/*/, '/');
const tags = (await loadPages()).get(route);
const doors = loadDoors();
const tagDoor = tags && doors.bySlug[tags.door];
const tagTopic = tagDoor?.topics?.[tags.topic];
// Main menu (#250), built from content/doors.yaml, so adding a page never
// changes it. Phones: a tab bar of four at the bottom, in thumb reach. Wide
// screens: Help now, the five doors, Dates and All topics in the header.
// `aria-current` is "page" on the page itself and "true" on its section.
const lane = (slug) => doors.bySlug[slug];
const isDoor = doors.doors.some((d) => d.slug === tags?.door);
const mark = (href, slug) => (href === route ? 'page' : slug && slug === tags?.door ? 'true' : undefined);
const helpNow = { href: lane('help-now').page, label: 'Help now', current: mark(lane('help-now').page, 'help-now') };
const dates = { href: lane('dates').page, label: 'Dates', current: mark(lane('dates').page, 'dates') };
const topicsCurrent = route === '/topics/' ? 'page' : isDoor ? 'true' : undefined;
const tabs = [
  { href: '/', label: 'Home', icon: 'home', current: route === '/' ? 'page' : undefined },
  { ...helpNow, icon: 'bed' },
  { ...dates, icon: 'calendar' },
  { href: '/topics/', label: 'Topics', icon: 'list', current: topicsCurrent },
];
const wide = [
  helpNow,
  ...doors.doors.map((d) => ({ href: doorHref(d), label: d.name, current: mark(doorHref(d), d.slug) })),
  dates,
  { href: '/topics/', label: 'All topics', current: route === '/topics/' ? 'page' : undefined },
];
const footerLinks = [
  ...doors.doors.map((d) => ({ href: doorHref(d), label: d.name })),
  { href: '/topics/', label: 'All topics' },
  { href: '/about/', label: 'About this site' },
  { href: '/partners/', label: 'For groups and helpers' },
];
const fullTitle = title ? `${title} | Mon County Community Hub` : 'Mon County Community Hub';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {crisis && <meta name="referrer" content="no-referrer" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mon County Community Hub" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content="Mon County Community Hub" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <AppShell />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <style set:html={fontFace}></style>
    <style is:global>
      /* Local identity tokens. Source of truth and contrast ratios: docs/design/identity.md */
      :root {
        --bg: #f9f7f2; --fg: #1d1d1b; --muted: #4f4e4a; --line: #ddd6ca;
        --accent: #1e5847; --accent-bg: #e6f0ec; --card: #ffffff;
        --display: "Atkinson Hyperlegible Next", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        --brick: #9b4a34; --ridge: #a9bcb1;
        color-scheme: light dark;
      }
      @media (prefers-color-scheme: dark) {
        :root { --bg: #161714; --fg: #ecebe6; --muted: #b7b5ae; --line: #363830; --accent: #8fd1b5; --accent-bg: #1f2c26; --card: #1d1f1b; --brick: #d98c72; --ridge: #3f5449; }
      }
      * { box-sizing: border-box; }
      [hidden] { display: none !important; }
      body { margin: 0; background: var(--bg); color: var(--fg); font: 1.125rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
      a { color: var(--accent); text-underline-offset: 3px; }
      a:focus-visible, button:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
      /* A link on its own line ("See all ...") gets a 44px tap area (#50). */
      .more a { display: inline-flex; align-items: center; min-height: 44px; }
      .wrap { max-width: 46rem; margin: 0 auto; padding: 0 16px; }
      header.site { border-bottom: 1px solid var(--line); }
      header.site .wrap { display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: baseline; padding-block: 14px; }
      header.site .brand { color: var(--fg); text-decoration: none; margin-right: auto; }
      .ridge { display: block; width: 100%; height: 16px; }
      .ridge .ridge-line { fill: none; stroke: var(--ridge); stroke-width: 1.5; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
      .ridge .ridge-fill { fill: var(--card); }
      header.site .header-ridge { margin-top: -6px; }
      nav.main { display: flex; flex-wrap: wrap; flex-basis: 100%; gap: 0 18px; position: relative; }
      nav.main .tab, nav.main .ridge { display: none; }
      nav.main .wide { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; }
      nav.main .wide[aria-current] { color: var(--fg); font-weight: 700; text-decoration-thickness: 3px; }
      .foot-links ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 18px; }
      .foot-links a { display: inline-flex; align-items: center; min-height: 44px; }
      .skip { position: absolute; left: 8px; top: -20em; z-index: 20; padding: 10px 14px; background: var(--card); border: 2px solid var(--accent); border-radius: 8px; }
      .skip:focus { top: 8px; }
      main:focus { outline: none; }
      .sr-only { position: absolute; left: 0; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
      /* Phones: the menu is a tab bar at the bottom, in reach of a thumb. */
      @media (max-width: 40rem) {
        /* Tab labels grow with the reader's text size, up to the size where the longest word still fits a quarter of the screen (#311). The bar grows with them. */
        :root { --tab-fs: min(0.875rem, 6vw); --tabbar: calc(44px + 2.3 * var(--tab-fs) + env(safe-area-inset-bottom)); }
        html { scroll-padding-bottom: calc(var(--tabbar) + 16px); }
        body { padding-bottom: var(--tabbar); }
        header.site .wrap { padding-block: 12px 10px; }
        header.site .header-ridge { display: none; }
        nav.main { position: fixed; z-index: 10; inset: auto 0 0 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0;
          background: var(--card); padding: 4px max(4px, env(safe-area-inset-right)) env(safe-area-inset-bottom) max(4px, env(safe-area-inset-left)); }
        nav.main .ridge { display: block; position: absolute; left: 0; right: 0; bottom: 100%; height: 14px; }
        nav.main .wide { display: none; }
        nav.main .tab { display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 2px; min-height: 56px; padding: 4px 2px 0; font-size: var(--tab-fs); min-width: 0; overflow-wrap: anywhere; font-weight: 600; line-height: 1.15; text-align: center; text-decoration: none; color: var(--muted); }
        nav.main .icon { display: block; width: 26px; height: 26px; padding: 2px 10px; box-sizing: content-box; border-radius: 999px; }
        nav.main .tab[aria-current] { color: var(--accent); font-weight: 700; }
        nav.main .tab[aria-current] .icon { background: var(--accent-bg); }
        nav.main .tab:focus-visible { outline-offset: -3px; border-radius: 10px; }
      }
      .icon { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex: none; }
      main { padding-block: 24px 48px; }
      h1, h2, h3, header.site .brand { font-family: var(--display); font-weight: 800; text-wrap: balance; }
      h1 { font-size: 1.9rem; line-height: 1.2; margin: 0.4em 0; }
      h2 { font-size: 1.35rem; margin-top: 2em; }
      .lede { font-size: 1.15rem; color: var(--muted); }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 16px 18px; margin: 14px 0; }
      .card h3 { margin: 0 0 4px; font-size: 1.1rem; }
      .when { font-weight: 600; color: var(--accent); }
      .meta { font-size: 0.85rem; color: var(--muted); overflow-wrap: anywhere; }
      .event h3 { margin-top: 2px; }
      .date-chip { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; margin: 0 0 6px; font-size: 1.25rem; font-weight: 700; line-height: 1.3; color: var(--accent); }
      .date-chip .time { font-size: 1.05rem; }
      .date-chip .rel { font-size: 0.9rem; font-weight: 600; color: var(--muted); }
      .actions { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(9.5rem, 100%), 1fr)); gap: 8px; margin: 14px 0; }
      .actions > * { min-width: 0; }
      .btn .nowrap { white-space: normal; }
      main { overflow-wrap: anywhere; }
      .btn { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; padding: 8px 12px; border: 1.5px solid var(--accent); border-radius: 10px;
        background: var(--card); color: var(--accent); font: inherit; font-size: 1rem; font-weight: 600; line-height: 1.25; text-align: center; text-decoration: none; cursor: pointer; }
      .btn:hover { background: var(--accent-bg); }
      .btn-primary { grid-column: 1 / -1; background: var(--accent); color: var(--card); }
      .btn-primary:hover { background: var(--accent); text-decoration: underline; }
      .btn[hidden] { display: none; }
      .btn-wide { grid-column: 1 / -1; }
      .nowrap { white-space: nowrap; }
      .actions .icon { width: 20px; height: 20px; }
      .note { background: var(--accent-bg); border-left: 4px solid var(--brick); border-radius: 4px 10px 10px 4px; padding: 12px 16px; }
      /* No empty band above the first heading in a card or box (#247). */
      .card > :first-child, .note > :first-child { margin-top: 0; }
      .add-cal { background: var(--accent-bg); border-left: 4px solid var(--brick); border-radius: 4px 10px 10px 4px; padding: 4px 16px 12px; margin: 16px 0; }
      .add-cal h2 { margin-top: 0.6em; }
      .add-cal summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; }
      .add-cal input { width: 100%; min-height: 44px; font: inherit; font-size: 0.9rem; padding: 6px 10px; color: var(--fg); background: var(--card); border: 1px solid var(--line); border-radius: 6px; }
      /* Front Door (#250): Help now bar, doors, season card */
      .front-h { font-size: clamp(1.9rem, 1.5rem + 2vw, 2.6rem); line-height: 1.12; margin: 0.7em 0 0.2em; }
      .right-now { background: var(--accent-bg); border-left: 4px solid var(--brick); border-radius: 4px 12px 12px 4px; padding: 2px 14px 10px; margin-top: 8px; }
      .right-now .rn-h { margin: 0; font-family: var(--display); font-weight: 800; font-size: 1.2rem; }
      .right-now p { margin: 6px 0; }
      .right-now .actions { margin: 6px 0; }
      .right-now .pair .actions, .right-now .actions.pair { grid-template-columns: 1fr 1fr; }
      .right-now .pair .btn-primary, .right-now .actions.pair .btn-primary { grid-column: auto; }
      .right-now .rn-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0 12px; }
      .right-now .tonight { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-weight: 700; }
      .right-now .tonight .icon { width: 22px; height: 22px; }
      .right-now .crisis { font-weight: 600; margin: 8px 0 0; font-size: 0.95rem; }
      .crisis-btns { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 6px 0 4px; }
      .crisis-btns .btn { padding: 8px 6px; gap: 6px; }
      .crisis-btns span { white-space: nowrap; }
      .doors h2 { margin-top: 1.1em; }
      .door-list { list-style: none; margin: 12px 0 8px; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); gap: 10px; }
      .door { background: var(--card); border: 2px solid var(--line); border-radius: 12px; padding: 4px 14px 10px; }
      .door:has(.door-name:hover) { border-color: var(--accent); }
      .door-name { display: flex; align-items: center; gap: 10px; min-height: 52px; font-family: var(--display); font-weight: 800; font-size: 1.2rem; line-height: 1.2; text-decoration: none; }
      .door-name:hover span { text-decoration: underline; }
      .door-name .icon { width: 28px; height: 28px; padding: 6px; box-sizing: content-box; border-radius: 999px; background: var(--accent-bg); }
      .door-ex { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 18px; }
      .door-ex a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; }
      .door-hint { margin: 0 0 6px; color: var(--muted); font-size: 0.95rem; line-height: 1.4; }
      .season { border-left: 4px solid var(--brick); margin-top: 24px; }
      .season h2 { margin: 0.1em 0 0.3em; font-size: 1.25rem; }
      .season ul { margin: 6px 0 0; padding-left: 1.2rem; }
      .season li a { display: inline-flex; align-items: center; min-height: 44px; }
      .eyebrow { margin: 4px 0 0; font-size: 0.85rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); }
      .search { display: grid; grid-template-columns: minmax(0, 1fr); gap: 6px; margin: 24px 0 8px; }
      .search label { font-family: var(--display); font-weight: 800; font-size: 1.15rem; }
      .search[hidden] { display: none; }
      .search-row { display: flex; gap: 8px; }
      .search input { flex: 1; min-width: 0; min-height: 52px; padding: 8px 14px; font: inherit; color: var(--fg); background: var(--card); border: 2px solid var(--fg); border-radius: 12px; }
      .search input:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
      .btn-search { flex: none; min-height: 52px; background: var(--accent); color: var(--card); border-radius: 12px; padding: 8px 18px; }
      .btn-search:hover { background: var(--accent); text-decoration: underline; }
      .question .q-step { font-weight: 600; color: var(--muted); margin-bottom: 4px; }
      .choices { list-style: none; margin: 8px 0 16px; padding: 0; display: grid; gap: 10px; }
      .choice { display: grid; gap: 2px; min-height: 64px; padding: 14px 16px; border: 2px solid var(--accent); border-radius: 12px; background: var(--card); color: var(--fg); text-decoration: none; }
      .choice:hover { background: var(--accent-bg); }
      .choice-label { font-family: var(--display); font-weight: 800; font-size: 1.2rem; color: var(--accent); }
      .choice-hint { color: var(--muted); font-size: 0.95rem; }
      .results { list-style: none; margin: 0; padding: 0; }
      .search-status { font-weight: 600; min-height: 1.6em; }
      .search-results { overflow-wrap: anywhere; margin: 8px 0 24px; padding-left: 1.4rem; display: grid; gap: 14px; }
      .search-results a { font-weight: 700; font-size: 1.1rem; }
      .search-results p { margin: 2px 0 0; color: var(--muted); }
      .search-results mark { background: var(--accent-bg); color: var(--fg); font-weight: 600; }
      .crumbs ol { list-style: none; margin: 0 0 4px; padding: 0; display: flex; flex-wrap: wrap; gap: 0 8px; font-size: 0.95rem; line-height: 1.3; }
      .crumbs li { display: flex; align-items: center; gap: 6px; }
      .crumbs li + li::before { content: "›"; color: var(--muted); }
      .crumbs a { display: inline-flex; align-items: center; min-height: 44px; }
      .topic-door { margin-top: 2.2em; }
      .topic-door > p { margin: 0 0 8px; color: var(--muted); }
      .topic-list { margin: 4px 0 16px; padding-left: 1.2rem; display: grid; gap: 6px; }
      .topic-list .hint { display: block; font-size: 0.95rem; color: var(--muted); }
      /* Door pages (#235): pick what fits, then steps as mileposts */
      .cant-wait { margin: 12px 0 8px; padding-top: 6px; }
      .cant-wait > p:first-child { font-weight: 600; }
      .cant-wait .crisis-btns { grid-template-columns: repeat(auto-fit, minmax(min(100%, 5.5rem), 1fr)); }
      .door-pick fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
      .pick { list-style: none; margin: 8px 0 12px; padding: 0; display: grid; gap: 8px; }
      .pick label { display: flex; gap: 12px; align-items: center; min-height: 56px; padding: 10px 14px; background: var(--card); border: 2px solid var(--line); border-radius: 12px; cursor: pointer; font-weight: 600; line-height: 1.3; }
      .pick input { width: 24px; height: 24px; flex: none; accent-color: var(--accent); margin: 0; }
      .pick label:has(input:checked) { border-color: var(--accent); background: var(--accent-bg); }
      .pick label:has(input:focus-visible) { outline: 3px solid var(--accent); outline-offset: 2px; }
      .door-plan h2:focus { outline: none; }
      .step-group h3 { margin: 1.4em 0 0.4em; }
      .steps { list-style: none; margin: 0; padding: 0 0 0 18px; border-left: 3px solid var(--ridge); display: grid; gap: 14px; }
      .step { position: relative; background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 12px 16px; }
      .step::before { content: ""; position: absolute; left: -27px; top: 18px; width: 12px; height: 12px; border-radius: 999px; background: var(--accent); border: 3px solid var(--bg); }
      .step > p:first-child { margin: 0 0 4px; font-weight: 600; }
      .step-cost { margin: 4px 0; font-size: 0.95rem; }
      .keep-steps { margin-top: 18px; }
      @media print {
        header.site, nav.main, footer.site, .skip, .crisis-strip, .crumbs, .door-pick, .sit-links, .keep-steps, .cant-wait .crisis-btns { display: none !important; }
        body { padding: 0; background: #fff; color: #000; }
        .step { break-inside: avoid; }
      }
      /* Crisis strip and quick exit (#174), on safety pages only */
      .crisis-strip { position: sticky; top: 0; z-index: 15; background: var(--accent-bg); border-bottom: 2px solid var(--brick); }
      .crisis-strip .wrap { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; padding-block: 6px; }
      .crisis-strip p { flex: 1 1 7rem; min-width: 0; margin: 0; font-size: 1rem; line-height: 1.5; font-weight: 600; }
      .crisis-strip p a { font-weight: 800; padding: 6px 2px; }
      .quick-exit { flex: 0 1 auto; min-width: 0; text-align: center; overflow-wrap: anywhere; display: inline-flex; align-items: center; min-height: 48px; padding: 0 12px; border-radius: 10px; background: var(--fg); color: var(--bg); font-weight: 700; text-decoration: none; }
      .quick-exit:hover { text-decoration: underline; }
      html:has(.crisis-strip) { scroll-padding-top: 8rem; }
      footer.site { border-top: 2px solid var(--brick); font-size: 0.9rem; color: var(--muted); padding-block: 20px 40px; }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    {crisis && <CrisisStrip />}
    <header class="site">
      <div class="wrap">
        <a class="brand" href={`${base}/`}>Mon County Community Hub</a>
        <nav class="main" aria-label="Main">
          <RidgeLine filled />
          {tabs.map((t) => <a class="tab" href={`${base}${t.href}`} aria-current={t.current}><Icon name={t.icon} /><span>{t.label}</span></a>)}
          {wide.map((w) => <a class="wide" href={`${base}${w.href}`} aria-current={w.current}>{w.label}</a>)}
        </nav>
      </div>
      <RidgeLine class="header-ridge" />
    </header>
    <main class="wrap" id="main" tabindex="-1" data-pagefind-body={searchable ? '' : undefined}>
      <Breadcrumb route={route} />
      {searchable && tagDoor && <p hidden data-pagefind-filter="door">{tagDoor.name}</p>}
      {searchable && tagTopic && <p hidden data-pagefind-filter="topic">{tagTopic}</p>}
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <nav class="foot-links" aria-label="Doors and site">
          <ul>{footerLinks.map((n) => <li><a href={`${base}${n.href}`}>{n.label}</a></li>)}</ul>
        </nav>
        <p>An open experiment for Morgantown and Monongalia County, WV. Every item links to its source and says when we last checked it. Something wrong or missing? <a href="https://github.com/david-shortman/mon-county-community-hub/issues/new?template=suggest-resource.yml">Tell us</a>. Reports go to GitHub, which needs a free account, and are public, so leave out private details.</p>
      </div>
    </footer>
    <div class="sr-only" role="status" id="announce"></div>
    <script is:inline>
      // Small and optional: the page works without it.
      // 1. Keep "in 3 days" labels right between daily rebuilds (Eastern time).
      (function () {
        var today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/New_York' }).format(new Date());
        var days = function (a, b) { return Math.round((Date.parse(b + 'T12:00:00Z') - Date.parse(a + 'T12:00:00Z')) / 864e5); };
        var inDays = function (n) { return n === 1 ? 'tomorrow' : 'in ' + n + ' days'; };
        document.querySelectorAll('.rel[data-starts]').forEach(function (el) {
          var s = el.dataset.starts, e = el.dataset.ends;
          el.textContent = s > today ? inDays(days(today, s)) : e < today ? 'over' : s === e ? 'today' : e === today ? 'last day is today' : 'open now, ends ' + inDays(days(today, e));
        });
        // 2. Share: the phone's share sheet when there is one, otherwise copy the link.
        var say = function (t) { var a = document.getElementById('announce'); a.textContent = ''; setTimeout(function () { a.textContent = t; }, 50); };
        document.querySelectorAll('button.share').forEach(function (b) {
          if (!navigator.share && !(navigator.clipboard && window.isSecureContext)) return;
          if (!navigator.share) b.querySelector('.label').textContent = 'Copy link';
          b.hidden = false;
          b.addEventListener('click', function () {
            if (navigator.share) { navigator.share({ title: b.dataset.title, url: b.dataset.url }).catch(function () {}); return; }
            navigator.clipboard.writeText(b.dataset.url).then(function () { say('Link copied'); });
          });
        });
      })();
    </script>
  </body>
</html>
