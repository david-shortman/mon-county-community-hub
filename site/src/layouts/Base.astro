---
import Icon from '../components/Icon.astro';
import AlsoCheck from '../components/AlsoCheck.astro';
import AlsoCalled from '../components/AlsoCalled.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CrisisStrip from '../components/CrisisStrip.astro';
import LeaveNote from '../components/LeaveNote.astro';
import CrisisLine from '../components/CrisisLine.astro';
import AppShell from '../components/AppShell.astro';
import UpkeepNotice from '../components/UpkeepNotice.astro';
import ShareThis from '../components/ShareThis.astro';
import { loadPages, doorHref } from '../lib/pages.mjs';
import { fixFormUrl, FIX_EMAIL } from '../lib/group-requests.mjs';
import { loadDoors, todayYmd } from '../lib/content.mjs';
import { todaysForecast, FORECAST_PAGE } from '../lib/weather.mjs';
import { alternatesFor, dirFor } from '../lib/i18n.mjs';
import nameFont from '../fonts/fraunces-name-800.woff2?inline';
import tileSvg from '../../public/favicon.svg?raw';
// noindex: print copies and the 404 page stay out of search results; they get no canonical link (#89).
const { crisis = false, help = false, searchable = true, noindex = false, title, description = 'Local help for life in Morgantown and Monongalia County, WV.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(/\.\w+$/.test(Astro.url.pathname) ? Astro.url.pathname : Astro.url.pathname.replace(/\/?$/, '/'), Astro.site).href;
const shareImage = new URL(`${base}/share.png`, Astro.site).href;
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
// Heading face: Atkinson Hyperlegible Next (SIL Open Font License, see
// public/fonts/OFL.txt), self-hosted, one weight, Latin only, about 11 KB.
// font-display: optional means text never waits for it and never shifts.
const headingFont = `${base}/fonts/atkinson-hyperlegible-next-800.woff2`;
// Site name face (the logo, docs/design/identity.md "The logo"): Fraunces, soft
// (SIL Open Font License, src/fonts/OFL-Fraunces.txt), cut down to only the
// letters in "Everything Morgantown" (about 2.5 KB) and built into the page,
// so the name never waits for a download and never changes font as it loads.
const nameFontFace = `@font-face { font-family: "Fraunces Name"; font-weight: 800; font-style: normal; font-display: block; src: url("${nameFont}") format("woff2"); }`;
const fontFace = `@font-face { font-family: "Atkinson Hyperlegible Next"; font-weight: 800; font-style: normal; font-display: optional; src: url("${headingFont}") format("woff2"); }${nameFontFace}`;
// The logo's tile is the site icon (public/favicon.svg, #390), drawn inline.
const brandMark = tileSvg.replace(/<!--[\s\S]*?-->\s*/, '').replace(/id="r"/, 'id="brand-clip"').replace('url(#r)', 'url(#brand-clip)')
  .replace('<svg ', '<svg class="brand-mark" aria-hidden="true" focusable="false" ');
// This page's door and topic tags (#249): a breadcrumb, and search filters.
const route = `${here.slice(base.length)}/`.replace(/^\/*/, '/');
const tags = (await loadPages()).get(route);
const doors = loadDoors();
const tagDoor = tags && doors.bySlug[tags.door];
const tagTopic = tagDoor?.topics?.[tags.topic];
// Share this (#947): on listed guides only. High-stakes doors and topics wait
// for David, and safety pages never get it (a share leaves a trace).
const shareable = tags?.listed && !['help-now', 'this-month', 'about'].includes(tags.door)
  && !['housing', 'money', 'food'].includes(tags.topic) && !/domestic|sexual|abuse|stay-tonight|veterans/i.test(route);
// Main menu (#250), built from content/doors.yaml, so adding a page never
// changes it. Phones: a tab bar of four at the bottom, in thumb reach. Wide
// screens: Help now, the five doors, Dates and All topics in the header.
// `aria-current` is "page" on the page itself and "true" on its section.
const lane = (slug) => doors.bySlug[slug];
const isDoor = doors.doors.some((d) => d.slug === tags?.door);
const mark = (href, slug) => (href === route ? 'page' : slug && slug === tags?.door ? 'true' : undefined);
const helpNow = { href: lane('help-now').page, label: 'Help now', current: mark(lane('help-now').page, 'help-now') };
const dates = { href: lane('dates').page, label: 'Dates', current: mark(lane('dates').page, 'dates') };
const topicsCurrent = route === '/topics/' ? 'page' : isDoor ? 'true' : undefined;
const tabs = [
  { href: '/', label: 'Home', icon: 'home', current: route === '/' ? 'page' : undefined },
  { ...helpNow, icon: 'bed' },
  { ...dates, icon: 'calendar' },
  { href: '/topics/', label: 'Topics', icon: 'list', current: topicsCurrent },
];
const wide = [
  helpNow,
  ...doors.doors.map((d) => ({ href: doorHref(d), label: d.name, current: mark(doorHref(d), d.slug) })),
  dates,
  { href: '/topics/', label: 'All topics', current: route === '/topics/' ? 'page' : undefined },
];
const footerLinks = [
  ...doors.doors.map((d) => ({ href: doorHref(d), label: d.name })),
  { href: '/topics/', label: 'All topics' },
  { href: '/about/', label: 'About this site' },
  { href: '/partners/', label: 'For groups and helpers' },
  { href: '/terms/', label: 'Terms' },
  { href: '/privacy/', label: 'Privacy' },
];
const disclaimer = 'We check every listing and show when we last checked it, but hours, rules and deadlines change. Call or check the source before you go. This site shares general information. It is not legal, medical or money advice. In an emergency, call 911. In a crisis, call or text 988.';
// Dateline: the place, today's date and the forecast, in Eastern time. The
// page script keeps the date current between rebuilds.
const today = todayYmd();
const dayFmt = (style) => new Intl.DateTimeFormat('en-US', { timeZone: 'UTC', weekday: style, month: style, day: 'numeric' }).format(new Date(`${today}T12:00:00Z`));
const [longToday, shortToday] = [dayFmt('long'), dayFmt('short')];
const forecast = await todaysForecast();
// Other languages (#1083): the page's language (English unless a page in a
// language folder says otherwise), and hreflang links to the
// same page in each published language. Both stay empty on English-only
// pages, which today is every page.
const alternates = alternatesFor(Astro.url.pathname.slice(base.length) || '/', { site: Astro.site });
const { lang = 'en' } = Astro.props;
const dir = dirFor(lang);
// Search results cut titles at about 60 characters, so the site name is added
// only when it fits. og:site_name still names the site on shares (#939).
const SITE_NAME = 'Everything Morgantown';
const fullTitle = !title ? SITE_NAME : `${title} | ${SITE_NAME}`.length <= 60 ? `${title} | ${SITE_NAME}` : title;
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f9f7f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161714" media="(prefers-color-scheme: dark)" />
    {crisis && <meta name="referrer" content="no-referrer" />}
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Everything Morgantown" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content="Everything Morgantown: the site icon, two hills joined by a bridge over the river" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <AppShell />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <style set:html={fontFace}></style>
    <style is:global>
      /* Local identity tokens. Source of truth and contrast ratios: docs/design/identity.md */
      :root {
        --bg: #f9f7f2; --fg: #1d1d1b; --muted: #4f4e4a; --line: #ddd6ca;
        --accent: #1e5847; --accent-bg: #e6f0ec; --card: #ffffff;
        --display: "Atkinson Hyperlegible Next", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        --brick: #9b4a34; --ridge: #a9bcb1;
        color-scheme: light dark;
      }
      @media (prefers-color-scheme: dark) {
        :root { --bg: #161714; --fg: #ecebe6; --muted: #b7b5ae; --line: #363830; --accent: #8fd1b5; --accent-bg: #1f2c26; --card: #1d1f1b; --brick: #d98c72; --ridge: #3f5449; }
      }
      * { box-sizing: border-box; }
      [hidden] { display: none !important; }
      body { margin: 0; background: var(--bg); color: var(--fg); font: 1.125rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
      a { color: var(--accent); text-underline-offset: 3px; }
      a:focus-visible, button:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
      /* A link on its own line ("See all ...") gets a 44px tap area (#50). */
      .more a { display: inline-flex; align-items: center; min-height: 44px; }
      .wrap { max-width: 46rem; margin: 0 auto; padding: 0 16px; }
      header.site { border-bottom: 1px solid var(--line); }
      header.site .wrap { display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: baseline; padding-block: 14px; }
      /* The logo (#421): the site icon as a tile, and the name in Fraunces, soft. */
      header.site .brand { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; color: var(--fg); text-decoration: none; margin-right: auto;
        font-family: "Fraunces Name", Georgia, serif; font-weight: 800; font-size: 1.35rem; line-height: 1.1; }
      .brand-mark { flex: none; width: 40px; height: 40px; border-radius: 9px; }
      @media (prefers-color-scheme: dark) { .brand-mark { box-shadow: 0 0 0 1px var(--line); } }
      .dateline { margin: 0; font-size: 0.9rem; color: var(--muted); }
      .dateline .dl-short { display: none; }
      .dateline a { color: var(--muted); }
      .dateline .icon { width: 1.15em; height: 1.15em; vertical-align: -0.2em; margin-right: 3px; }
      nav.main { display: flex; flex-wrap: wrap; flex-basis: 100%; gap: 0 18px; position: relative; }
      nav.main .tab { display: none; }
      nav.main .wide { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; }
      nav.main .wide[aria-current] { color: var(--fg); font-weight: 700; text-decoration-thickness: 3px; }
      .foot-links ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 18px; }
      .foot-links a { display: inline-flex; align-items: center; min-height: 44px; }
      .skip { position: absolute; left: 8px; top: -20em; z-index: 20; padding: 10px 14px; background: var(--card); border: 2px solid var(--accent); border-radius: 8px; }
      .skip:focus { top: 8px; }
      main:focus { outline: none; }
      /* A jump to a spot on the page leaves a little room above it (#449). */
      [id] { scroll-margin-top: 16px; }
      .sr-only { position: absolute; left: 0; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
      /* Phones: the menu is a tab bar at the bottom, in reach of a thumb. */
      @media (max-width: 40rem) {
        /* Tab labels grow with the reader's text size, up to the size where the longest word still fits a quarter of the screen (#311). The bar grows with them. */
        :root { --tab-fs: min(0.875rem, 6vw); --tabbar: calc(44px + 2.3 * var(--tab-fs) + env(safe-area-inset-bottom)); }
        html { scroll-padding-bottom: calc(var(--tabbar) + 16px); }
        body { padding-bottom: var(--tabbar); }
        header.site .wrap { padding-block: 12px 10px; row-gap: 2px; }
        header.site .brand { gap: 10px; font-size: 1.2rem; }
        .brand-mark { width: 34px; height: 34px; border-radius: 8px; }
        .dateline { font-size: 0.85rem; }
        .dateline .dl-long { display: none; }
        .dateline .dl-short { display: inline; }
        nav.main { position: fixed; z-index: 10; inset: auto 0 0 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0;
          background: var(--card); border-top: 1px solid var(--line); padding: 4px max(4px, env(safe-area-inset-right)) env(safe-area-inset-bottom) max(4px, env(safe-area-inset-left)); }
        nav.main .wide { display: none; }
        nav.main .tab { display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 2px; min-height: 56px; padding: 4px 2px 0; font-size: var(--tab-fs); min-width: 0; overflow-wrap: anywhere; font-weight: 600; line-height: 1.15; text-align: center; text-decoration: none; color: var(--muted); }
        nav.main .icon { display: block; width: 26px; height: 26px; padding: 2px 10px; box-sizing: content-box; border-radius: 999px; }
        nav.main .tab[aria-current] { color: var(--accent); font-weight: 700; }
        nav.main .tab[aria-current] .icon { background: var(--accent-bg); }
        nav.main .tab:focus-visible { outline-offset: -3px; border-radius: 10px; }
      }
      .icon { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex: none; }
      main { padding-block: 24px 48px; }
      h1, h2, h3 { font-family: var(--display); font-weight: 800; text-wrap: balance; }
      h1 { font-size: clamp(1.7rem, 1.35rem + 1.75vw, 1.9rem); line-height: 1.2; margin: 0.4em 0; }
      /* Modern CSS polish (#153): even line breaks, and cards that adapt to their own width */
      p, li, dd, figcaption { text-wrap: pretty; }
      h2 { font-size: 1.35rem; margin-top: 2em; }
      .lede { font-size: 1.15rem; color: var(--muted); }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 16px 18px; margin: 14px 0; }
      .card h3 { margin: 0 0 4px; font-size: 1.1rem; }
      .card.resource > h2, .card.place > h2 { margin: 0 0 4px; font-size: 1.1rem; } /* same look when a card title is an h2 */
      .card-steps { margin: 6px 0 10px; padding-left: 1.4rem; display: grid; gap: 4px; } /* a card's `steps` list (#822) */
      .when { font-weight: 600; color: var(--accent); }
      .meta { font-size: 0.95rem; color: var(--muted); overflow-wrap: anywhere; } /* sources and checked dates: at least 15px (#50) */
      .event h3 { margin-top: 2px; }
      .date-chip { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; margin: 0 0 6px; font-size: 1.25rem; font-weight: 700; line-height: 1.3; color: var(--accent); }
      .date-chip .time { font-size: 1.05rem; }
      .date-chip .rel { font-size: 0.9rem; font-weight: 600; color: var(--muted); }
      /* Buttons wrap as a group; only the main action is full width (#335). See the set layout below (#1073) */
      .actions { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0; }
      .actions > * { min-width: 0; max-width: 100%; flex: 0 1 auto; }
      .btn .nowrap { white-space: normal; }
      main { overflow-wrap: anywhere; }
      /* Table cells never break inside a word, or narrow columns stack one letter per line (#917) */
      main :is(th, td, caption) { overflow-wrap: break-word; }
      /* Wide tables scroll sideways in their own box. Shadows at the edges show there is more (#917) */
      .table-scroll { overflow-x: auto; margin: 16px 0; border: 1px solid var(--line); border-radius: 10px;
        background: linear-gradient(to right, var(--card) 40%, transparent) left / 32px 100% no-repeat local,
          linear-gradient(to left, var(--card) 40%, transparent) right / 32px 100% no-repeat local,
          linear-gradient(to right, rgb(0 0 0 / 0.18), transparent) left / 12px 100% no-repeat scroll,
          linear-gradient(to left, rgb(0 0 0 / 0.18), transparent) right / 12px 100% no-repeat scroll, var(--card); }
      .table-scroll:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
      .table-scroll > table { background: transparent; }
      @media print { .table-scroll { overflow: visible; border: 0; background: none; } }
      .btn { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; padding: 8px 12px; border: 1.5px solid var(--accent); border-radius: 10px;
        background: var(--card); color: var(--accent); font: inherit; font-size: 1rem; font-weight: 600; line-height: 1.25; text-align: center; text-decoration: none; cursor: pointer; }
      .btn:hover { background: var(--accent-bg); }
      /* One set layout for any number of buttons (#1073): the main action is full
         width, the rest share rows two by two, and a button left alone on its row
         grows to the full width. So Call plus Website stacks two full buttons,
         Call plus two more puts the two side by side, and an odd last one spans
         the row. Works when Share turns on later, since hidden buttons take no room.
         A button never shrinks below its label on one line, so when two labels do
         not fit side by side (a narrow phone, large text) they stack instead. */
      .actions > .btn { flex: 1 1 calc(50% - 4px); min-width: -webkit-fit-content; min-width: fit-content; }
      .actions > .btn-primary, .actions > .btn-wide { flex: 1 1 100%; }
      .btn-primary { background: var(--accent); color: var(--card); }
      .btn-primary:hover { background: var(--accent); text-decoration: underline; }
      .btn[hidden] { display: none; }
      .nowrap { white-space: nowrap; }
      .actions .icon { width: 20px; height: 20px; }
      .note { background: var(--accent-bg); border-left: 4px solid var(--brick); border-radius: 4px 10px 10px 4px; padding: 12px 16px; }
      /* No empty band above the first heading in a card or box (#247). */
      .card > :first-child, .note > :first-child { margin-top: 0; }
      /* Saved copy note the offline helper adds to a page (#354). */
      .saved-copy { background: var(--accent-bg); color: var(--fg); border-bottom: 2px solid var(--accent); padding: 12px 16px; font-weight: 600; }
      .saved-copy p { margin: 0 auto; max-width: 44rem; }
      .add-cal { background: var(--accent-bg); border-left: 4px solid var(--brick); border-radius: 4px 10px 10px 4px; padding: 4px 16px 12px; margin: 16px 0; }
      .add-cal h2 { margin-top: 0.6em; }
      .add-cal summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; }
      .add-cal input { width: 100%; min-height: 44px; font: inherit; font-size: 0.9rem; padding: 6px 10px; color: var(--fg); background: var(--card); border: 1px solid var(--line); border-radius: 6px; }
      /* Front Door (#250): Help now bar, doors, season card */
      .front-h { font-size: clamp(1.9rem, 1.5rem + 2vw, 2.6rem); line-height: 1.12; margin: 0.7em 0 0.2em; }
      .right-now { background: var(--accent-bg); border-left: 4px solid var(--brick); border-radius: 4px 12px 12px 4px; padding: 2px 14px 10px; margin-top: 8px; }
      .right-now .rn-h { margin: 0; font-family: var(--display); font-weight: 800; font-size: 1.2rem; }
      .right-now p { margin: 6px 0; }
      .right-now .actions { margin: 6px 0; }
      .right-now .pair .actions, .right-now .actions.pair { display: grid; grid-template-columns: 1fr 1fr; }
      .right-now .pair .btn-primary, .right-now .actions.pair .btn-primary { grid-column: auto; }
      .right-now .rn-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0 12px; }
      .right-now .tonight { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-weight: 700; }
      .right-now .tonight .icon { width: 22px; height: 22px; }
      .right-now .crisis { font-weight: 600; margin: 8px 0 0; font-size: 0.95rem; }
      .crisis-btns { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 5rem), 1fr)); gap: 8px; margin: 6px 0 4px; } /* 3 across, one per row with big text (#971) */
      .crisis-btns .btn { padding: 8px 6px; gap: 6px; }
      .crisis-btns span { white-space: nowrap; }
      .doors h2 { margin-top: 1.1em; }
      .door-list { list-style: none; margin: 12px 0 8px; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); gap: 10px; }
      .door { background: var(--card); border: 2px solid var(--line); border-radius: 12px; padding: 4px 14px 10px; }
      .door:has(.door-name:hover) { border-color: var(--accent); }
      .door-name { display: flex; align-items: center; gap: 10px; min-height: 52px; font-family: var(--display); font-weight: 800; font-size: 1.2rem; line-height: 1.2; text-decoration: none; }
      .door-name:hover span { text-decoration: underline; }
      .door-name .icon { width: 28px; height: 28px; padding: 6px; box-sizing: content-box; border-radius: 999px; background: var(--accent-bg); }
      .door-ex { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 18px; }
      .door-ex a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; }
      .door-hint { margin: 0 0 6px; color: var(--muted); font-size: 0.95rem; line-height: 1.4; }
      .season { border-left: 4px solid var(--brick); margin-top: 24px; }
      .season h2 { margin: 0.1em 0 0.3em; font-size: 1.25rem; }
      .season ul { margin: 6px 0 0; padding-left: 1.2rem; }
      .season li a { display: inline-flex; align-items: center; min-height: 44px; }
      .eyebrow { margin: 4px 0 0; font-size: 0.9rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); }
      .search { display: grid; grid-template-columns: minmax(0, 1fr); gap: 6px; margin: 24px 0 8px; }
      .search label { font-family: var(--display); font-weight: 800; font-size: 1.15rem; }
      .search[hidden] { display: none; }
      .search-row { display: flex; gap: 8px; }
      .search input { flex: 1; min-width: 0; min-height: 52px; padding: 8px 14px; font: inherit; color: var(--fg); background: var(--card); border: 2px solid var(--fg); border-radius: 12px; }
      .search input:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
      .btn-search { flex: none; min-height: 52px; background: var(--accent); color: var(--card); border-radius: 12px; padding: 8px 18px; }
      .btn-search:hover { background: var(--accent); text-decoration: underline; }
      .question .q-step { font-weight: 600; color: var(--muted); margin-bottom: 4px; }
      .choices { list-style: none; margin: 8px 0 16px; padding: 0; display: grid; gap: 10px; }
      .choice { display: grid; gap: 2px; min-height: 64px; padding: 14px 16px; border: 2px solid var(--accent); border-radius: 12px; background: var(--card); color: var(--fg); text-decoration: none; }
      .choice:hover { background: var(--accent-bg); }
      .choice-label { font-family: var(--display); font-weight: 800; font-size: 1.2rem; color: var(--accent); }
      .choice-hint { color: var(--muted); font-size: 0.95rem; }
      .results { list-style: none; margin: 0; padding: 0; }
      .search-status { font-weight: 600; min-height: 1.6em; }
      .search-results { overflow-wrap: anywhere; margin: 8px 0 24px; padding-left: 1.4rem; display: grid; gap: 14px; }
      .search-results a { font-weight: 700; font-size: 1.1rem; }
      .search-results p { margin: 2px 0 0; color: var(--muted); }
      .search-results mark { background: var(--accent-bg); color: var(--fg); font-weight: 600; }
      .crumbs ol { list-style: none; margin: 0 0 4px; padding: 0; display: flex; flex-wrap: wrap; gap: 0 8px; font-size: 0.95rem; line-height: 1.3; }
      .crumbs li { display: flex; align-items: center; gap: 6px; }
      .crumbs li + li::before { content: "›"; color: var(--muted); }
      .crumbs a { display: inline-flex; align-items: center; min-height: 44px; }
      .topic-door { margin-top: 2.2em; }
      .topic-door > p { margin: 0 0 8px; color: var(--muted); }
      .topic-list { margin: 4px 0 16px; padding-left: 1.2rem; display: grid; gap: 6px; }
      .topic-list .hint { display: block; font-size: 0.95rem; color: var(--muted); }
      .topic-list > li > a { display: inline-block; padding-block: 6px; } /* taller tap area for list links (QA) */
      /* Door pages (#235): pick what fits, then steps as mileposts */
      .cant-wait { margin: 12px 0 8px; padding-top: 6px; }
      .cant-wait > p:first-child { font-weight: 600; }
      .cant-wait .crisis-btns { grid-template-columns: repeat(auto-fit, minmax(min(100%, 5.5rem), 1fr)); }
      .door-pick fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
      .pick { list-style: none; margin: 8px 0 12px; padding: 0; display: grid; gap: 8px; }
      .pick label { display: flex; gap: 12px; align-items: center; min-height: 56px; padding: 10px 14px; background: var(--card); border: 2px solid var(--line); border-radius: 12px; cursor: pointer; font-weight: 600; line-height: 1.3; }
      .pick input { width: 24px; height: 24px; flex: none; accent-color: var(--accent); margin: 0; }
      .pick label:has(input:checked) { border-color: var(--accent); background: var(--accent-bg); }
      .pick label:has(input:focus-visible) { outline: 3px solid var(--accent); outline-offset: 2px; }
      .door-plan h2:focus { outline: none; }
      .step-group h3 { margin: 1.4em 0 0.4em; }
      .steps { list-style: none; margin: 0; padding: 0 0 0 18px; border-left: 3px solid var(--ridge); display: grid; gap: 14px; }
      .step { position: relative; background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 12px 16px; }
      .step::before { content: ""; position: absolute; left: -27px; top: 18px; width: 12px; height: 12px; border-radius: 999px; background: var(--accent); border: 3px solid var(--bg); }
      .step > p:first-child { margin: 0 0 4px; font-weight: 600; }
      .step-cost { margin: 4px 0; font-size: 0.95rem; }
      .keep-steps { margin-top: 18px; }
      /* Trailhead routes (#240): numbered mileposts on a rail, each a <details> */
      .route { list-style: none; margin: 20px 0 20px 14px; padding: 0 0 0 22px; border-left: 3px solid var(--ridge); display: grid; gap: 12px; }
      .milepost { position: relative; }
      .milepost details { background: var(--card); border: 1px solid var(--line); border-radius: 10px; }
      .milepost summary { display: block; cursor: pointer; list-style: none; padding: 10px 44px 10px 14px; position: relative; border-radius: 10px; }
      .milepost summary::-webkit-details-marker { display: none; }
      .milepost summary::after { content: ""; position: absolute; right: 18px; top: 50%; width: 9px; height: 9px; margin-top: -7px; border: solid var(--accent); border-width: 0 2.5px 2.5px 0; transform: rotate(45deg); }
      .milepost details[open] > summary::after { transform: rotate(-135deg); margin-top: -2px; }
      .milepost summary:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
      .milepost summary h2 { display: flex; align-items: center; gap: 12px; min-height: 40px; margin: 0; font-size: 1.2rem; line-height: 1.25; color: var(--accent); }
      .milepost summary:hover h2 .mp-title { text-decoration: underline; }
      .mp-num { position: absolute; left: -39px; top: 14px; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 999px; background: var(--accent); color: var(--card); border: 3px solid var(--bg); font-size: 0.95rem; }
      .mp-when { display: block; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; font-size: 0.9rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); }
      .mp-body { padding: 0 14px 6px; border-top: 1px solid var(--line); }
      .mp-body > :first-child { margin-top: 12px; }
      /* Long pages (#1174): an "On this page" jump list near the top, and
         secondary sections folded into a native <details> that opens with no
         script, opens on find-in-page, and opens when a link points inside it. */
      .on-page { margin: 12px 0 16px; }
      .on-page p { margin: 0; font-weight: 600; }
      .on-page ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 16px; }
      .on-page a, .link-row a { display: inline-flex; align-items: center; min-height: 44px; }
      .link-row { margin: 12px 0 16px; }
      .link-row h2 { font-size: 1.1rem; margin: 0; }
      .link-row ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 16px; }
      details.fold { margin: 20px 0; border: 1px solid var(--line); border-radius: 10px; background: var(--card); }
      details.fold > summary { cursor: pointer; list-style: none; padding: 8px 44px 8px 14px; position: relative; border-radius: 10px; min-height: 44px; display: flex; align-items: center; }
      details.fold > summary::-webkit-details-marker { display: none; }
      details.fold > summary::after { content: ""; position: absolute; right: 18px; top: 50%; width: 9px; height: 9px; margin-top: -7px; border: solid var(--accent); border-width: 0 2.5px 2.5px 0; transform: rotate(45deg); }
      details.fold[open] > summary::after { transform: rotate(-135deg); margin-top: -2px; }
      details.fold > summary:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
      details.fold > summary :is(h2, h3, h4) { margin: 0; color: var(--accent); }
      details.fold > summary .fold-hint { display: block; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; font-size: 0.95rem; font-weight: 400; color: var(--muted); }
      .fold-body { padding: 0 14px 8px; border-top: 1px solid var(--line); }
      @media print {
        header.site, nav.main, footer.site, .skip, .crisis-strip, .crumbs, .door-pick, .sit-links, .keep-steps, .cant-wait .crisis-btns { display: none !important; }
        body { padding: 0; background: #fff; color: #000; }
        .step, .milepost { break-inside: avoid; }
        /* Closed route steps print too, even with scripts off (#368). */
        .milepost details::details-content, details.fold::details-content { content-visibility: visible; display: block; }
        .milepost summary::after, details.fold > summary::after { display: none; }
      }
      /* Crisis strip and quick exit (#174), on safety pages only */
      .crisis-strip { position: sticky; top: 0; z-index: 15; background: var(--accent-bg); border-bottom: 2px solid var(--brick); }
      /* Compact (#420): one short row on a phone, numbers left, Quick exit right. */
      .crisis-strip .wrap { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; padding-block: 2px; }
      .crisis-strip p { flex: 1 1 9rem; min-width: 0; margin: 0; font-size: 0.95rem; line-height: 1.35; font-weight: 600; }
      .crisis-strip p a { font-weight: 800; padding: 6px 2px; }
      .qe-group { display: inline-flex; align-items: center; gap: 2px 8px; flex-wrap: wrap; justify-content: flex-end; }
      .qe-what { display: inline-flex; align-items: center; min-height: 44px; font-size: 0.85rem; }
      .quick-exit { flex: 0 1 auto; min-width: 0; text-align: center; overflow-wrap: anywhere; display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; border-radius: 10px; background: var(--fg); color: var(--bg); font-weight: 700; text-decoration: none; }
      .quick-exit:hover { text-decoration: underline; }
      .crisis-line { margin: 0 0 12px; padding: 6px 12px; border-left: 4px solid var(--brick); background: var(--accent-bg); font-weight: 600; }
      .crisis-line a { font-weight: 800; padding: 6px 2px; }
      html:has(.crisis-strip) { scroll-padding-top: 8rem; }
      /* overflow-wrap: the long fix@ email address wraps at 320px */
      footer.site { border-top: 2px solid var(--brick); font-size: 0.9rem; color: var(--muted); padding-block: 20px 40px; overflow-wrap: anywhere; }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    {crisis && <CrisisStrip />}
    <header class="site">
      <div class="wrap">
        <a class="brand" href={`${base}/`}><Fragment set:html={brandMark} /><span>Everything Morgantown</span></a>
        <p class="dateline">Morgantown <span aria-hidden="true">·</span> <span class="dl-long" data-fmt="long">{longToday}</span><span class="dl-short" data-fmt="short">{shortToday}</span>{forecast && <span id="dl-wx" data-day={forecast.day}> <span aria-hidden="true">·</span> <a href={FORECAST_PAGE}><Icon name={forecast.icon} />{forecast.text}<span class="sr-only"> (National Weather Service forecast)</span></a></span>}</p>
        <nav class="main" aria-label="Main">
          {tabs.map((t) => <a class="tab" href={`${base}${t.href}`} aria-current={t.current}><Icon name={t.icon} /><span>{t.label}</span></a>)}
          {wide.map((w) => <a class="wide" href={`${base}${w.href}`} aria-current={w.current}>{w.label}</a>)}
        </nav>
      </div>
    </header>
    <main class="wrap" id="main" tabindex="-1" data-pagefind-body={searchable ? '' : undefined}>
      <UpkeepNotice />
      <Breadcrumb route={route} />
      {help && !crisis && <CrisisLine />}
      {searchable && tagDoor && <p hidden data-pagefind-filter="door">{tagDoor.name}</p>}
      {searchable && tagTopic && <p hidden data-pagefind-filter="topic">{tagTopic}</p>}
      {(crisis || tags?.door === 'help-now') && <p class="disclaimer meta">{disclaimer}</p>}
      <slot />
      {searchable && <AlsoCalled route={route} />}
      {crisis && <LeaveNote />}
      {shareable && <ShareThis label={tags.label} summary={tags.summary} route={route} />}
      <AlsoCheck route={route} />
    </main>
    <footer class="site">
      <div class="wrap">
        <nav class="foot-links" aria-label="Doors and site">
          <ul>{footerLinks.map((n) => <li><a href={`${base}${n.href}`}>{n.label}</a></li>)}</ul>
        </nav>
        <p class="disclaimer">{disclaimer}</p>
        <p class="not-official"><strong>An independent community guide, not a government site.</strong> It is not run by the City of Morgantown, Monongalia County or the State of West Virginia, or by the groups it lists. For official business, use the links to each office's own site. Sources marked "government site" are on a .gov address.</p>
        <p>An open experiment for Morgantown and Monongalia County, WV. Most of it is researched and written by AI (Claude), and a person oversees it (<a href={`${base}/about/`}>how we use AI</a>). Every item links to its source and says when we last checked it. Something wrong or missing? Use our <a href={fixFormUrl({ page: Astro.url.pathname })}>fix or removal form</a> or email <a href={`mailto:${FIX_EMAIL}`}>{FIX_EMAIL}</a>. You don't need an account, and what you send stays private.</p>
      </div>
    </footer>
    <div class="sr-only" role="status" id="announce"></div>
    <script is:inline>
      // Small and optional: the page works without it.
      // 1. Keep "in 3 days" labels right between daily rebuilds (Eastern time).
      (function () {
        var today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/New_York' }).format(new Date());
        var days = function (a, b) { return Math.round((Date.parse(b + 'T12:00:00Z') - Date.parse(a + 'T12:00:00Z')) / 864e5); };
        var inDays = function (n) { return n === 1 ? 'tomorrow' : 'in ' + n + ' days'; };
        document.querySelectorAll('.rel[data-starts]').forEach(function (el) {
          var s = el.dataset.starts, e = el.dataset.ends;
          el.textContent = s > today ? inDays(days(today, s)) : e < today ? 'over' : s === e ? 'today' : e === today ? 'last day is today' : 'open now, ends ' + inDays(days(today, e));
        });
        // Print every step of a Trailhead route and every folded section, open or closed (#240, #1174).
        window.addEventListener('beforeprint', function () {
          document.querySelectorAll('.milepost details, details.fold').forEach(function (d) { d.open = true; });
        });
        // A link to a spot inside a folded section (#1174) opens it first.
        var openFold = function () {
          var id = decodeURIComponent(location.hash.slice(1));
          var el = id && document.getElementById(id);
          var d = el && el.closest('details.fold');
          if (d && !d.open) { d.open = true; el.scrollIntoView({ block: 'start' }); }
        };
        openFold();
        window.addEventListener('hashchange', openFold);
        // Dateline: today's date, and hide a forecast from an earlier day.
        document.querySelectorAll('.dateline [data-fmt]').forEach(function (el) {
          var f = el.dataset.fmt;
          el.textContent = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', weekday: f, month: f, day: 'numeric' }).format(new Date());
        });
        var wx = document.getElementById('dl-wx');
        if (wx && wx.dataset.day !== today) wx.hidden = true;
        // 2. Share: the phone's share sheet when there is one, otherwise copy the link.
        var say = function (t) { var a = document.getElementById('announce'); a.textContent = ''; setTimeout(function () { a.textContent = t; }, 50); };
        document.querySelectorAll('button.share').forEach(function (b) {
          if (!navigator.share && !(navigator.clipboard && window.isSecureContext)) return;
          if (!navigator.share) b.querySelector('.label').textContent = 'Copy link';
          b.hidden = false;
          b.addEventListener('click', function () {
            if (navigator.share) { navigator.share({ title: b.dataset.title, url: b.dataset.url }).catch(function () {}); return; }
            navigator.clipboard.writeText(b.dataset.url).then(function () { say('Link copied'); });
          });
        });
      })();
    </script>
  </body>
</html>
