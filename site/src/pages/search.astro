---
// Search runs on the phone with Pagefind: the index is built with the site.
// The search box puts the words after "#" (never sent to the host). An old
// ?q= link still works. Without scripts, the page lists every need instead.
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.astro';
import DoorCards from '../components/DoorCards.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base searchable={false} title="Search Mon County help" description="Search plain-language help pages for Morgantown and Monongalia County, WV. The search runs on your phone, and we never collect what you search for.">
  <h1>Search</h1>
  <SearchBox id="search-q" />
  <p id="search-status" class="search-status" role="status" aria-live="polite"></p>
  <ol id="search-results" class="search-results" hidden></ol>
  <noscript><p>Search needs JavaScript, which is off on this browser. Pick what is going on below, see <a href={`${base}/topics/`}>all topics</a>, or call or text 211.</p></noscript>
  <DoorCards heading="Or pick what is going on" id="browse" />
  <p class="meta">The search runs on your phone. Your words are never sent to us or to the site’s host, and we never store them. Like any visit, the host can see which files your phone loads, including the search files for the pages that match.</p>
  <script is:inline define:vars={{ base }}>
    (function () {
      var input = document.getElementById('search-q');
      var status = document.getElementById('search-status');
      var list = document.getElementById('search-results');
      var pagefind;
      function current() {
        var h = location.hash.match(/^#q=(.*)$/);
        if (h) { try { return decodeURIComponent(h[1].replace(/\+/g, ' ')); } catch (e) { return ''; } }
        return new URLSearchParams(location.search).get('q') || '';
      }
      function load() {
        pagefind = pagefind || import(base + '/pagefind/pagefind.js').then(function (pf) { pf.options({ baseUrl: base + '/' }); return pf; });
        return pagefind;
      }
      // Words people type that our pages say another way, and words that only
      // get in the way. Found in simulated walkthroughs (docs/reviews/2026-10-31-simulated-walkthroughs.md).
      // Pagefind only returns pages with every word, so "detox near me" found nothing.
      var SAME = { garbage: 'trash', rubbish: 'trash', daycare: 'child care', childcare: 'child care', babysitter: 'child care', babysitting: 'child care',
        rehab: 'treatment', detox: 'treatment', senior: 'older', seniors: 'older', elderly: 'older', toothache: 'dentist', tooth: 'dentist', teeth: 'dentist', dental: 'dentist',
        suicidal: 'suicide', vaccine: 'shot', vaccines: 'shots', vaccination: 'shots', ebt: 'snap', lawyer: 'legal', attorney: 'legal',
        obamacare: 'marketplace', groceries: 'food', grocery: 'food', homeless: 'shelter', evicted: 'eviction', evict: 'eviction' };
      var FILLER = ('a an the and or of to for in on at by from with about my me i im we our you your it its this that is are was be ' +
        'can cant do does dont how what where when who why get got need want please help near find someone some any just really ' +
        'morgantown wv west virginia mon monongalia county').split(' ');
      function words(q) {
        return q.toLowerCase().replace(/[’']/g, '').replace(/\bday care\b/g, 'daycare').match(/[a-z0-9]+/g) || [];
      }
      function plain(q) {
        return words(q).filter(function (w) { return FILLER.indexOf(w) < 0; }).map(function (w) { return SAME[w] || w; }).join(' ');
      }
      // Help-giver and printout pages repeat what the main pages say, so they go last.
      function later(url) { return /\/(print|for\/helpers)\//.test(url) ? 1 : 0; }
      // Pages with more of the reader's words come first. Pagefind's own order
      // breaks ties, and a word a page has near the top of its results counts a bit more.
      function find(pf, q) {
        // Each word the reader typed, with the word our pages use for it.
        var units = words(q).filter(function (w, i, a) { return FILLER.indexOf(w) < 0 && a.indexOf(w) === i; })
          .map(function (w) { return SAME[w] ? [w, SAME[w]] : [w]; });
        var p = plain(q);
        var jobs = [{ q: q }];
        if (p && p !== q.toLowerCase().trim()) jobs.push({ q: p });
        if (units.length > 1 || (units[0] && units[0].length > 1)) {
          units.forEach(function (alts, u) { alts.forEach(function (w) { jobs.push({ q: w, unit: u }); }); });
        }
        return Promise.all(jobs.map(function (j) { return pf.search(j.q); })).then(function (all) {
          var score = {}, has = {}, byId = {};
          all.forEach(function (res, k) {
            var unit = jobs[k].unit;
            res.results.forEach(function (r, i) {
              byId[r.id] = r;
              var near = 1 / (1 + i / 10);
              if (unit === undefined) { score[r.id] = (score[r.id] || 0) + near; return; }
              has[r.id] = has[r.id] || {};
              var best = has[r.id][unit] || 0;
              if (1 + near / 2 > best) { score[r.id] = (score[r.id] || 0) + 1 + near / 2 - best; has[r.id][unit] = 1 + near / 2; }
            });
          });
          var ids = Object.keys(byId).sort(function (x, y) { return score[y] - score[x]; });
          var some = units.length > 1 && !ids.some(function (id) { return has[id] && Object.keys(has[id]).length === units.length; });
          return Promise.all(ids.slice(0, 20).map(function (id) { return byId[id].data(); })).then(function (items) {
            items = items.map(function (d, i) { return { d: d, i: i }; })
              .sort(function (x, y) { return later(x.d.url) - later(y.d.url) || x.i - y.i; })
              .map(function (x) { return x.d; }).slice(0, 10);
            return { items: items, some: some };
          });
        });
      }
      function run(q) {
        input.value = q;
        list.hidden = true; list.innerHTML = '';
        if (!q.trim()) { status.textContent = ''; return; }
        status.textContent = 'Searching…';
        load().then(function (pf) { return find(pf, q); }).then(function (found) {
          var items = found.items;
          if (!items.length) {
            status.textContent = 'No pages match "' + q + '". Try fewer words, pick from the list below, or call or text 211.';
            return;
          }
          items.forEach(function (d) {
            var li = document.createElement('li');
            var a = document.createElement('a');
            a.href = d.url; a.textContent = (d.meta && d.meta.title) || d.url;
            var p = document.createElement('p');
            p.innerHTML = d.excerpt; // Pagefind escapes page text and marks matches with <mark>.
            li.append(a, p); list.append(li);
          });
          list.hidden = false;
          status.textContent = found.some
            ? 'No page has all of "' + q + '". These pages have some of your words.'
            : items.length + (items.length === 1 ? ' page matches "' : ' pages match "') + q + '".';
        }).catch(function () {
          status.textContent = 'Search could not load. Pick from the list below, or call or text 211.';
        });
      }
      window.addEventListener('hashchange', function () { run(current()); });
      run(current());
    })();
  </script>
</Base>
