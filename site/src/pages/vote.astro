---
// Register to vote and find your polling place (#625, part of #270).
// Nonpartisan and official sources only (charter): the WV Secretary of State,
// the Monongalia County Clerk and the City of Morgantown. Facts come from the
// resource records. The next registration deadline goes on /calendar/ only
// once the state posts it.
import Base from '../layouts/Base.astro';
import ResourceCard from '../components/ResourceCard.astro';
import PlaceCard from '../components/PlaceCard.astro';
import { loadDir } from '../lib/content.mjs';
import { fixFormUrl } from '../lib/group-requests.mjs';
export const page = { door: "living-here", topic: "voting", label: "Register to vote and find your polling place", summary: "Register or update online or at the County Clerk, check your registration, find your polling place, and city elections" };
const all = loadDir('resources');
const r = (slug) => all.find((e) => e.slug === slug);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// The 2026 general election (#970). Shown through Election Day, by the date in
// Morgantown when the site was built; the daily build hides it after that.
const today = new Date().toLocaleDateString('en-CA', { timeZone: 'America/New_York' });
const electionWeek = today <= '2026-11-03';
const earlyVotingOpen = today <= '2026-10-31';
---
<Base title="Register to vote and find your polling place in Mon County" description="How to register to vote or update your registration in Morgantown and Monongalia County, WV: the Secretary of State's online registration, the Monongalia County Clerk's office, checking your registration, finding your polling place, and Morgantown city elections.">
  <h1>Register to vote and find your polling place</h1>
  <p class="lede">These are the official places to register, check your registration and find where you vote. They come from the West Virginia Secretary of State, the Monongalia County Clerk and the City of Morgantown.</p>

  {electionWeek && (
    <section id="election-2026" aria-labelledby="election-2026-h">
      <h2 id="election-2026-h">Election Day is Tuesday, November 3</h2>
      <p>Polls are open from 6:30 a.m. to 7:30 p.m. Bring a valid photo ID. The deadline to register for this election has passed, so check that you are registered and find your polling place below.</p>
      {earlyVotingOpen && r('mon-county-early-voting-2026') && <ResourceCard r={r('mon-county-early-voting-2026')} />}
      {r('mon-county-polling-places-2026') && <ResourceCard r={r('mon-county-polling-places-2026')} />}
      {r('wv-voter-id') && <ResourceCard r={r('wv-voter-id')} />}
      {r('mon-county-absentee-ballot-2026') && <ResourceCard r={r('mon-county-absentee-ballot-2026')} />}
    </section>
  )}

  <h2 id="register">Register or update your registration</h2>
  {r('wv-online-voter-registration') && <ResourceCard r={r('wv-online-voter-registration')} />}
  {r('mon-county-clerk-voter-registration') && <PlaceCard r={r('mon-county-clerk-voter-registration')} />}

  <h2 id="polling-place">Check your registration and find where you vote</h2>
  {r('wv-find-polling-place') && <ResourceCard r={r('wv-find-polling-place')} />}

  <h2 id="city">Morgantown city elections</h2>
  {r('morgantown-city-voter-information') && <ResourceCard r={r('morgantown-city-voter-information')} />}

  <p>Election days and deadlines we have confirmed are on <a href={`${base}/calendar/`}>Dates</a>.</p>

  <p class="meta">Sources checked October 30 and 31, 2026. We list only official election offices. Something out of date? <a href={fixFormUrl({ page: Astro.url.pathname })}>Tell us</a>.</p>
</Base>
