---
// Register to vote and find your polling place (#625, part of #270).
// Nonpartisan and official sources only (charter): the WV Secretary of State,
// the Monongalia County Clerk and the City of Morgantown. Facts come from the
// resource records. The next registration deadline goes on /calendar/ only
// once the state posts it.
import Base from '../layouts/Base.astro';
import ResourceCard from '../components/ResourceCard.astro';
import SourceLine from '../components/SourceLine.astro';
import PlaceCard from '../components/PlaceCard.astro';
import { loadDir } from '../lib/content.mjs';
import { fixFormUrl } from '../lib/group-requests.mjs';
import { currentElection, longDate } from '../lib/elections.mjs';
export const page = { door: "living-here", topic: "voting", label: "Register to vote and find your polling place", summary: "Register or update online or at the County Clerk, check your registration, find your polling place, city elections, and working at the polls" };
const all = loadDir('resources');
const r = (slug) => all.find((e) => e.slug === slug);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// The election that is coming up or just happened (#970, #1365), from
// content/elections/. Before Election Day it shows what to know to vote; after,
// the official results link and the canvass date. The daily build moves it.
const election = currentElection();
---
<Base title="Register to vote and find your polling place in Mon County" description="Register to vote or update your registration in Morgantown and Monongalia County, WV, check your registration, and find your polling place.">
  <h1>Register to vote and find your polling place</h1>
  <p class="lede">Use these official links to register to vote, check that you are registered and find where you vote. They come from the West Virginia Secretary of State, the Mon County Clerk and the City of Morgantown.</p>

  {election?.phase === 'before' && (
    <section id="election" aria-labelledby="election-h" data-election-day={election.election_day} data-polls-close={election.polls_close}>
      <h2 id="election-h">Election Day is {longDate(election.election_day)}</h2>
      <p>Polls are open from {election.polls.replace(/\.$/, '')}. Bring a valid photo ID.{election.registrationClosed && ' The deadline to register for this election has passed, so check that you are registered and find your polling place below.'}</p>
      {election.earlyVotingOpen && r(election.early_voting.resource) && <ResourceCard r={r(election.early_voting.resource)} />}
      {election.before.map((slug) => r(slug) && <ResourceCard r={r(slug)} />)}
      <h3>Need help voting?</h3>
      <p>The Secretary of State says every polling place in West Virginia has at least one voting machine that meets the Americans with Disabilities Act. You can get help marking your ballot if you are blind, have a disability, are of advanced age, or cannot read or write. If you qualify for help and cannot get into the polling place because it is not accessible, you may be able to vote from your car outside, as a last resort. Ask a poll worker, or call the County Clerk at <a href="tel:3042917230">304-291-7230</a>.</p>
      <SourceLine sources={[{ url: 'https://sos.wv.gov/voters-disabilities', checked: '2026-11-02', name: 'WV Secretary of State, Voters with Disabilities' }]} about="help voting" />
    </section>
  )}
  {election && (
    <section id={election.phase === 'after' ? 'election' : 'election-results'} aria-labelledby="results-h" hidden={election.phase !== 'after'}>
      <h2 id="results-h">Results of the {election.name} on {longDate(election.election_day)}</h2>
      <p>Polls are closed. The West Virginia Secretary of State posts results on its official results page. The Monongalia County Clerk runs the election in the county and keeps an election page. The county canvass, when the county's official count starts, is on {longDate(election.canvass)}.</p>
      <div class="actions">
        <a class="btn" href={election.results_url}>Official election results</a>
        <a class="btn" href="https://monongaliacountyclerk.com/index.php/elections/17-current-election/124-2026-general-election-information">County Clerk election page</a>
      </div>
      <p>Voted a provisional ballot? <a href="https://apps.sos.wv.gov/Elections/Voter/ProvisionalBallotSearch">Track your provisional ballot</a> on the Secretary of State's site.</p>
      <SourceLine sources={election.sources} about={`the ${election.name}`} />
    </section>
  )}
  {election?.phase === 'before' && election.polls_close && (
    // On Election Day the page was built that morning. When polls close, show
    // the results part instead, by Morgantown time. Without script, the
    // "before" part stays, and it states the closing time.
    <script is:inline>
      (() => {
        const before = document.getElementById('election');
        const after = document.getElementById('election-results');
        if (!before || !after) return;
        const day = before.dataset.electionDay, close = before.dataset.pollsClose;
        const parts = Object.fromEntries(new Intl.DateTimeFormat('en-CA', { timeZone: 'America/New_York', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date()).map((p) => [p.type, p.value]));
        const today = `${parts.year}-${parts.month}-${parts.day}`, now = `${parts.hour}:${parts.minute}`;
        if (today > day || (today === day && now >= close)) {
          before.hidden = true; before.id = 'election-before';
          after.hidden = false; after.id = 'election';
        }
      })();
    </script>
  )}

  <h2 id="register">Register or update your registration</h2>
  {r('wv-online-voter-registration') && <ResourceCard r={r('wv-online-voter-registration')} />}
  {r('mon-county-clerk-voter-registration') && <PlaceCard r={r('mon-county-clerk-voter-registration')} />}

  <h2 id="polling-place">Check your registration and find where you vote</h2>
  {r('wv-find-polling-place') && <ResourceCard r={r('wv-find-polling-place')} />}

  <h2 id="city">Morgantown city elections</h2>
  {r('morgantown-city-voter-information') && <ResourceCard r={r('morgantown-city-voter-information')} />}

  <h2 id="poll-worker">Work at the polls</h2>
  <p>Poll workers run the polls on Election Day. People registered to vote in the county can sign up, and some high school juniors and seniors can too. The work is the same for every party and candidate.</p>
  {r('wv-poll-worker') && <ResourceCard r={r('wv-poll-worker')} />}

  <p>Election days and deadlines we have confirmed are on <a href={`${base}/calendar/`}>Dates</a>.</p>

  <p class="meta">Sources checked October 30 to November 2, 2026. We list only official election offices. Something out of date? <a href={fixFormUrl({ page: Astro.url.pathname })}>Tell us</a>.</p>
</Base>
