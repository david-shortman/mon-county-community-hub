---
// Get weather and emergency alerts, official sources only (#510). We never
// send alerts ourselves (charter); this page points to official sign-ups.
// Not here yet: a county mass notification sign-up (none found on a public
// page), who can sign up for WVU Alert, and Monongalia County Schools'
// own closing notices (#727).
import Base from '../layouts/Base.astro';
import BigChoices from '../components/BigChoices.astro';
import OnThisPage from '../components/OnThisPage.astro';
import SourceLine from '../components/SourceLine.astro';
import Fact from '../components/Fact.astro';
import { factsFor } from '../lib/facts.mjs';
import Icon from '../components/Icon.astro';
import { fixFormUrl } from '../lib/group-requests.mjs';
export const page = { door: "living-here", topic: "weather", label: "Get weather and emergency alerts", summary: "Phone alerts, the National Weather Service, city alerts, WVU Alert, road conditions, school closings and power outage texts" };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Most sections are fact records in content/facts/alerts/ (#122), each with
// the source's own words and its own checked date. Schools and power outage
// texts stay typed for now: those pages load their text by script or ask
// robots not to read them, so a person re-reads them.
const fact = factsFor('alerts');
const checked = '2026-10-30';
const schools = [{ url: 'https://wveis.k12.wv.us/closings/', checked }, { url: 'https://boe.mono.k12.wv.us/page/closings/', checked: '2026-11-01' }];
const power = [{ url: 'https://www.firstenergycorp.com/outages_help/outage_help/outage_notifications.html', checked }];
---
<Base title="Get weather and emergency alerts in Morgantown and Mon County" description="Official weather and emergency alerts in Mon County, WV: phone alerts, the National Weather Service, city alerts, WVU Alert, WV 511, school closings and outages.">
  <h1>Get weather and emergency alerts</h1>
  <p class="lede">These are the official places that send warnings for Mon County. Most are free. We do not send alerts ourselves.</p>
  {/* Lead block (#199): the four alerts most people look for. */}
  <BigChoices label="Alerts: start here" choices={[
    { href: '#phone', label: 'Alerts on my phone', icon: 'phone' },
    { href: '#weather', label: 'Weather warnings', icon: 'info' },
    { href: '#schools', label: 'School closings', icon: 'calendar' },
    { href: '#power', label: 'Power outage texts', icon: 'bulb' },
  ]} />
  <OnThisPage items={[['#city', 'City of Morgantown alerts'], ['#county', 'Monongalia County alerts'], ['#wvu', 'WVU students and staff'], ['#roads', 'Roads and closures']]} />

  <h2 id="phone">On your phone, with no sign-up</h2>
  <Fact f={fact('phone-alerts')} about="Wireless Emergency Alerts" />

  <h2 id="weather">Weather warnings</h2>
  <Fact f={fact('weather-office')} about="the National Weather Service" />
  <div class="actions">
    <a class="btn" href="https://forecast.weather.gov/MapClick.php?zoneid=WVZ509"><Icon name="open" /><span>Mon County forecast and warnings</span></a>
  </div>
  <Fact f={fact('weather-radio')} about="NOAA Weather Radio" />

  <h2 id="city">City of Morgantown alerts</h2>
  <Fact f={fact('city-notify-me')} about="City of Morgantown Notify Me" />
  <div class="actions">
    <a class="btn" href="https://www.morgantownwv.gov/list.aspx"><Icon name="open" /><span>Sign up for city alerts</span></a>
  </div>

  <h2 id="county">Monongalia County alerts</h2>
  <Fact f={fact('county-alerts')} about="the county emergency plan" />

  <h2 id="wvu">WVU students and staff</h2>
  <Fact f={fact('wvu-alert')} about="WVU Alert" />
  <div class="actions">
    <a class="btn" href="https://emergency.wvu.edu/"><Icon name="open" /><span>WVU emergency site and sign-up</span></a>
  </div>

  <h2 id="roads">Roads and closures</h2>
  <Fact f={fact('wv-511')} about="WV 511" />
  <div class="actions">
    <a class="btn" href="https://www.wv511.org/personalAlerts/newUser.aspx"><Icon name="open" /><span>Sign up for WV 511 alerts</span></a>
  </div>

  <h2 id="schools">School closings and delays</h2>
  <p>The West Virginia Department of Education has a statewide School Closings and Delays page. County board offices post their own announcements there. Monongalia County Schools says families get an email, text message and voice message about school closings, and that closings are also posted on its websites and its Facebook and Twitter (X) accounts.</p>
  <SourceLine sources={schools} about="school closings" />
  <div class="actions">
    <a class="btn" href="https://wveis.k12.wv.us/closings/"><Icon name="open" /><span>School closings and delays</span></a>
  </div>

  <h2 id="power">Power outage texts</h2>
  <p>FirstEnergy, the company Mon Power is part of, sends outage text alerts. Text REG to 544487 (LIGHTS) to sign up. Have your account number and ZIP code ready. Message and data rates may apply.</p>
  <SourceLine sources={power} about="outage text alerts" />
  <div class="actions">
    <a class="btn" href="sms:544487?&body=REG"><Icon name="text" /><span>Text REG to 544487</span></a>
  </div>

  <p>Storm already hit? See <a href={`${base}/after-a-storm/`}>Storm damage, flooding or power out?</a></p>
  <p>Want to know your flood risk before a storm? See <a href={`${base}/flood-zone/`}>Is my home in a flood zone or a slide area?</a></p>
  <p class="meta">Each section shows when we last checked its source. We point to official alert services and do not run any of them. Know an official alert service we missed? <a href={fixFormUrl({ page: Astro.url.pathname })}>Tell us</a>.</p>
</Base>
