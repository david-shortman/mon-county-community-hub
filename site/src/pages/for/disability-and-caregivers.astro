---
// Starting page for people with disabilities and caregivers (#268, epic
// #261). Links only; research and gaps: docs/groups/disability-caregivers.md.
import Base from '../../layouts/Base.astro';
import GroupStart from '../../components/GroupStart.astro';
export const page = { door: "family", topic: "disability", label: "People with disabilities and caregivers", summary: "Living on your own terms, care at home, job help, and health costs, in one place" };
const sections = [
  { title: 'Living on your own terms', links: [
    { href: '/disability-and-aging/', text: 'independent living help, job help, and Medicare help' },
    { href: '/disability-and-aging/#wvats-device-loans', label: 'Try or borrow a device', text: 'free demos, 30-day loans and free used devices from WVATS' },
    { href: '/disability-and-aging/#drwv-intake', label: 'Know your rights', text: 'free, confidential help from Disability Rights of WV' },
  ] },
  { title: 'Care at home', links: [
    { href: '/medicaid-waivers/', text: 'care at home instead of a nursing home or facility, through Medicaid' },
  ] },
  { title: 'Work', links: [
    { href: '/work-and-learning/', text: 'job help and training' },
  ] },
  { title: 'Health costs', links: [
    { href: '/turning-65/', text: 'Medicare sign-up and help with costs' },
    { href: '/dental-and-prescriptions/', text: 'a dentist without dental insurance, and help paying for medicine' },
  ] },
  { title: 'Children and school', links: [
    { href: '/family/?pick=baby-growth', label: 'Worried about how your baby or toddler is growing', text: 'who to call for children under 3' },
    { href: '/disability-and-aging/#mcs-special-education', label: 'Special education', text: 'who to call at Monongalia County Schools' },
  ] },
  { title: 'Sports and fun', links: [
    { href: '/disability-and-aging/#steppingstones-recreation', label: 'Recreation and Special Olympics', text: 'SteppingStones at Mylan Park, and how to join Special Olympics' },
  ] },
  { title: 'If you are a caregiver', links: [
    { href: '/disability-and-aging/#alz-wv-caregiver-groups', label: 'Dementia caregiver support', text: 'free support groups and a 24/7 Helpline' },
    { href: '/help-at-home/', text: 'in-home care, meals at home, and FAIR respite for dementia caregivers' },
  ] },
  { title: 'Bills and food', links: [
    { href: '/utility-bills/', text: 'help with a heat, water or electric bill' },
    { href: '/help/food/', text: 'food today or this week, or help buying groceries every month' },
  ] },
];
---
<Base title="People with disabilities and caregivers in Morgantown and Mon County: where to start" description="A starting page for people with disabilities and the people who care for them in Monongalia County: independent living, care at home through Medicaid, job help, health costs, and bill and food help.">
  <h1>For people with disabilities and caregivers</h1>
  <p class="lede">Pick what you need. Each link goes to a page with local phone numbers and where we found them.</p>
  <GroupStart sections={sections} />
</Base>
