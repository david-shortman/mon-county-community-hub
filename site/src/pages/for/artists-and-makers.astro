  { title: "Space and tools", links: [
    { href: "/arts-and-making/#space", label: "Maker space and studios", text: "a shared maker space and studios" },
    { href: "/borrow-or-get-free/#borrow", label: "Borrow tools", text: "tool and library lending" },
  ] },
  { title: "Show and sell your work", links: [
    { href: "/arts-and-making/#show", label: "Show your work", text: "gallery shows" },
    { href: "/markets/", text: "craft markets and yearly sales" },
  ] },
  { title: "Traditional arts", links: [
    { href: "/arts-and-making/#traditional", label: "Folk arts", text: "learning a traditional art" },
  ] },
  { title: "Play, make or meet with others", links: [
    { href: "/find-your-people/", text: "groups, clubs and dances" },
    { href: "/meet-people/", text: "free library programs for adults" },
  ] },
  { title: "Money for your work", links: [
    { href: "/arts-and-making/#grants", label: "Grants for artists", text: "grants for artists and arts groups" },
    { href: "/make-it-better/grants/", text: "small grants for art and neighborhood projects" },
    { href: "/business/", text: "free business coaching if you sell your work" },
