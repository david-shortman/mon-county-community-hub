export const page = { door: "community", topic: "community", label: "Artists, makers and musicians", summary: "Classes, space and tools, showing and selling your work, folk arts, groups and grants, in one place" };
const sections = [
  { title: "Take a class", links: [
    { href: "/arts-and-making/#classes", label: "Art classes", text: "art and craft classes" },
    { href: "/work-and-learning/", text: "adult classes" },
