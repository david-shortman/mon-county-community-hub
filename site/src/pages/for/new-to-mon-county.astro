export const page = { door: "living-here", topic: "moving", label: "New to Mon County", summary: "Start your utilities, learn your trash day, find care, and meet people, in one place" };
const sections = [
  { title: 'Set up your home', links: [
    { href: '/moving-here/', label: 'Start power, water, gas and trash', text: 'who serves homes here and how to start service' },
    { href: '/living-here/?pick=pickup', label: 'Your trash pickup day', text: 'find your day' },
    { href: '/recycling/', text: 'the curbside bin, and where to take hard items' },
    { href: '/flood-zone/', text: 'check a home before you buy or rent' },
  ] },
  { title: 'Find care', links: [
    { href: '/care/', text: 'a dentist, Medicare, shots and staying healthy' },
    { href: '/staying-well/', text: 'checkups and shots to get each year' },
