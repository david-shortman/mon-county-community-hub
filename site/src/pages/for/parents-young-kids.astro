    { href: '/staying-well/', text: 'checkups and shots to keep up with' },
    { href: '/car-seat-checks/', text: 'two places in Morgantown that check a car seat for free' },
  ] },
  { title: 'Preschool', links: [
    { href: '/family/?pick=prek', label: 'Pre-K and Head Start', text: 'for children who will be 3 or 4' },
  ] },
  { title: 'Things to do and other parents to meet', links: [
    { href: '/family/?pick=little-kids', label: 'Playgroups and story times', text: 'free playgroups, a baby pantry and library story times' },
    { href: '/families-and-kids/', text: 'everything for young kids on one page' },
  ] },
  { title: 'Food and bills', links: [
    { href: '/help/food/', text: 'food today or this week, or help buying groceries every month' },
