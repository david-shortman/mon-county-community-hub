---
// Every Mountain Line route on one page (#924, part of #393). Mountain Line's
// route pages send phone users to two-page PDF brochures. This page lists each
// route's days, first and last runs and stops from its route page, and links
// both PDFs with the date printed on each. All facts are in
// content/pdf-pages/mountain-line-routes.yaml. Timetables wait on a current
// schedule feed (#407). "When the buses run" (DayOnTheBuses) charts each
// route's first to last run from the `hours` on each route in that file.
import Base from '../layouts/Base.astro';
import FromPdf from '../components/FromPdf.astro';
import DayOnTheBuses from '../components/DayOnTheBuses.astro';
import BusNetwork from '../components/BusNetwork.astro';
import TripPlanner from '../components/TripPlanner.astro';
import { pdfPage } from '../lib/pdf-pages.mjs';
import { fixFormUrl } from '../lib/group-requests.mjs';
export const page = { door: "living-here", topic: "moving", label: "Every bus route and when it runs", summary: "All Mountain Line routes: where each one goes, the days it runs, its first and last run, and its schedule PDF" };
const d = pdfPage('mountain-line-routes');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Mountain Line bus routes and schedules, Morgantown WV" description="Every Mountain Line bus route in Morgantown and Mon County: where each goes, the days it runs, its first and last run, and its schedule PDF.">
  <h1>Every bus route and when it runs</h1>
  <p class="lede">Mountain Line's full bus schedules are PDF brochures that are hard to read on a phone. Here is each route's days, first and last run, and stops, from Mountain Line's route pages. For the time the bus reaches your stop, use the <a href="https://www.busride.org/google-trip-planner">trip planner</a> or call <a href="tel:3042917433">304-291-RIDE (304-291-7433)</a>.</p>
  <p>First and last runs are when the route starts its first and last trip. The bus reaches your stop later.</p>

  <nav aria-label="On this page">
    <ul>
      <li><a href="#tp-h">Plan a trip by bus</a></li>
      <li><a href="#when">When the buses run</a></li>
      <li><a href="#net-h">How the routes fit together</a></li>
      {d.sections.map((s) => <li><a href={`#${s.id}`}>{s.heading}</a></li>)}
    </ul>
  </nav>

  <TripPlanner />

  <section aria-labelledby="when">
    <h2 id="when">When the buses run</h2>
    <p>Each bar is one route, from its first run of the day to its last. Scroll through one weekday to see which routes are running at each hour.</p>
    <DayOnTheBuses />
  </section>

  <BusNetwork />

  <FromPdf d={d} />

  <p>Fares, free rides with a WVU ID, the Grey Line bus to Pittsburgh and which bus goes to the hospitals are on <a href={`${base}/getting-around/`}>Getting around without a car</a>.</p>

  <p class="meta">Routes and times change, often with the WVU calendar, so check Mountain Line's page before you go. Stop-by-stop times are not on this page because some PDFs are several years old and some differ from their route page. Something wrong? <a href={fixFormUrl({ page: Astro.url.pathname })}>Tell us what is wrong on this page</a>.</p>
</Base>
