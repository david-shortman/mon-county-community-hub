---
// Health department permit fees (#926, part of #393): the scanned fee form
// "Permit Fees and Fees for Service, Fiscal Year 2026-2027" as short lists a
// phone can read. Every label and fee is in content/pdf-pages/monchd-fees-2026-27.yaml,
// copied from the form. The phone number is printed on the form.
import Base from '../layouts/Base.astro';
import FromPdf from '../components/FromPdf.astro';
import { pdfPage } from '../lib/pdf-pages.mjs';
import { telHref } from '../lib/content.mjs';
export const page = { door: "community", topic: "government", label: "Health department permit fees", summary: "What the county health department charges for septic and well permits, well water tests, home sale checks, radon tests and food, child care and other permits" };
const d = pdfPage('monchd-fees-2026-27');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const phone = '304-598-5131';
---
<Base title="Monongalia County Health Department permit fees, 2026-27" description="The Monongalia County Health Department's environmental health fees for fiscal year 2026-2027: septic and well permits, well water tests, home loan evaluations, radon tests, and permits for food places, food trucks, child care centers, hotels, pools, campgrounds, tattoo shops and tanning.">
  <h1>Health department permit fees</h1>
  <p class="lede">The Monongalia County Health Department charges these fees for permits and some services. They come from its fee form for fiscal year 2026-2027. That form is a scanned PDF that is hard to read on a phone, so we copied each fee here. Questions about which fee fits you: call Environmental Health at <a href={telHref(phone)}>{phone}</a>.</p>

  <nav aria-label="On this page">
    <ul>
      {d.sections.map((s) => <li><a href={`#${s.id}`}>{s.heading}</a></li>)}
    </ul>
  </nav>

  <FromPdf d={d} />

  <p>Need the steps for a septic system, a well or a home sale check? See <a href={`${base}/septic-and-wells/`}>Septic systems and well water</a>.</p>

  <p class="meta">This page is a reading aid. The health department's PDF is the official list, and fees can change, so check with them before you pay. Something wrong? <a href="https://github.com/david-shortman/mon-county-community-hub/issues/new?template=suggest-resource.yml">Tell us</a>.</p>
</Base>
