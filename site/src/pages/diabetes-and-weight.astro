---
// Diabetes, blood pressure or weight: low cost help managing it (#481, rank 10
// in #475). Facts are in resource records, read 2026-10-30. Describe only.
import Base from '../layouts/Base.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { loadDir } from '../lib/content.mjs';
export const page = { door: "care", topic: "health", label: "Diabetes, blood pressure or weight", summary: "Low cost diet help and free clinics for diabetes and heart health" };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = loadDir('resources');
const r = (slug) => all.find((e) => e.slug === slug);
---
<Base title="Diabetes, blood pressure or weight help in Morgantown and Mon County" description="Low cost help managing diabetes, blood pressure or weight in Morgantown and Monongalia County: health department dietitians with a sliding fee, and free diabetes and heart clinics for Health Right patients.">
  <h1>Diabetes, blood pressure or weight: help managing it</h1>
  <p class="lede">The Monongalia County Health Department has dietitians who help with diabetes, weight and heart health, with a sliding fee if you have no insurance. Low income and no insurance? Health Right's free clinic holds diabetes and heart clinics for its patients.</p>

  {r('monchd-nutrition-counseling') && <ResourceCard r={r('monchd-nutrition-counseling')} headingLevel={2} showCost />}
  {r('health-right-specialty-clinics') && <ResourceCard r={r('health-right-specialty-clinics')} headingLevel={2} />}

  <h2>Also check</h2>
  <ul>
    <li><a href={`${base}/staying-well/`}>Staying well</a>: a yearly checkup, moving more and the rail-trails, and help to quit tobacco.</li>
    <li><a href={`${base}/dental-and-prescriptions/`}>Help paying for medicine</a>.</li>
  </ul>

  <p class="meta">Sources checked October 30, 2026. We describe these services; we do not give medical advice. Ask a doctor, nurse or pharmacist about what is right for you. Something out of date? <a href="https://github.com/david-shortman/mon-county-community-hub/issues/new?template=suggest-resource.yml">Tell us</a>.</p>
</Base>
