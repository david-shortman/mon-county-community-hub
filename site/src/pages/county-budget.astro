---
// The county budget (part of #393): the County Commission's 2026-2027 levy
// estimate, a scanned 4-page PDF, as one plain chart and short lists. Every
// line is copied in content/pdf-pages/mon-county-budget-2026-27.yaml. The
// chart reads the PDF's own section totals from that record, so no number
// is typed twice. The share of the total is our math, and the page says so.
import Base from '../layouts/Base.astro';
import FromPdf from '../components/FromPdf.astro';
import SourceLine from '../components/SourceLine.astro';
import { pdfPage } from '../lib/pdf-pages.mjs';
import { telHref } from '../lib/content.mjs';
import { fixFormUrl } from '../lib/group-requests.mjs';
export const page = { door: "community", topic: "government", label: "Mon County's budget for 2026-2027", summary: "The County Commission's 2026-2027 budget in plain lists: where the General Fund money comes from, where it goes, and a chart of spending by area" };
const d = pdfPage('mon-county-budget-2026-27');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const phone = '304-291-7230';

// "General Fund: $22,059,607" (or a lone "$44,011,156") to a number.
const general = (it) => {
  const line = it.lines.find((l) => l.startsWith('General Fund:') || l.startsWith('$'));
  return Number(line.replace(/[^\d]/g, ''));
};
const totalItem = (s) => s.items.find((it) => typeof it === 'object' && /^TOTAL /.test(it.name));
const spendIds = ['general-government', 'public-safety', 'health-sanitation', 'culture-recreation', 'social-services', 'capital-projects'];
const total = general(d.sections.find((s) => s.id === 'total').items[0]);
const rows = spendIds.map((id) => {
  const s = d.sections.find((x) => x.id === id);
  const amount = general(totalItem(s));
  return { id, label: s.heading.replace(/^Spending: /, ''), amount, share: amount / total };
}).sort((a, b) => b.amount - a.amount);
const sum = rows.reduce((n, r) => n + r.amount, 0);
if (sum !== total) throw new Error(`county budget: section totals add to ${sum}, the PDF's total is ${total}`);
const money = (n) => `$${n.toLocaleString('en-US')}`;
const pct = (x) => `${Math.round(x * 100)}%`;
const propertyTax = general(d.sections.find((s) => s.id === 'money-in').items.find((it) => it.name === 'Property Taxes Current year'));
const top = rows[0], second = rows[1];

// Plain meanings for budget words (#1880). Each one quotes West Virginia
// law, read on code.wvlegislature.gov on 2026-11-14. A word with no
// official meaning found is named under "not explained here" instead.
const law = (sec) => ({ url: `https://code.wvlegislature.gov/${sec}/`, name: 'West Virginia Legislature', checked: '2026-11-14' });
const terms = [
  {
    word: 'Levy Estimate',
    meaning: 'The county\'s yearly plan for money in and money out, and the property tax rate it proposes.',
    quote: 'State law (WV Code §11-8-10, the section the PDF names) says the County Commission must "ascertain the fiscal condition of the county, and make an itemized statement." The statement lists the money due "from every source," "All other expenditures to be paid out of the receipts for the current fiscal year," and "The proposed county levy in cents on each one hundred dollars\' assessed valuation."',
    source: law('11-8-10'),
  },
  {
    word: 'General Fund',
    meaning: 'The county\'s main fund, for its everyday work.',
    quote: 'State law (WV Code §6-9D-2, in the part about local fiscal emergencies) says the general fund is "the fund used to account for and report the primary operating activities of the local government."',
    source: law('6-9D-2'),
  },
  {
    word: 'Estimated Revenues',
    meaning: 'The money the budget expects to come in.',
    quote: 'The same section says estimated revenues are "the aggregate estimates of revenue receipts in the budget of the general fund of a local government and other funds."',
    source: law('6-9D-2'),
  },
  {
    word: 'Coal Severance Tax Fund',
    meaning: 'A separate fund for the county\'s share of a state tax on coal.',
    quote: 'State law (WV Code §11-13A-6) says every county must create a "coal severance tax revenue fund" for this money. The County Commission may spend it "for such public purposes as the county commission or governing body shall determine to be in the best interest of the people." Money not spent by the end of the year "shall be reappropriated to the budget" for the next year.',
    source: law('11-13A-6'),
  },
];
---
<Base title="Mon County budget 2026-2027: where the money goes, Monongalia County, WV" description={`The Monongalia County Commission's 2026-2027 budget in plain lists: ${money(total)} in the General Fund, where it comes from, and where it goes, with a chart.`}>
  <h1>Mon County's budget for 2026-2027</h1>
  <p class="lede">The Monongalia County Commission plans to spend {money(total)} from its General Fund in the 2026-2027 fiscal year. About {pct(top.share)} is for {top.label.toLowerCase()}, and {pct(second.share)} is for {second.label.toLowerCase()}. The budget is a scanned PDF, so here it is as a chart and short lists.</p>

  <figure class="budget-chart" aria-labelledby="budget-chart-title">
    <h2 id="budget-chart-title">Where the General Fund money goes</h2>
    <ul class="bars">
      {rows.map((r) => (
        <li>
          <span class="bar-label"><a href={`#${r.id}`}>{r.label}</a></span>
          <span class="bar-value">{money(r.amount)} <span class="bar-share">({pct(r.share)})</span></span>
          <span class="bar-track" aria-hidden="true"><span class="bar-fill" style={`width:${(r.share * 100).toFixed(1)}%`}></span></span>
        </li>
      ))}
    </ul>
    <figcaption>Total: {money(total)}. Each amount is the PDF's own section total. The share in brackets is our math from those totals, rounded. Tap a name to see every line in it.</figcaption>
  </figure>

  <p>Where the money comes from: the biggest line is "Property Taxes Current year," at {money(propertyTax)}. Every source is listed below.</p>

  <section class="note" aria-labelledby="words">
    <h2 id="words">What some budget words mean</h2>
    <dl class="terms">
      {terms.map((t) => (
        <>
          <dt>{t.word}</dt>
          <dd>
            <p>{t.meaning}</p>
            <p class="quote">{t.quote}</p>
            <SourceLine sources={[t.source]} about={`the meaning of ${t.word}`} />
          </dd>
        </>
      ))}
    </dl>
    <p>Not explained here: "Fund Balance" (the $10,000,000 first line of money in) and the limit in "Contingencies - Not to Exceed 10% of Budget." We could not find an official page that says what they mean for this budget, To ask about them, call the County Clerk at <a href={telHref(phone)}>{phone}</a>. State law does say the plan must make "proper allowance for delinquent taxes, exonerations and contingencies" (WV Code §11-8-10).</p>
  </section>

  <nav aria-label="On this page">
    <ul>
      {d.sections.map((s) => <li><a href={`#${s.id}`}>{s.heading}</a></li>)}
    </ul>
  </nav>

  <FromPdf d={d} />

  <h2 id="more">Past budgets and other county money records</h2>
  <p>The County Clerk's <a href={d.found_on}>County Budget and Finances page</a> also has county budgets back to 2015, audit reports, financial statements, levy rates and vendor lists, all as PDFs, and a link to the county's online budget tool from OpenGov. Questions: call the County Clerk at <a href={telHref(phone)}>{phone}</a>.</p>
  <SourceLine sources={[d.sources[1]]} about="the County Clerk's budget and finance records" />
  <p>When budgets are set each year, and how to comment: <a href={`${base}/make-it-better/when-it-gets-decided/`}>when plans and budgets get decided</a>. How your own tax bill is figured: <a href={`${base}/property-tax/`}>property tax</a>.</p>

  <p class="meta">This page is a reading aid. The County Clerk's PDF is the official version. Something wrong? <a href={fixFormUrl({ page: Astro.url.pathname })}>Tell us what is wrong on this page</a>.</p>
</Base>

<style>
  .budget-chart { margin: var(--s5) 0; }
  .budget-chart h2 { margin-top: 0; }
  .bars { list-style: none; margin: var(--s3) 0 0; padding: 0; }
  .bars li { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: var(--s1) var(--s3); padding: var(--s3) 0; border-bottom: 1px solid var(--line); }
  .bars li:last-child { border-bottom: none; }
  .bar-label { flex: 1 1 10rem; overflow-wrap: break-word; }
  .bar-value { flex: 0 1 auto; font-variant-numeric: tabular-nums; }
  .bar-share { color: var(--muted); }
  .bar-track { flex: 1 0 100%; display: block; height: 0.75rem; background: var(--sand); border: 1px solid var(--line); }
  .bar-fill { display: block; height: 100%; min-width: 2px; background: var(--accent); }
  .terms dt { font-weight: 700; margin-top: var(--s4); }
  .terms dt:first-child { margin-top: 0; }
  .terms dd { margin: var(--s1) 0 0; }
  .terms dd > p { margin-bottom: var(--s2); }
  .terms .quote { color: var(--muted); }
  .budget-chart figcaption { margin-top: var(--s3); font-size: 0.95rem; color: var(--muted); }
  @media (forced-colors: active) { .bar-fill { background: CanvasText; } }
</style>
