---
// How is Mon County doing? (#62, the first slice of the data dashboard in #15).
// Official numbers only, each from a file in content/indicators/ with its
// source, data year and checked date. We describe; we never say what a
// number means for policy, and never claim credit for a change.
import Base from '../layouts/Base.astro';
import SourceLine from '../components/SourceLine.astro';
import TrendChart from '../components/TrendChart.astro';
import MotionSwitch from '../components/MotionSwitch.astro';
import { chartGuide } from '../lib/chart-guide.mjs';
import { loadIndicators, showValue, PLACES } from '../lib/indicators.mjs';
import { loadIndicators as loadLive } from '../lib/live-indicators/index.mjs';
import { todayYmd } from '../lib/content.mjs';
import Fact from '../components/Fact.astro';
import { factsFor } from '../lib/facts.mjs';
const moneyFact = factsFor('money');
export const page = { door: 'community', topic: 'data', label: "How we're doing", summary: 'Official numbers on health, money, jobs and daily needs in Mon County, with sources' };
const health = loadIndicators('health');
const schools = loadIndicators('schools');
// Test scores share one intro; the graduation rate gets its own (#1662).
const tests = schools.filter((i) => i.slug.startsWith('school-tests-'));
const grad = schools.filter((i) => !i.slug.startsWith('school-tests-'));
const repo = 'https://github.com/david-shortman/mon-county-community-hub';
// Live numbers read from the sources' own data at each build (#15).
const ind = await loadLive();
const day = (iso) => (iso ? new Intl.DateTimeFormat('en-CA', { timeZone: 'America/New_York' }).format(new Date(iso)) : todayYmd());

// Unemployment: the last 24 months as a line.
const bls = ind['bls-laus-monongalia'];
const pts = (bls.data?.points ?? []).slice(-24);
const latest = pts.at(-1);
const yearAgo = latest && pts.find((p) => p.month === `${Number(latest.month.slice(0, 4)) - 1}${latest.month.slice(4)}`);
const W = 420, H = 200, L = 40, R = 10, T = 12, B = 30;
const top = Math.max(1, Math.ceil(Math.max(...pts.map((p) => p.value), 0)));
const x = (i) => L + (pts.length > 1 ? (i * (W - L - R)) / (pts.length - 1) : 0);
const y = (v) => T + (H - T - B) * (1 - v / top);
const line = pts.map((p, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(p.value).toFixed(1)}`).join(' ');
const step = top <= 6 ? 1 : 2;
const ticks = Array.from({ length: Math.floor(top / step) + 1 }, (_, i) => i * step);
// A guided look at this chart (#1451): the steps' words come from the same points.
const guide = chartGuide(pts, { top });
const yi = guide?.yearAgo ? pts.indexOf(guide.yearAgo) : -1;
const at = (i) => ({ x: x(i).toFixed(1), y: y(pts[i].value).toFixed(1) });
const lp = latest ? at(pts.length - 1) : null;
const yp = yi >= 0 ? at(yi) : null;
// Each value label sits above its point, or below it when it is the lower of the
// two (or too near the top), so the two labels never cover each other.
const labelY = (py, below) => {
  const n = Number(py), under = (below || n < 34) && n + 24 <= H - B - 4;
  return (under ? n + 24 : n - 14).toFixed(1);
};
const latestLow = guide?.yearAgo ? latest.value < guide.yearAgo.value : false;
// Short words under the held chart, one per step (the steps say it in full).
const short = (p) => `${p.label.replace(/^(\w{3})\w*/, '$1')}: ${p.value}%`;
const caps = guide ? {
  latest: `Newest month, ${short(latest)}.`,
  year: guide.yearAgo ? `${short(guide.yearAgo)}. ${short(latest)}.` : '',
  read: 'The side shows the rate. The bottom shows the months.',
} : {};

const places = ind['cdc-places-monongalia'];
const measures = places.data?.measures ?? [];
---
<Base title="How is Mon County doing? Official numbers for Monongalia County, WV" description="Official numbers on poverty, health insurance, life expectancy, overdose deaths, jobs, school test scores, graduation and daily needs in Monongalia County, WV, next to West Virginia and the US, with sources.">
  <h1>How is Mon County doing?</h1>
  <p class="lede">Official numbers about Monongalia County, next to West Virginia and the whole country. Each one links to where it comes from and says what year it covers, and the charts show up to ten years.</p>

  <h2 id="health">Health and money</h2>
  <p>These come from <a href="https://www.countyhealthrankings.org/health-data/west-virginia/monongalia">County Health Rankings</a>, a program that gathers the same public numbers for every county in the US. We use its March 2026 update where it has the measure, and its 2025 data file where it does not. Each card names the one it uses. Some numbers cover three years together, like 2021-2023. The definitions come from its <a href="https://www.countyhealthrankings.org/sites/default/files/media/document/DataDictionary_2025.xlsx">2025 data dictionary</a>, and the years from its <a href="https://www.countyhealthrankings.org/sites/default/files/media/document/chr_trends_csv_2025.csv">2025 trends file</a> and its <a href="https://www.countyhealthrankings.org/sites/default/files/media/document/Analytic_Dataset_Codebook_Supplemental_Release_20260325%5B1%5D.pdf">March 2026 codebook</a>.</p>
  {health.map((i) => (
    <article class="card" id={i.slug}>
      <h3>{i.title} ({i.data_year})</h3>
      <p>{i.definition}</p>
      <ul>
        {PLACES.filter(([k]) => i.values[k] != null).map(([k, label]) => (
          <li>{k === 'monongalia' ? <strong>{label}: {showValue(i, i.values[k])}</strong> : <>{label}: {showValue(i, i.values[k])}</>}</li>
        ))}
      </ul>
      <TrendChart i={i} />
      <SourceLine sources={i.sources.slice(0, 1)} about={i.title} slug={i.slug} />
    </article>
  ))}

  <h2 id="jobs">Unemployment by month</h2>
  <p>The newest count, from the U.S. Bureau of Labor Statistics. It is updated every month, so it is newer than the yearly number above.</p>
  {latest ? (
    <>
      <p>In <strong>{latest.label}</strong>, the unemployment rate in Monongalia County was <strong>{latest.value}%</strong>{latest.preliminary && ' (a preliminary number, which can change)'}.{yearAgo && ` In ${yearAgo.label} it was ${yearAgo.value}%.`}</p>
      <div id="ue-guide">
      <MotionSwitch skip="#ue-table" skipText="Skip the guided look" />
      <div class="chart stage" data-step="none">
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="ue-title">
          <title id="ue-title">Monongalia County unemployment rate by month, {pts[0].label} to {latest.label}. The table below has every value.</title>
          {ticks.map((t) => (
            <g>
              <line x1={L} x2={W - R} y1={y(t)} y2={y(t)} class="grid" />
              <text x={L - 6} y={y(t) + 5} text-anchor="end" class="axis">{t}%</text>
            </g>
          ))}
          <path d={line} class="series" />
          {pts.map((p, i) => (
            <g>
              {(i % 8 === 0 || i === pts.length - 1) && <text x={x(i)} y={H - 6} text-anchor={i === 0 ? 'start' : i === pts.length - 1 ? 'end' : 'middle'} class="axis">{p.label.replace(/^(\w{3})\w*/, '$1')}</text>}
              <circle cx={x(i)} cy={y(p.value)} r="9" class="hit"><title>{p.label}: {p.value}%{p.preliminary ? ' (preliminary)' : ''}</title></circle>
            </g>
          ))}
          <circle cx={x(pts.length - 1)} cy={y(latest.value)} r="4" class="dot" />
          <g class="gd" aria-hidden="true">
            {yp && (
              <path d={`M${yp.x},${yp.y} H${lp.x} V${lp.y}`} class="gd-line gd-gap" />
            )}
            <text x={lp.x} y={labelY(lp.y, latestLow)} text-anchor="end" class="gd-tx gd-lt">{latest.value}%</text>
            {yp && <text x={yp.x} y={labelY(yp.y, !latestLow)} text-anchor="middle" class="gd-tx gd-yt">{guide.yearAgo.value}%</text>}
            <circle r="9" class="gd-ring" style={`--lx:${lp.x}px;--ly:${lp.y}px;--yx:${(yp ?? lp).x}px;--yy:${(yp ?? lp).y}px`} />
          </g>
        </svg>
        <p class="gd-cap" aria-hidden="true"></p>
      </div>
      <p class="chart-note">Not seasonally adjusted, so it rises and falls with the time of year. To see change over a year, compare a month with the same month a year before. Months with no published estimate are left out.</p>
      <h3 id="ue-guide-h">A guided look at this chart</h3>
      <p>{guide.steps.length === 3 ? "Three" : "Two"} steps that walk through the chart above, using its real numbers.</p>
      <ol class="guide-steps" aria-labelledby="ue-guide-h">
        {guide.steps.map((st) => <li data-key={st.key} data-cap={caps[st.key]}><strong>{st.title}.</strong> {st.text}</li>)}
      </ol>
      </div>
      <details id="ue-table">
        <summary>Show the numbers as a table</summary>
        <div class="table-scroll" role="region" aria-label="Unemployment rate by month" tabindex="0">
          <table>
            <thead><tr><th scope="col">Month</th><th scope="col">Unemployment rate</th></tr></thead>
            <tbody>{[...pts].reverse().map((p) => <tr><td>{p.label}</td><td>{p.value}%{p.preliminary ? ' (preliminary)' : ''}</td></tr>)}</tbody>
          </table>
        </div>
      </details>
    </>
  ) : <p>This number could not be loaded today. See it at the source below.</p>}
  <SourceLine sources={[{ url: bls.page_url, checked: day(bls.fetched), name: 'U.S. Bureau of Labor Statistics' }]} about="unemployment rate" />

  <h2 id="needs">Daily needs and health, CDC estimates</h2>
  {measures.length ? (
    <>
      <p>Share of adults in Monongalia County, {measures[0].year}. These are CDC estimates made with a statistical model from a national health survey, not a count of local people. The range in small print is where CDC says the real number likely falls.</p>
      <ul class="tiles">
        {measures.map((m) => (
          <li class="tile">
            <span class="num">{m.value}{m.unit}</span>
            <span class="what">{m.measure}</span>
            <span class="range">Likely between {m.low}{m.unit} and {m.high}{m.unit}</span>
          </li>
        ))}
      </ul>
    </>
  ) : <p>These numbers could not be loaded today. See them at the source below.</p>}
  <SourceLine sources={[{ url: places.page_url, checked: day(places.fetched), name: 'Centers for Disease Control and Prevention (PLACES, 2025 release)' }]} about="CDC estimates" />

  <p>Which of these problems people here say are hardest, ranked with more local sources: <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/needs/`}>What people here need most</a>.</p>

  <h2 id="basic-budget">What a basic budget costs here</h2>
  <p>Two public sources estimate how much money a household in Monongalia County needs for basics like housing, child care, food, getting around, health care and taxes. ALICE stands for Asset Limited, Income Constrained, Employed: households that earn more than the poverty line but not enough for the basics. The two sources measure different years and count different costs, so their numbers are not the same. Neither one is the official poverty line, and neither one says what any one family spends.</p>
  <Fact f={moneyFact('alice-survival-budget')} about="the ALICE household budget" />
  <Fact f={moneyFact('mit-living-wage')} about="the MIT living wage" />
  <p>Why they differ: ALICE's numbers are 2023 costs. MIT's are adjusted to December 2025 prices, and MIT also counts civic costs, which ALICE's list does not. Looking for help with costs? <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/help/what-help/`}>See what help you might get</a>.</p>

  <h2 id="what-it-means">What these numbers do and don't tell you</h2>
  <ul>
    <li><strong>They are for the whole county.</strong> They do not show differences between neighborhoods or towns.</li>
    <li><strong>They are estimates, and they are a year or more old.</strong> Each one says the year it covers. Small differences between places may not mean much.</li>
    <li><strong>They describe; they don't explain.</strong> A number does not say why it is high or low, or what should be done about it.</li>
    <li><strong>This site did not change them.</strong> Many people and groups shape these numbers. We only point to them.</li>
  </ul>

  <h2 id="schools">School test scores</h2>
  <p>How Monongalia County Schools students did on West Virginia's yearly state tests, next to the whole state. Each number is the share of students tested who scored proficient. These come from <a href="https://zoomwv.k12.wv.us/Dashboard/dashboard/7301">ZoomWV</a>, the West Virginia Department of Education's data site. It needs JavaScript. To see Mon County there, open Filter Data, then District/County, and pick (056) - Monongalia. Students in grades 3 to 8 and 11 take these tests. There were no state tests in 2019-2020.</p>
  {tests.map((i) => (
    <article class="card" id={i.slug}>
      <h3>{i.title} ({i.data_year} school year)</h3>
      <p>{i.definition}</p>
      <ul>
        {PLACES.filter(([k]) => i.values[k] != null).map(([k, label]) => (
          <li>{k === 'monongalia' ? <strong>{label}: {showValue(i, i.values[k])}</strong> : <>{label}: {showValue(i, i.values[k])}</>}</li>
        ))}
      </ul>
      <TrendChart i={i} />
      <SourceLine sources={i.sources.slice(0, 1)} about={i.title} slug={i.slug} />
    </article>
  ))}
  <p>Test scores are one measure. They do not show everything a school does, and they do not compare schools within the county.</p>

  <h2 id="graduation">High school graduation</h2>
  <p>The share of Monongalia County Schools students who finished high school in four years, next to the whole state. A class is counted from when students start 9th grade. This comes from the <a href="https://zoomwv.k12.wv.us/Dashboard/dashboard/2111">ZoomWV Graduation Summary</a>. To see Mon County there, open Filter Data, then District/County, and pick (056) - Monongalia. Since the 2020-2021 school year, the state counts students who earn an alternate diploma as graduates, so the chart starts that year.</p>
  {grad.map((i) => (
    <article class="card" id={i.slug}>
      <h3>{i.title} ({i.data_year} school year)</h3>
      <p>{i.definition}</p>
      <ul>
        {PLACES.filter(([k]) => i.values[k] != null).map(([k, label]) => (
          <li>{k === 'monongalia' ? <strong>{label}: {showValue(i, i.values[k])}</strong> : <>{label}: {showValue(i, i.values[k])}</>}</li>
        ))}
      </ul>
      <TrendChart i={i} />
      <SourceLine sources={i.sources.slice(0, 1)} about={i.title} slug={i.slug} />
    </article>
  ))}

  <h2 id="coming">Crime</h2>
  <p>We have not added official crime numbers yet, because we could not check them on the official source this time. That work is tracked in <a href={`${repo}/issues/772`}>issue 772</a>.</p>
</Base>

<script>
  import { watchSteps } from '../lib/motion-client.mjs';
  const sec = document.getElementById('ue-guide');
  const stage = sec?.querySelector('.stage');
  const steps = sec ? Array.from(sec.querySelectorAll<HTMLElement>('.guide-steps > li')) : [];
  const cap = sec?.querySelector('.gd-cap');
  watchSteps(sec, steps, (i) => {
    stage?.setAttribute('data-step', steps[i].dataset.key ?? '');
    if (cap) cap.textContent = 'Step ' + (i + 1) + ' of ' + steps.length + ': ' + (steps[i].dataset.cap ?? '');
  }, {
    onLive: (on) => { if (!on) stage?.setAttribute('data-step', 'none'); },
  });
</script>

<style>
  .chart { margin: 1rem 0; }
  .chart svg { width: 100%; height: auto; display: block; }
  .chart .grid { stroke: var(--line); stroke-width: 1; }
  .chart .axis { fill: var(--muted); font-size: 14px; }
  .chart .series { fill: none; stroke: var(--accent); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .chart .dot { fill: var(--accent); stroke: var(--card); stroke-width: 2; }
  .chart .hit { fill: transparent; }
  .chart .hit:hover { fill: var(--accent); fill-opacity: 0.25; }
  .chart-note { color: var(--muted); font-size: 0.9rem; }
  /* A guided look at this chart (#1451). The still page is the chart plus the
     numbered steps. With script, motion allowed and a tall enough screen, the
     chart stays in view and a ring moves to the point each step names. */
  .guide-steps { padding-left: var(--s5); }
  .guide-steps > li { margin: 0 0 var(--s3); }
  .gd { display: none; pointer-events: none; }
  .gd-cap { display: none; margin: var(--s1) 0 0; font-size: 0.95rem; font-weight: 700; }
  .gd-ring { fill: none; stroke: var(--accent); stroke-width: 2.5; transform: translate(var(--lx), var(--ly)); }
  .gd-line { fill: none; stroke: var(--fg); stroke-width: 1.5; stroke-dasharray: 4 3; }
  .gd-tx { fill: var(--fg); font-size: 15px; font-weight: 700; }
  .gd-gap, .gd-yt, .gd-lt { opacity: 0; }
  @media (min-height: 36rem) {
    #ue-guide.is-live .gd { display: inline; }
    #ue-guide.is-live .gd-cap { display: block; }
    #ue-guide.is-live .stage { position: sticky; top: 0; z-index: 2; background: var(--bg); border-bottom: 1px solid var(--line); padding-block: var(--s2); }
    #ue-guide.is-live .guide-steps > li { margin-bottom: 12rem; padding-left: var(--s3); border-left: 3px solid transparent; }
    #ue-guide.is-live .guide-steps > li:last-child { margin-bottom: var(--s6); }
    #ue-guide.is-live .guide-steps > li.on { border-left-color: var(--accent); }
    #ue-guide .stage[data-step="latest"] .gd-lt,
    #ue-guide .stage[data-step="year"] :is(.gd-gap, .gd-yt, .gd-lt) { opacity: 1; }
    #ue-guide .stage[data-step="year"] .gd-ring { transform: translate(var(--yx), var(--yy)); }
    #ue-guide .stage[data-step="read"] :is(.series, .dot, .gd-ring) { opacity: 0.3; }
    #ue-guide .stage[data-step="read"] .axis { fill: var(--accent); font-weight: 700; }
  }
  @media (prefers-reduced-motion: no-preference) {
    #ue-guide.is-live .gd-ring { transition: transform 0.9s ease, opacity 0.4s ease; }
    #ue-guide.is-live :is(.gd-gap, .gd-yt, .gd-lt, .series, .dot) { transition: opacity 0.4s ease 0.3s; }
  }
  .tiles { list-style: none; padding: 0; display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr)); }
  .tile { background: var(--card); border: 1px solid var(--line); border-top: 2px solid var(--fg); border-radius: 2px; padding: 0.75rem 1rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .tile .num { font-size: 1.6rem; font-weight: 700; }
  .tile .range { color: var(--muted); font-size: 0.9rem; }
  table { border-collapse: collapse; }
  th, td { text-align: left; padding: 0.25rem 1rem 0.25rem 0; border-bottom: 1px solid var(--line); }
</style>
