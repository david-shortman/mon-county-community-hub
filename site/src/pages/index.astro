---
// The Front Door (identity v2, direction B): one question, help right now,
// search, and need buttons. Help is two taps away from here.
import Base from '../layouts/Base.astro';
import RightNow from '../components/RightNow.astro';
import NeedTiles from '../components/NeedTiles.astro';
import SearchBox from '../components/SearchBox.astro';
import EventCard from '../components/EventCard.astro';
import { loadCalendar, upcoming } from '../lib/content.mjs';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const soon = upcoming(loadCalendar(), undefined, 31).slice(0, 3);
---
<Base title="Help in Morgantown and Monongalia County, WV" description="What do you need help with? Shelter tonight, food, bills, rent, shots, deadlines and recycling in Morgantown and Monongalia County, WV. Call or text 211 any time.">
  <h1 class="front-q">What do you need help with?</h1>

  <RightNow />

  <NeedTiles />

  <SearchBox />

  <h2>Coming up soon</h2>
  {soon.length ? soon.map((e) => <EventCard e={e} />) : <p>Nothing is on our calendar for the next month. That does not mean no help is available. Call or text 211.</p>}
  <p><a href={`${base}/calendar/`}>See all deadlines and dates</a></p>

  <h2>What this is</h2>
  <p>Plain-language help for Morgantown and Monongalia County, WV. We point you to the people and groups already doing the work, and we tell you where every fact came from. A local resident sets the direction, and an AI assistant (Claude) researches, builds, and checks sources every day. <a href={`${base}/about/`}>Read how it works</a>.</p>
</Base>
