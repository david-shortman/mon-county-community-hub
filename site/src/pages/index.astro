---
// The Front Door (#250, identity v2 direction B): Help now on top, what the
// site is, the five doors, search, the season, what is coming up, and a
// person to talk to. Help is one tap away through a door's examples, and
// every live door is two taps from a phone number, a place or a date.
import Base from '../layouts/Base.astro';
import HelpNowBar from '../components/HelpNowBar.astro';
import HelpNowSources from '../components/HelpNowSources.astro';
import DoorCards from '../components/DoorCards.astro';
import SearchBox from '../components/SearchBox.astro';
import SeasonCard from '../components/SeasonCard.astro';
import EventCard from '../components/EventCard.astro';
import { loadCalendar, upcoming } from '../lib/content.mjs';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const soon = upcoming(loadCalendar(), undefined, 31).slice(0, 3);
---
<Base title="Help in Morgantown and Monongalia County, WV" description="Find local help with bills, food, a place to stay, health care and more in Morgantown and Monongalia County, WV. Every answer shows its source. Call or text 211 any time.">
  <HelpNowBar />

  <h1 class="front-h">Find help in Mon County</h1>
  <p class="lede">We point you to local help in Morgantown and Monongalia County, and show where every fact came from.</p>

  <DoorCards />

  <SearchBox label="Or type what's going on" />
  <noscript><p><a href={`${base}/topics/`}>See all topics, A to Z</a></p></noscript>

  <SeasonCard />

  <h2>Coming up</h2>
  {soon.length ? soon.map((e) => <EventCard e={e} />) : <p>Nothing is on our calendar for the next month. That does not mean no help is available. Call or text 211.</p>}
  <p><a href={`${base}/calendar/`}>All dates and deadlines</a></p>

  <section class="note" aria-labelledby="person-h">
    <h2 id="person-h">Rather talk to a person?</h2>
    <p>Call <a href="tel:211">211</a>. It is a free West Virginia help line, open any hour. Tell them what is going on and they will point you to local help. You can also text your ZIP code to <a href="sms:898211">898-211</a>.</p>
  </section>

  <HelpNowSources />
</Base>
