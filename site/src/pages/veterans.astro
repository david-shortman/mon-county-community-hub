---
// Veterans contact sheet (#228, part of #210): the VA clinic and Vet Center on
// Commerce Drive, what needs a trip to Clarksburg, and 24/7 lines.
import Base from '../layouts/Base.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { loadDir } from '../lib/content.mjs';
export const page = { door: "family", topic: "veterans", label: "Veterans", summary: "The VA clinic and Vet Center on Commerce Drive, and 24/7 help lines" };
const all = loadDir('resources');
const r = (slug) => all.find((e) => e.slug === slug);
---
<Base title="Veterans in Morgantown and Mon County: VA clinic, Vet Center and help lines" description="The Monongalia County VA Clinic and the Morgantown Vet Center on Commerce Drive, when you need to go to Clarksburg, and 24/7 lines for crisis and housing help.">
  <h1>Help for veterans in Mon County</h1>
  <p class="lede">Two VA offices are on Commerce Drive, off US 19: a health clinic and a Vet Center for counseling. In a crisis, dial 988 and press 1, any time.</p>

  {r('veterans-crisis-line') && <ResourceCard r={r('veterans-crisis-line')} sms="838255" smsLabel="Veterans Crisis Line" lead="In crisis or worried about a veteran? Dial 988, then press 1." />}

  <h2>Health care: the VA clinic</h2>
  <p>For care this clinic does not offer, VA Clarksburg's main medical center is in Clarksburg (address and phone below). The VA works with Disabled American Veterans and county veterans affairs directors on van rides to scheduled medical appointments. Ask the clinic about rides.</p>
  {r('monongalia-county-va-clinic') && <ResourceCard r={r('monongalia-county-va-clinic')} showCost />}

  <h2>Counseling: the Vet Center</h2>
  <p>Free and confidential, and not a medical office.</p>
  {r('morgantown-vet-center') && <ResourceCard r={r('morgantown-vet-center')} />}

  <h2>Losing your housing, or already homeless</h2>
  {r('va-homeless-veterans-line') && <ResourceCard r={r('va-homeless-veterans-line')} />}

  <p>Other help near home, for anyone: <a href="tel:211">call 211</a> for food, bills and housing help, or see <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/turning-65/`}>Turning 65 or on Medicare</a>.</p>

  <p class="meta">VA sources checked October 30, 2026. Call before you go, since hours can change. We describe these services; we do not handle VA claims or speak for the VA. Something out of date? <a href="https://github.com/david-shortman/mon-county-community-hub/issues/new?template=suggest-resource.yml">Tell us</a>.</p>
</Base>
