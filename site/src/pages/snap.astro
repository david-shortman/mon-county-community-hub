---
import Base from '../layouts/Base.astro';
import AnswerFacts from '../components/AnswerFacts.astro';
import HelpNow from '../components/HelpNow.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { loadDir } from '../lib/content.mjs';
const office = loadDir('resources').find((e) => e.slug === 'monongalia-county-dohs-office');
export const page = { door: "this-month", topic: "food", label: "Apply for SNAP (food stamps)", summary: "Apply online at WV PATH, or call DoHS" };
---
<Base title="How to apply for SNAP (food stamps) in Monongalia County, WV" description="Apply for SNAP food help online at WV PATH, the state's free site, or call DoHS customer service. Steps, phone number and sources for Morgantown and Mon County.">
  <h1>How do I apply for SNAP (food stamps) in Mon County?</h1>
  <p class="lede">Apply online at WV PATH, the state's own site. It is free. If you have questions, call customer service at the state Department of Human Services (DoHS) at <a href="tel:18777161212">1-877-716-1212</a>, Monday to Friday, 8 a.m. to 5 p.m.</p>

  <AnswerFacts slug="apply-for-snap-wv-path" linkLabel="Apply at WV PATH" />

  <h2>Rather apply in person?</h2>
  {office && <ResourceCard r={office} />}

  <HelpNow />

  <p class="meta">We describe how to apply. The state decides who gets SNAP. Something out of date? <a href="https://github.com/david-shortman/mon-county-community-hub/issues/new?template=suggest-resource.yml">Tell us</a>.</p>
</Base>
