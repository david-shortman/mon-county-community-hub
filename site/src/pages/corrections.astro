---
// Corrections (#158): every fix to a fact, link or out-of-date detail, newest
// first, from content/corrections/. Counts under 10 show as "fewer than 10"
// (our measurement rules), and no reporter is ever named.
import Base from '../layouts/Base.astro';
import PromiseNumbers from '../components/PromiseNumbers.astro';
import { FIX_FORM } from '../lib/group-requests.mjs';
import { loadDir, prettyDate, ymd, todayYmd } from '../lib/content.mjs';
export const page = { door: "about", label: "Corrections", summary: "What we got wrong, what we fixed, and when" };
const KINDS = { fact: 'Fact fixed or removed', link: 'Broken or wrong link', outdated: 'Out of date', wording: 'Wording' };
const FOUND = { 'our-check': 'Found in our own check', 'works-there': 'Reported by someone who works there', helper: 'Reported by someone who helps people find services', 'used-it': 'Reported by someone who used it', other: 'Reported by a reader' };
const all = loadDir('corrections').map((c) => {
  for (const f of ['date', 'item', 'kind', 'found_by', 'what', 'link']) if (!c[f]) throw new Error(`${c._file}: needs ${f}`);
  if (!KINDS[c.kind]) throw new Error(`${c._file}: kind must be one of ${Object.keys(KINDS).join(', ')}`);
  if (!FOUND[c.found_by]) throw new Error(`${c._file}: found_by must be one of ${Object.keys(FOUND).join(', ')}`);
  return { ...c, date: ymd(c.date) };
}).sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : 0));
const month = todayYmd().slice(0, 7);
const thisMonth = all.filter((c) => c.date.startsWith(month));
const fromHelpers = thisMonth.filter((c) => c.found_by === 'works-there' || c.found_by === 'helper');
const count = (n) => (n < 10 ? 'fewer than 10' : String(n));
const monthName = new Intl.DateTimeFormat('en-US', { month: 'long', timeZone: 'UTC' }).format(new Date(`${month}-15T12:00:00Z`));
const report = 'https://github.com/david-shortman/mon-county-community-hub/issues/new?template=suggest-resource.yml';
---
<Base title="Corrections to Everything Morgantown" description="Every fix we have made to a fact, link or out-of-date detail on Everything Morgantown, newest first.">
  <h1>Corrections</h1>
  <p class="lede">When we get something wrong, we fix it and list it here, newest first. Typos are fixed without a note.</p>
  <p><strong>{monthName}:</strong> {thisMonth.length ? `${count(thisMonth.length)} fixes` : 'no fixes yet'}{fromHelpers.length > 0 && `, ${count(fromHelpers.length)} of them from people who work at these places or help others find services`}.</p>
  <p>See something wrong? Use our <a href={FIX_FORM}>fix or removal form</a>. You don't need an account, and what you send is not posted. You can also use the "Report a problem" link on the item, or <a href={report}>tell us on GitHub</a>. GitHub needs a free account, and reports there are public.</p>
  <PromiseNumbers />
  <h2>Every fix</h2>
  {all.length ? (
    <ol class="results">
      {all.map((c) => (
        <li><article class="card">
          <h3>{c.item}</h3>
          <p class="meta"><time datetime={c.date}>{prettyDate(c.date)}</time>. {KINDS[c.kind]}. {FOUND[c.found_by]}.</p>
          <p>{c.what}</p>
          <p class="meta">{c.page && <><a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}${c.page}`}>See the page<span class="sr-only"> for {c.item}</span></a>. </>}<a href={c.link}>The fix on GitHub<span class="sr-only"> for {c.item}</span></a>.</p>
        </article></li>
      ))}
    </ol>
  ) : <p>No corrections yet.</p>}
</Base>
