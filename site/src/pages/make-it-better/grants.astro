---
// Money for a project (#294): grants for beautification, art, trees and
// neighborhood projects. Each grant is a resource record; the at-a-glance
// lines restate the same source pages. A grant with no posted date says
// "next date not announced", never a guess.
import Base from '../../layouts/Base.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import NextRung from '../../components/NextRung.astro';
import { loadDir } from '../../lib/content.mjs';
import { fixFormUrl } from '../../lib/group-requests.mjs';
export const page = { door: "community", topic: "better", label: "Get money for a project", summary: "Small grants for neighborhood, art and tree projects: who can apply, how much, and the next date" };
const all = loadDir('resources');
const r = (slug) => all.find((e) => e.slug === slug);
const grants = [
  { slug: 'morgantown-mosaic-grants', name: 'Morgantown Mosaic', who: 'Neighbors and neighborhood associations in Morgantown', amount: 'Up to $500, or $2,000 for large projects', match: '1 to 1, up to half in volunteer time or donated materials', next: 'Next date not announced. The 2026 scoring dates have passed.' },
  { slug: 'wv-community-tree-grants', name: 'Community Tree Grants', who: 'Towns and cities, public schools and nonprofits', amount: 'Up to $50,000', match: 'None', next: 'Any time, while money lasts' },
  { slug: 'ycf-organizational-arts-grants', name: 'Organizational Arts Grants', who: 'Nonprofits in Monongalia County with an arts mission or an arts project', amount: 'Depends on the group (see the rules)', match: 'None listed', next: 'Next round expected to open in April 2027, per the foundation' },
  { slug: 'wv-arts-public-art-grants', name: 'State Public Art and Community Arts grants', who: 'Local governments and nonprofits (and schools, for Public Art)', amount: 'Public Art up to $7,500; mini grants up to $1,000', match: 'None listed', next: 'Public Art: not open, next date not announced. Mini grants: rolling' },
].filter((g) => r(g.slug));
---
<Base title="Money for a project: neighborhood, art and tree grants in Morgantown" description="Small grants for neighborhood, beautification, public art and tree projects in Morgantown and Monongalia County: Morgantown Mosaic, state Community Tree Grants, Organizational Arts Grants and state arts grants, with who can apply, amounts, match and next dates.">
  <h1>Get money for a project</h1>
  <p class="lede">A small grant can turn a neighbor's idea into a sign, a garden, a mural or new trees. Here is who can apply, how much, and when.</p>

  <h2>At a glance</h2>
  {grants.map((g) => (
    <article class="card">
      <h3><a href={`#${g.slug}`}>{g.name}</a></h3>
      <dl class="compare">
        <dt>Who can apply</dt><dd>{g.who}</dd>
        <dt>How much</dt><dd>{g.amount}</dd>
        <dt>Match</dt><dd>{g.match}</dd>
        <dt>Next date</dt><dd>{g.next}</dd>
      </dl>
    </article>
  ))}
  <p>Morgantown Mosaic is open to residents. The others go to groups, like nonprofits, schools or local governments.</p>

  <h2>Details and how to apply</h2>
  {grants.map((g) => <ResourceCard r={r(g.slug)} />)}

  <h2>Not listed yet</h2>
  <p>We have not listed a downtown facade program, because we could not confirm one is open on a current official page. State litter control grants go to county and town governments and solid waste authorities, not to residents.</p>

  <NextRung next="board" />
  <p class="meta">We describe these grants; we do not run them or help pick winners. Amounts and dates change, so read the grant's page before you apply. Know a grant we should add? <a href={fixFormUrl({ page: Astro.url.pathname })}>Tell us</a>.</p>
</Base>

<style>
  .compare { margin: 0; }
  .compare dt { font-weight: 700; }
  .compare dd { margin: 0 0 8px; }
</style>
