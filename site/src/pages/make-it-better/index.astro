---
// Make it better (#288): the hub for the Make it better section of the Your
// community door. It lists the ladder, from reporting a problem to helping
// shape the plans and budgets, and shows each step once its page exists.
import Base from '../../layouts/Base.astro';
import { loadPages } from '../../lib/pages.mjs';
export const page = { door: "community", topic: "better", label: "Make it better", summary: "Report a problem, adopt a street, find money for a project, or serve on a city board" };
const pages = await loadPages();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const steps = [
  { route: '/make-it-better/report/', text: 'Pothole, broken light or dumped trash? Find the office that fixes it.' },
  { route: '/make-it-better/cleanups/', text: 'Join a cleanup with neighbors.' },
  { route: '/make-it-better/adopt/', text: 'Look after one place over time, not just for one cleanup day.' },
  { route: '/make-it-better/grants/', text: 'Get a small grant or loan for a project.' },
  { route: '/make-it-better/boards/', text: 'Help shape the city\'s trees, parks, public art and historic buildings, on boards like the Tree Board.' },
  { route: '/make-it-better/when-it-gets-decided/', text: 'Know when plans and budgets get decided, and how to comment.' },
].filter((s) => pages.has(s.route)).map((s) => ({ ...s, label: pages.get(s.route).label }));
---
<Base title="Make it better: ways to improve Morgantown and Mon County" description="Ways to make Morgantown and Monongalia County better: report a problem to the right office, adopt a place, find money for a project, or serve on a city board.">
  <h1>Make it better</h1>
  <p class="lede">Ways to make your street, neighborhood and town nicer: fix problems, keep places clean and green, fund small projects, and have a say in city plans. Each step points to the office, program or group that does the work.</p>
  <ol class="ladder">
    {steps.map((s) => <li><a href={`${base}${s.route}`}><strong>{s.label}</strong></a>: {s.text}</li>)}
  </ol>
  <p class="meta">We describe how things work and who to contact. We do not take sides on what the city or county should do. Know a program we should add? <a href="https://github.com/david-shortman/mon-county-community-hub/issues/new?template=suggest-resource.yml">Tell us</a>.</p>
</Base>
