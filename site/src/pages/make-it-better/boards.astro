---
// Serve on a board (#290): city boards that shape how Morgantown looks and
// feels, open seats first. Built from content/boards. Open seat counts come
// from the city's vacancy list; when a board's own page shows a vacant seat
// the list does not, the card says who says what. No advice on who should
// apply, and no positions on what any board decides.
import Base from '../../layouts/Base.astro';
import Actions from '../../components/Actions.astro';
import SourceLine from '../../components/SourceLine.astro';
import NextRung from '../../components/NextRung.astro';
import { loadDir } from '../../lib/content.mjs';
export const page = { door: "community", topic: "better", label: "Serve on a city board", summary: "City boards that shape how Morgantown looks, which have open seats, and how to apply" };
const boards = loadDir('boards');
const open = boards.filter((b) => b.open_seats > 0);
const full = boards.filter((b) => !(b.open_seats > 0));
const applyOnline = 'https://arcg.is/4G8PK';
const applyPdf = 'https://www.morgantownwv.gov/DocumentCenter/View/5371/Updated-Board-and-Commission-Application';
const vacancyList = 'https://www.morgantownwv.gov/210/Volunteer-Opportunities';
const listSrc = [{ url: vacancyList, checked: '2026-10-30' }];
// Other boards with open seats on the city's vacancy list, as the list
// words them (checked October 30, 2026).
const others = [
  ['Board of Zoning Appeals', '1 alternate seat', 'City residents who have lived in the city at least 3 years'],
  ['Civilian Police Review and Advisory Board', '1 seat', 'City residents or people who work in the city'],
  ['Fairmont-Morgantown Housing Authority', '1 seat', 'A resident of public housing or a voucher user in the City of Fairmont'],
  ['Fire Code Board of Appeals', '1 seat and 2 alternate seats', 'City residents with a legal, building, design or fire background'],
  ['Human Rights Commission', '2 seats', 'City residents'],
  ['ICC Building Code Board of Appeals', '1 seat', 'An architect, engineer or building contractor'],
  ['Library Board', '1 seat', 'City residents'],
  ['Morgantown Utility Board', '1 seat', 'Residential customers of the Utility Board (some limits apply)'],
  ['Personnel Board', '3 seats', 'City residents'],
  ['Sister Cities Commission', '2 seats', 'City residents or people who work in the city'],
  ['Traffic Commission', '3 seats', 'City residents of the 2nd, 4th and 7th Wards'],
  ['Transit Authority', '1 seat', 'City residents (a joint city and county seat)'],
];
const seats = (n) => (n === 1 ? '1 open seat' : `${n} open seats`);
---
<Base title="Serve on a Morgantown city board: open seats and how to apply" description="City boards that help shape how Morgantown looks and feels, like the Urban Landscape Commission and Tree Board: what each one does, when it meets, which have open seats, and how to apply.">
  <h1>Serve on a city board</h1>
  <p class="lede">Help decide how Morgantown looks. City Council appoints residents to these boards. Some have open seats now.</p>

  <div class="note">
    <p><strong>How to apply:</strong> fill out the city's application <a href={applyOnline}>online</a>, or print the <a href={applyPdf}>paper application (PDF)</a> and return it to the City Clerk's office. Seats stay open until they are filled.</p>
  </div>
  <SourceLine sources={listSrc} about="how to apply" />

  <h2>Boards with open seats</h2>
  {open.map((b) => (
    <article class="card" id={b.slug}>
      <h3>{b.name}</h3>
      <p><strong>{seats(b.open_seats)}</strong> on the city's vacancy list.</p>
      <p>{b.decides}</p>
      {b.who_can_serve && <p><strong>Who can serve:</strong> {b.who_can_serve}</p>}
      <p><strong>Meets:</strong> {b.meets}</p>
      <Actions link={applyOnline} linkLabel="Apply online" about={b.name} />
      <p class="more"><a href={b.url}>The board's page<span class="sr-only">: {b.name}</span></a></p>
      <SourceLine sources={b.sources} org={b.org} about={b.name} />
    </article>
  ))}

  <h2>Boards with no open seats on the list</h2>
  <p>These boards are not on the city's vacancy list right now. Seats open as terms end, so check back.</p>
  {full.map((b) => (
    <article class="card" id={b.slug}>
      <h3>{b.name}</h3>
      {b.page_vacant > 0 && <p><strong>Sources differ:</strong> the board's own page shows {b.page_vacant === 1 ? '1 vacant seat' : `${b.page_vacant} vacant seats`}, but the city's vacancy list does not list it. Ask the City Clerk's office.</p>}
      <p>{b.decides}</p>
      {b.who_can_serve && <p><strong>Who can serve:</strong> {b.who_can_serve}</p>}
      <p><strong>Meets:</strong> {b.meets}</p>
      <p class="more"><a href={b.url}>The board's page<span class="sr-only">: {b.name}</span></a></p>
      <SourceLine sources={b.sources} org={b.org} about={b.name} />
    </article>
  ))}

  <h2>Other city boards with open seats</h2>
  <p>These boards are not mainly about how the city looks, but they also have open seats on the city's list.</p>
  <ul>
    {others.map(([name, n, who]) => <li><strong>{name}:</strong> {n}. {who}.</li>)}
  </ul>
  <p class="more"><a href={vacancyList}>The city's full vacancy list</a></p>
  <SourceLine sources={listSrc} about="the other open seats" />

  <NextRung next="budget" />
  <p class="meta">We list open seats as the city posts them. We do not say who should apply or take positions on what any board decides. Seat counts change, so check the city's list before you apply. Something out of date? <a href="https://github.com/david-shortman/mon-county-community-hub/issues/new?template=suggest-resource.yml">Tell us</a>.</p>
</Base>
