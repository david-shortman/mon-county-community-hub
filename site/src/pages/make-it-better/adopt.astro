---
// Adopt a place (#293): the adopt programs side by side. Each program's
// facts come from its resource record's sources; the short compare lines
// below restate those same pages. Ends with the next rung.
import Base from '../../layouts/Base.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import NextRung from '../../components/NextRung.astro';
import { loadDir } from '../../lib/content.mjs';
import { FIX_FORM } from '../../lib/group-requests.mjs';
export const page = { door: "community", topic: "better", label: "Adopt a street, spot, stream or trail", summary: "Compare the adopt programs: what you take on, for how long, and what you get" };
const all = loadDir('resources');
const r = (slug) => all.find((e) => e.slug === slug);
const programs = [
  { slug: 'morgantown-adopt-a-street', name: 'Adopt-A-Street', place: 'A street the City of Morgantown maintains', length: 'Renew each fall', often: 'At least 4 cleanups a year', get: 'A sign with your name (after 4 cleanups a year), curbside pickup of bagged trash, safety vests to borrow. Bring your own bags.', runs: 'City of Morgantown' },
  { slug: 'wv-adopt-a-highway', name: 'Adopt-A-Highway or Adopt-A-Spot', place: '2 miles of a state road, or a spot up to a quarter mile', length: '2 years, can renew', often: 'At least 2 cleanups a year, 30 days apart', get: 'A sign, bags, gloves, safety vests, and the state takes the bagged trash', runs: 'West Virginia DEP (REAP)' },
  { slug: 'wv-adopt-a-stream', name: 'Adopt-A-Stream', place: 'At least 1 mile of a stream', length: '3 years, can renew', often: 'At least 1 cleanup a year', get: 'Bags and gloves, and the state takes the bagged trash', runs: 'West Virginia DEP (REAP)' },
  { slug: 'boparc-trail-cleanups', name: 'BOPARC trail cleanups', place: 'A BOPARC trail, one cleanup at a time (not an adoption)', length: 'One event', often: 'When you plan one', get: 'BOPARC approves the event. Public events need proof of liability insurance.', runs: 'BOPARC' },
].filter((p) => r(p.slug));
---
<Base title="Adopt a street, highway, spot, stream or trail in Morgantown and Mon County" description="Compare Morgantown's Adopt-A-Street, the state's Adopt-A-Highway, Adopt-A-Spot and Adopt-A-Stream, and BOPARC trail cleanups: what you adopt, for how long, how often you clean, and what you get.">
  <h1>Adopt a street, spot, stream or trail</h1>
  <p class="lede">Adopting a place turns one cleanup into a promise to keep it clean. Here is how the programs compare.</p>

  <h2>Side by side</h2>
  {programs.map((p) => (
    <article class="card">
      <h3><a href={`#${p.slug}`}>{p.name}</a></h3>
      <dl class="compare">
        <dt>What you adopt</dt><dd>{p.place}</dd>
        <dt>How long</dt><dd>{p.length}</dd>
        <dt>How often you clean</dt><dd>{p.often}</dd>
        <dt>What you get</dt><dd>{p.get}</dd>
        <dt>Who runs it</dt><dd>{p.runs}</dd>
      </dl>
    </article>
  ))}

  <h2>How to start</h2>
  {programs.map((p) => <ResourceCard r={r(p.slug)} />)}

  {r('wv-make-it-shine') && <h2>Not ready to adopt? Join a one-time cleanup</h2>}
  {r('wv-make-it-shine') && <ResourceCard r={r('wv-make-it-shine')} />}

  <NextRung next="fund" />
  <p class="meta">We describe these programs; we do not run them. Rules can change, so read the program's page before you sign up. Know another adopt program here? <a href={FIX_FORM}>Tell us</a>.</p>
</Base>

<style>
  .compare { margin: 0; }
  .compare dt { font-weight: 700; }
  .compare dd { margin: 0 0 8px; }
</style>
