---
// Work and learning (#226, part of #210). First slice: job help and free
// adult literacy. Adult education classes, apprenticeships and reentry help
// are next; see the issue.
import Base from '../layouts/Base.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { loadDir } from '../lib/content.mjs';
import { fixFormUrl } from '../lib/group-requests.mjs';
export const page = { door: "family", topic: "work", label: "Work and learning", summary: "Job help, apprenticeships, help with a record or recovery, adult classes, and free English lessons" };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = loadDir('resources');
const r = (slug) => all.find((e) => e.slug === slug);
---
<Base title="Jobs and learning in Morgantown and Mon County: job help, high school equivalency, adult classes" description="Job help at WorkForce West Virginia, high school equivalency and English classes and evening classes at MTEC, and free reading and English lessons from Literacy Volunteers.">
  <h1>Work and learning</h1>
  <p class="lede">Looking for a job or training? Start with WorkForce West Virginia on Commerce Drive. To finish high school or learn English, call MTEC adult education. Literacy Volunteers teaches adults to read and write for free.</p>

  <h2>Find a job or job training</h2>
  {r('workforce-wv-morgantown-office') && <ResourceCard r={r('workforce-wv-morgantown-office')} />}
  <p>Where local employers post jobs, and free help with a resume: see <a href={`${base}/find-a-job/`}>Find a job</a>. To get training or school paid for, see <a href={`${base}/pay-for-training/`}>Get training or school paid for</a>.</p>

  <h2>Ages 16 to 24 and out of school</h2>
  {r('region-vi-career-connections') && <ResourceCard r={r('region-vi-career-connections')} />}
  <p>Still in high school, or 14 or 15 and looking for a first job? See <a href={`${base}/teens/`}>Teens: first jobs, driving and things to do</a>.</p>

  <h2>Get paid while you learn a trade</h2>
  {r('apprenticeships-wv') && <ResourceCard r={r('apprenticeships-wv')} showCost />}
  <p>Already work in a trade? See <a href={`${base}/contractor-license/`}>contractor and trade licenses</a>.</p>

  <h2>A record, recovery, or no ID making it hard to get hired</h2>
  {r('federal-bonding-wv') && <ResourceCard r={r('federal-bonding-wv')} />}
  {r('jobs-and-hope-wv') && <ResourceCard r={r('jobs-and-hope-wv')} />}

  <h2>Finish high school, or learn English</h2>
  {r('mtec-adult-education-esl') && <ResourceCard r={r('mtec-adult-education-esl')} showCost />}

  <h2>Evening classes for job skills</h2>
  {r('mtec-adult-evening-classes') && <ResourceCard r={r('mtec-adult-evening-classes')} showCost />}

  <h2>Reading, writing and English for adults</h2>
  {r('lvmpc-adult-literacy') && <ResourceCard r={r('lvmpc-adult-literacy')} sms="724-491-2007" smsLabel="Literacy Volunteers" />}

  <p>Staying healthy: see <a href={`${base}/staying-well/`}>Staying well: a simple list</a>. Need help with food or bills while you look for work? <a href="tel:211">Call 211</a>.</p>

  <p class="meta">Sources checked October 30, 2026. We describe these services; we do not place people in jobs or classes. Something out of date? <a href={fixFormUrl({ page: Astro.url.pathname })}>Tell us</a>.</p>
</Base>
