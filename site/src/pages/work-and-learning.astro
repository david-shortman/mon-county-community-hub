---
// Work and learning (#226, part of #210). First slice: job help and free
// adult literacy. Adult education classes, apprenticeships and reentry help
// are next; see the issue.
import Base from '../layouts/Base.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { loadDir } from '../lib/content.mjs';
export const page = { door: "family", topic: "work", label: "Work and learning", summary: "Job help, job training, and free reading and English lessons for adults" };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = loadDir('resources');
const r = (slug) => all.find((e) => e.slug === slug);
---
<Base title="Jobs and learning in Morgantown and Mon County: job help and free adult lessons" description="Find job help and training at WorkForce West Virginia in Westover, and free reading, writing and English lessons for adults from Literacy Volunteers.">
  <h1>Work and learning</h1>
  <p class="lede">Looking for a job or training? Start with WorkForce West Virginia on Commerce Drive. Want to read, write or speak English better? Literacy Volunteers teaches adults for free.</p>

  <h2>Find a job or job training</h2>
  {r('workforce-wv-morgantown-office') && <ResourceCard r={r('workforce-wv-morgantown-office')} />}

  <h2>Reading, writing and English for adults</h2>
  {r('lvmpc-adult-literacy') && <ResourceCard r={r('lvmpc-adult-literacy')} sms="724-491-2007" smsLabel="Literacy Volunteers" />}

  <p>Staying healthy: see <a href={`${base}/staying-well/`}>Staying well: a simple list</a>. Need help with food or bills while you look for work? <a href="tel:211">Call 211</a>.</p>

  <p class="meta">Sources checked October 30, 2026. We describe these services; we do not place people in jobs or classes. Something out of date? <a href="https://github.com/david-shortman/mon-county-community-hub/issues/new?template=suggest-resource.yml">Tell us</a>.</p>
</Base>
