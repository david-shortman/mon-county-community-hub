---
import Base from '../layouts/Base.astro';
import HelpNow from '../components/HelpNow.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base noindex title="Page not found" description="That page was not found. Go to the home page or the dates and deadlines calendar.">
  <h1>We could not find that page</h1>
  <p class="lede">The link may be old or mistyped. These pages should help.</p>
  <p class="actions">
    <a class="btn" href={`${base}/`}>Go to the home page</a>
    <a class="btn" href={`${base}/calendar/`}>See dates and deadlines</a>
  </p>
  <HelpNow />
</Base>
<style is:global>
  /* Not found (#396, Press look): a Log Cabin quilt block, our plainest
     "nothing here" mark, above the title. Our own drawing; the page sets the color. */
  main:has(> section.note #help-now-h) > h1::before {
    content: ""; display: block; width: 56px; height: 56px; margin: 0 0 var(--s4);
    background: var(--rust);
    -webkit-mask: url("/marks/log-cabin.svg") center / contain no-repeat; mask: url("/marks/log-cabin.svg") center / contain no-repeat;
  }
  @media (forced-colors: active) { main > h1::before { display: none; } }
</style>
