---
// Free tax filing help and tax credits for working households (#987, #209).
// Every fact is in a resource record in content/resources/, read 2026-10-31.
// No 2027 dates are shown until each program posts them. Money topic: the PR
// waits for David.
import Base from '../layouts/Base.astro';
import { fixFormUrl } from '../lib/group-requests.mjs';
import ResourceCard from '../components/ResourceCard.astro';
import { loadDir } from '../lib/content.mjs';
export const page = { door: "this-month", topic: "money", label: "Free help filing your taxes", summary: "Free tax prep near Morgantown, filing free online, the EITC and the WV Family Tax Credit" };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = loadDir('resources');
const r = (slug) => all.find((e) => e.slug === slug);
---
<Base help title="Free help filing your taxes in Morgantown and Mon County, WV" description="Free tax return help near Morgantown from IRS-certified volunteers, free online filing through IRS Free File and West Virginia's Free File list, and the Earned Income Tax Credit and West Virginia Family Tax Credit, with sources.">
  <h1>Free help filing your taxes</h1>
  <p class="lede">You can file for free, on your own online or with a trained volunteer. Below: free tax help near Morgantown, free filing websites, and two tax credits for working households. Most dates for the 2027 tax season are not posted yet. When a program says when to check back, its card says so.</p>

  <h2>Get a volunteer to do your taxes, free</h2>
  {r('christian-help-free-tax-prep') && <ResourceCard r={r('christian-help-free-tax-prep')} />}
  {r('irs-vita-tce') && <ResourceCard r={r('irs-vita-tce')} />}
  {r('aarp-tax-aide') && <ResourceCard r={r('aarp-tax-aide')} />}

  <h2>File your own return online, free</h2>
  {r('irs-free-file') && <ResourceCard r={r('irs-free-file')} />}
  {r('wv-free-file-options') && <ResourceCard r={r('wv-free-file-options')} />}

  <h2>Tax credits to check for</h2>
  <p>A tax credit lowers the tax you owe. Some can also add to your refund. The tax agency decides who gets each credit.</p>
  {r('irs-eitc') && <ResourceCard r={r('irs-eitc')} />}
  {r('wv-family-tax-credit') && <ResourceCard r={r('wv-family-tax-credit')} />}

  <h2>Also check</h2>
  <ul>
    <li>Help with food: <a href={`${base}/snap/`}>apply for SNAP</a>.</li>
    <li>Help with a bill, rent or cash fast: <a href={`${base}/money/`}>Get through this month</a>.</li>
  </ul>

  <p class="meta">Sources checked October 31, 2026. We describe these programs; each one decides who it helps. Dates and rules change each tax season, so check the program's own page before you go. Something out of date? <a href={fixFormUrl({ page: Astro.url.pathname })}>Tell us</a>.</p>
</Base>
