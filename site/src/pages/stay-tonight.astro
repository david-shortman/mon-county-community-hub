---
// Help now (#175, the urgent lane in #248), on the crisis pattern from
// docs/design/presentation.md: the crisis strip and quick exit (#174) on top,
// four big choices, then places. Only real, sourced places from
// content/resources/; where we have none, the section says so and points to
// 211. No script needed. The /stay-tonight/ link stays the same.
import Base from '../layouts/Base.astro';
import PlaceCard from '../components/PlaceCard.astro';
import HelpNowSources from '../components/HelpNowSources.astro';
import Icon from '../components/Icon.astro';
import Actions from '../components/Actions.astro';
import { resource, telHref } from '../lib/content.mjs';
import { fixFormUrl } from '../lib/group-requests.mjs';
import SourceLine from '../components/SourceLine.astro';
import { loadTonight, checkedWhen } from '../lib/tonight.mjs';
export const page = { door: "help-now", label: "Where to stay tonight", summary: "A bed tonight, a warm place, food tonight, or safe from someone" };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const grace = resource('grace-shelter');
const rainbow = resource('rainbow-house');
const rdvic = resource('rdvic-hotline');
const r211 = resource('wv-211');
const r988 = resource('988-lifeline');
// The warming shelter box reads the same file as /tonight/ (#219), so one
// refresh updates both pages. Only "not announced" and "season over" are
// spelled out here. Open or closed tonight changes daily, so this page sends
// people to /tonight/, which checks the date again on the phone.
const ws = loadTonight();
const wsWhen = checkedWhen(ws).replace(/\.$/, '');
const wsText = {
  'not-announced': ws.note,
  'season-over': 'It is closed for the season.',
}[ws.status] ?? 'The season has started. Whether it is open changes night to night, so see tonight\'s status below for where, hours and rules.';
const choices = [
  { href: '#bed', label: 'A bed tonight', icon: 'bed' },
  { href: '#warm', label: 'A warm place right now', icon: 'home' },
  { href: '#food', label: 'Food tonight', icon: 'food' },
  { href: '#safe', label: 'Safe from someone', icon: 'people' },
];
---
<Base crisis title="Where to stay tonight in Morgantown, WV" description="A bed tonight, a warm place, food tonight, or safety from someone, in Morgantown and Monongalia County: emergency shelter, a 24-hour hotline, and 211.">
  <h1>Where to stay tonight</h1>
  <p class="lede">Tap what you need.</p>

  <nav aria-label="What do you need?">
    <ul class="choices4">
      {choices.map((c) => <li><a href={c.href}><Icon name={c.icon} /><span>{c.label}</span></a></li>)}
    </ul>
  </nav>

  <section class="need" id="bed" aria-labelledby="bed-h">
    <h2 id="bed-h">A bed tonight</h2>
    <PlaceCard r={grace} />
    <PlaceCard r={rainbow} />
    <p>Full, or not for you? Call <a href={telHref(r211.contact.phone)}>211</a>. They know who has room.</p>
  </section>

  <section class="need" id="warm" aria-labelledby="warm-h">
    <h2 id="warm-h">A warm place right now</h2>
    <p>We have not found a sourced daytime warming place to list yet. <a href="#bed">Grace Shelter</a> is for adults. {grace.hours}. Call to confirm. For other places to get warm, call <a href={telHref(r211.contact.phone)}>211</a>.</p>
    <div class="note" id="warming-shelter" data-checked={ws.checkedDay} data-status={ws.status}>
      <p><strong>Winter warming shelter:</strong> {wsText} Call 211 for the latest. <span class="meta">Last checked {wsWhen}.</span></p>
      <SourceLine sources={ws.sources} about="the warming shelter status" />
    </div>
    <p>Is the warming shelter open tonight? See <a href={`${base}/tonight/`}>tonight's status</a>. It shows when we last checked.</p>
  </section>

  <section class="need" id="food" aria-labelledby="food-h">
    <h2 id="food-h">Food tonight</h2>
    <p>For free meals and food this week, see <a href={`${base}/help/food/by-day/`}>free food and meals by day</a> or <a href={`${base}/help/food/today/other/`}>food today or this week</a>. Or call or text <a href={telHref(r211.contact.phone)}>211</a> and ask what is open now.</p>
  </section>

  <section class="need" id="safe" aria-labelledby="safe-h">
    <h2 id="safe-h">Safe from someone</h2>
    <PlaceCard r={rdvic} />
    <p>Want to ask a court for protection? See <a href={`${base}/protective-orders/`}>protective orders</a>. Next steps after leaving, in order: <a href={`${base}/life-events/leaving-an-unsafe-home/`}>I'm leaving an unsafe home</a>.</p>
    <p>In danger right now? Call <a href="tel:911">911</a>. Thinking about suicide, or in a mental health crisis? Call or text 988, any hour.</p>
    <Actions callFirst phone={r988.contact.phone} phoneLabel={r988.title} sms={r988.contact.phone} smsLabel={r988.title} />
  </section>

  <section class="note" aria-labelledby="unsure-h">
    <h2 id="unsure-h">Not sure where to go?</h2>
    <p>Call <a href={telHref(r211.contact.phone)}>211</a>, text your ZIP code to <a href={`sms:${r211.contact.text.replace(/\D/g, '')}`}>{r211.contact.text}</a>, or chat at <a href={r211.contact.url}>wv211.org</a>. It is open {r211.hours.toLowerCase().replace(/^open /, '')}. If your phone can't reach 211 (some Wi-Fi calling phones can't), call <a href="tel:18338489905">1-833-848-9905</a>.</p>
  </section>

  <HelpNowSources />

  <p class="meta">Hours and bed counts can change. Call before you go. We describe these services and do not decide who can stay. Something out of date? <a href={fixFormUrl({ page: Astro.url.pathname })}>Tell us</a>.</p>
</Base>

<style>
  .choices4 { list-style: none; margin: 12px 0 8px; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .choices4 a { display: flex; flex-direction: column; justify-content: center; gap: 6px; min-height: 96px; padding: 12px; border-radius: 12px; background: var(--accent-bg); border: 2px solid var(--accent); color: var(--fg); text-decoration: none; font-weight: 700; line-height: 1.2; }
  .choices4 a:hover span { text-decoration: underline; }
  .choices4 .icon { color: var(--accent); width: 30px; height: 30px; }
  .need h2 { margin-top: 1.6em; }
  .place h3 { margin: 0 0 4px; font-size: 1.2rem; }
  .place .when { font-size: 1.05rem; }
</style>
