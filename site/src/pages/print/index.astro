---
// Printouts (#160, #405): the list of printable sheets and cards. Sheets are
// made from the listings every morning (print/[slug].astro).
import Base from '../../layouts/Base.astro';
import { fixFormUrl } from '../../lib/group-requests.mjs';
import { printSheets } from '../../lib/printouts.mjs';
export const page = { door: "about", label: "Printouts", summary: "Printable sheets of places and phone numbers, and cards with a QR code" };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = printSheets();
// Each door's sheet, with its topic sheets under it.
const sheets = all.filter((s) => s.kind === 'door').map((d) => ({ ...d, n: d.list.length, sub: all.filter((t) => t.kind === 'topic' && t.door === d.slug).map((t) => ({ ...t, n: t.list.length })) }));
---
<Base title="Printouts: sheets and cards for Mon County help" description="Free printable sheets of places and phone numbers in Morgantown and Monongalia County, made from our listings every morning, plus wallet cards and posters with a QR code.">
  <h1>Printouts</h1>
  <p class="lede">For people who help others: librarians, pantry and church volunteers, teachers, nurses, neighbors. Print a sheet and hand it to someone who does not use the internet much.</p>
  <p>Each sheet is made from our listings every morning, so it is as current as the site. It says the date it was made and has a QR code with the web address printed beside it. Things change, so the sheet tells people to call first.</p>

  <h2>Sheets of places and phone numbers</h2>
  <ul class="topic-list">
    {sheets.map((s) => (
      <li>
        <a href={`${base}/print/${s.slug}/`}>{s.name}</a><span class="hint">{s.n} places and programs</span>
        {s.sub.length > 0 && <ul>{s.sub.map((t) => <li><a href={`${base}/print/${t.slug}/`}>{t.name}</a> <span class="hint">{t.n} places and programs</span></li>)}</ul>}
      </li>
    ))}
  </ul>

  <h2>Cards and posters</h2>
  <p><a href={`${base}/print/cards/`}>Wallet cards and half-page posters</a> for Where to stay tonight, Food help and Help paying a utility bill, each with a QR code and a short web address.</p>

  <h2>Any single listing</h2>
  <p>Most listings on the site have a "Print this" button that prints just that one listing.</p>

  <p class="meta">Printouts are free to copy and hand out. Please do not change the phone numbers or hours: if something is wrong, <a href={fixFormUrl({ page: Astro.url.pathname })}>tell us</a> and we will fix it at the source.</p>
</Base>
