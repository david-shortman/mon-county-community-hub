---
// Public meetings: agendas and minutes from the City of Morgantown
// AgendaCenter (#12) and the Monongalia County Commission (#13). Read from the city's page at every build, with a saved
// copy if it is down (src/lib/meetings). Says only what the AgendaCenter
// lists: the board, the meeting date, the agenda and the minutes. No
// summaries of what was decided, and no views on any board.
import Base from '../layouts/Base.astro';
import SourceLine from '../components/SourceLine.astro';
import { loadMeetings } from '../lib/meetings/index.mjs';
import { prettyDate, todayYmd } from '../lib/content.mjs';
export const page = { door: "community", topic: "government", label: "City and county meetings: agendas and minutes", summary: "Morgantown City Council, city boards and the County Commission: posted agendas for coming meetings, and minutes from recent ones" };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const today = todayYmd();
const meetings = await loadMeetings();
const agendaCenter = 'https://www.morgantownwv.gov/AgendaCenter';
const countyPage = 'https://www.monongaliacounty.gov/commission/meeting_schedule/index.php';
const checkedFor = (url) => meetings.find((m) => m.sources[0]?.url === url)?.sources[0]?.checked ?? today;
const sources = [{ url: agendaCenter, checked: checkedFor(agendaCenter) }, { url: countyPage, checked: checkedFor(countyPage) }];
// Bodies whose records we link but do not read, each checked by hand (#13).
const OTHER_CHECKED = '2026-10-30';
const others = [
  { name: 'Monongalia County Board of Education', url: 'https://go.boarddocs.com/wv/mono/Board.nsf/Public', link: 'Agendas and minutes on BoardDocs', note: 'That site does not let this page read it, so open the link to see the meetings.' },
  { name: 'Star City Town Council', url: 'https://www.starcitywv.com/minutes/', link: 'Signed council minutes, by year', note: 'We found no agendas posted.' },
  { name: 'Granville Town Council', url: 'https://townofgranvillewv.gov/meeting-minutes-agendas', link: 'Council agendas and minutes', note: 'Posted as Word files.' },
  { name: 'Westover City Council, Planning Commission and Sewer Board', url: 'https://www.westoverwv.org/', link: 'Minutes, in shared folders linked from the city home page', note: 'We found no agendas posted.' },
];
const ahead = meetings.filter((m) => m.date >= today);
const since = (() => { const d = new Date(`${today}T12:00:00Z`); d.setUTCDate(d.getUTCDate() - 60); return d.toISOString().slice(0, 10); })();
const recent = meetings.filter((m) => m.date < today && m.date >= since).reverse();
// Group recent meetings by board, boards in A to Z order.
const byBody = [...new Set(recent.map((m) => m.body))].sort((a, b) => a.localeCompare(b)).map((body) => ({ body, items: recent.filter((m) => m.body === body) }));
const id = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
<Base title="Morgantown and Mon County meetings: agendas and minutes" description="Posted agendas for coming Morgantown City Council, city board and Monongalia County Commission meetings, minutes from recent ones, and where towns and the school board post theirs.">
  <h1>City and county meetings: agendas and minutes</h1>
  <p class="lede">The City of Morgantown and the Monongalia County Commission post meeting agendas on their websites, and the city posts minutes too. This page lists what they have posted, so you can see what is coming up and what happened.</p>

  <div class="note">
    <p>Open the agenda to see when and where a meeting is. Plans can change, so check it before you go. Dates of meetings that have no agenda yet are on the <a href={`${base}/calendar/`}>Dates page</a>.</p>
  </div>

  <h2 id="coming">Agendas posted for coming meetings</h2>
  {ahead.length ? (
    <ul>
      {ahead.map((m) => (
        <li><strong>{prettyDate(m.date)}</strong>, {m.body}: <a href={m.agenda_url}>{m.title}</a> (agenda, usually a PDF)</li>
      ))}
    </ul>
  ) : (
    <p>No agendas are posted yet for coming meetings. Check back closer to the meeting date.</p>
  )}

  <h2 id="recent">Recent meetings, last 60 days</h2>
  <p>Agendas and minutes open as files, usually PDFs.</p>
  {byBody.length ? byBody.map(({ body, items }) => (
    <section aria-labelledby={id(body)}>
      <h3 id={id(body)}>{body}</h3>
      <ul>
        {items.map((m) => (
          <li>{prettyDate(m.date)}: <a href={m.agenda_url}>agenda<span class="sr-only">, {body}, {prettyDate(m.date)}</span></a>{m.minutes_url ? <>, <a href={m.minutes_url}>minutes<span class="sr-only">, {body}, {prettyDate(m.date)}</span></a></> : m.publisher === 'Monongalia County Commission' ? ', no minutes on the county page' : ', no minutes posted yet'} ({m.title})</li>
        ))}
      </ul>
    </section>
  )) : <p>No meetings were listed in the last 60 days.</p>}

  <h2 id="others">Schools and towns</h2>
  <p>These bodies post their records in other places. We link to them but do not list each meeting yet.</p>
  <ul>
    {others.map((o) => <li><strong>{o.name}:</strong> <a href={o.url}>{o.link}</a>. {o.note}</li>)}
  </ul>
  <SourceLine sources={others.map((o) => ({ url: o.url, checked: OTHER_CHECKED }))} about="schools and towns" />

  <h2 id="about">Where this comes from</h2>
  <p>Every day, this site reads the City of Morgantown's <a href={agendaCenter}>AgendaCenter</a>, which also holds agendas for some regional bodies like the Morgantown Utility Board and the Library Board, and the County Commission's <a href={countyPage}>meeting schedule and agendas</a> page. That page says the Commission meets at 10 a.m. on Wednesdays, with a work session after. We link to the official files and do not summarize them. Minutes show up here once they are posted. The same list is in the <a href={`${base}/data/`}>open data</a> as meetings.json.</p>
  <SourceLine sources={sources} about="city meetings" />
</Base>
