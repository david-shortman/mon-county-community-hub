---
// Get training or school paid for (#648, #649, #606, part of #275 and #276).
// WIOA scholarships, WV Invests, the Future Workforce Grant and Jumpstart
// Savings, each quoted from its own official page. Money: waits for David.
import Base from '../layouts/Base.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { loadDir } from '../lib/content.mjs';
export const page = { door: "family", topic: "work", label: "Get training or school paid for", summary: "WIOA training scholarships, the WV Invests and Future Workforce grants, and Jumpstart Savings for tools and licenses" };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hasFindAJob = Object.keys(import.meta.glob('./find-a-job.astro')).length > 0;
const all = loadDir('resources');
const r = (slug) => all.find((e) => e.slug === slug);
---
<Base title="Get job training or college paid for in Morgantown and Mon County, WV" description="Programs that can pay for job training or a two-year degree for people in Morgantown and Monongalia County: Region VI WIOA training scholarships, the WV Invests Grant, the WV Future Workforce Grant, and Jumpstart Savings for tools and licenses.">
  <h1>Get training or school paid for</h1>
  <p class="lede">These programs can pay for job training or a two-year degree. Each one has its own rules. Read them, then call or apply. Most ask you to fill out the FAFSA, the federal student aid form, first.</p>

  <h2>Job training, through the job center</h2>
  {r('wioa-training-scholarships-region-vi') && <ResourceCard r={r('wioa-training-scholarships-region-vi')} />}

  <h2>A certificate or two-year degree</h2>
  {r('wv-invests-grant') && <ResourceCard r={r('wv-invests-grant')} />}

  <h2>A short training or credential</h2>
  {r('wv-future-workforce-grant') && <ResourceCard r={r('wv-future-workforce-grant')} />}

  <h2>Save for tools and licenses in the trades</h2>
  {r('wv-jumpstart-savings') && <ResourceCard r={r('wv-jumpstart-savings')} showCost />}

  <p>Looking for a training to pay for? See {hasFindAJob && <><a href={`${base}/find-a-job/`}>Find a job</a> for short trainings and apprenticeships, and </>}<a href={`${base}/work-and-learning/`}>Work and learning</a> for adult classes. Key dates, like the WV Invests April 15 priority deadline, are on <a href={`${base}/calendar/`}>Dates</a>.</p>

  <p class="meta">Sources checked October 30, 2026. Rules and amounts are as each program's own page gives them. Programs can change their rules or run out of money, so check the program's page before you count on it. Something out of date? <a href="https://github.com/david-shortman/mon-county-community-hub/issues/new?template=suggest-resource.yml">Tell us</a>.</p>
</Base>
