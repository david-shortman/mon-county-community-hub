---
// Start a business in Morgantown, step by step (#639, part of #277). Each step
// says only what its official page says, and links to it. Fees and taxes:
// this page waits for David. Lane 16 owns license and permit pages (#605,
// #661); this page links the city's own pages and reuses the existing
// license record instead of writing a competing one.
// Not here: the city license fee, B&O rates and due dates (not on a current
// city page, see #638).
// Every step, food permits and City Hall read from fact records in
// content/facts/business/ (#122), each with its own checked date.
import Base from '../layouts/Base.astro';
import ResourceCard from '../components/ResourceCard.astro';
import Icon from '../components/Icon.astro';
import Route from '../components/Route.astro';
import Fact from '../components/Fact.astro';
import { factsFor } from '../lib/facts.mjs';
import Milepost from '../components/Milepost.astro';
import { resource } from '../lib/content.mjs';
import { fixFormUrl } from '../lib/group-requests.mjs';
export const page = { door: "family", topic: "work", label: "Start a business in Morgantown, step by step", summary: "Zoning, state registration, the city license, the Certificate of Occupancy, inspections and city B&O tax, in order" };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fact = factsFor('business');
---
<Base title="Start a business in Morgantown, WV, step by step" description="Morgantown's steps to open a business, in order: zoning, state registration, a city license, a Certificate of Occupancy, inspections and B&O tax.">
  <h1>Start a business in Morgantown, step by step</h1>
  <p class="lede">These are the steps the City of Morgantown lists for a business inside city limits, in order. Each step links to the official page. Tap a step to open it. If your business is in Star City, Granville, Westover or outside any town, the local steps are different, so ask that town or the county. Free help with planning is on <a href={`${base}/business/`}>Start or grow a business</a>.</p>

  <Route label="Steps to start a business in Morgantown">
  <Milepost n={1} title="Check the zoning" id="zoning" open>
  <Fact f={fact('zoning')} about="Step 1, zoning" />

  </Milepost>

  <Milepost n={2} title="Register with the state" id="state">
  {resource('wv-one-stop-business-registration') && <ResourceCard r={resource('wv-one-stop-business-registration')} showCost />}
  <Fact f={fact('state-registration')} about="Step 2, state Business Registration Certificate" />
  <ul>
    <Fact tag="li" f={fact('state-fee-exempt')} about="who pays no registration fee" />
    <Fact tag="li" f={fact('state-no-certificate')} about="when no certificate is needed" />
    <Fact tag="li" f={fact('state-certificate-lasts')} about="how long the certificate lasts" />
  </ul>
  <Fact f={fact('state-tax-help')} about="state tax help lines" />
  <div class="actions">
    <a class="btn" href="https://tax.wv.gov/Business/BusinessRegistration/Pages/BusinessRegistrationQuestionsAndAnswers.aspx"><Icon name="open" /><span>Tax Division questions and answers</span></a>
  </div>

  </Milepost>

  <Milepost n={3} title="Apply for a city business license" id="license">
  <Fact f={fact('city-license')} about="Step 3, city business license" />
  <Fact f={fact('city-license-help')} about="Step 3, license questions" />
  <div class="actions">
    <a class="btn" href="https://www.morgantownwv.gov/747/Permitting-Licensing-Registration"><Icon name="open" /><span>City permitting and licensing page</span></a>
  </div>

  </Milepost>

  <Milepost n={4} title="Apply for a Certificate of Occupancy" id="occupancy">
  <Fact f={fact('occupancy-who')} about="Step 4, who needs a Certificate of Occupancy" />
  <Fact f={fact('occupancy-bring')} about="Step 4, what to bring" />
  <Fact f={fact('occupancy-inspection')} about="Step 4, after you apply" />

  </Milepost>

  <Milepost n={5} title="Get inspected before you open" id="inspection">
  <Fact f={fact('inspection-before-opening')} about="Step 5, inspections" />

  </Milepost>

  <Milepost n={6} title="File city B&O tax" id="bo-tax">
  <Fact f={fact('bo-tax-forms')} about="Step 6, city B&O tax returns" />
  <Fact f={fact('bo-tax-help')} about="Step 6, B&O questions" />
  <div class="actions">
    <a class="btn" href="https://www.morgantownwv.gov/204/Business-Occupation-Tax-Returns"><Icon name="open" /><span>City B&O tax forms</span></a>
  </div>

  </Milepost>
  </Route>

  <h2>Selling food?</h2>
  <Fact f={fact('food-permits')} about="Food permits" />

  <h2>All the city's steps in one card</h2>
  {resource('morgantown-business-license') && <ResourceCard r={resource('morgantown-business-license')} />}

  <Fact f={fact('city-hall')} about="City Hall contact" />

  <p class="meta">Each part shows the date we last checked its source. Fees and rules can change, so check the official page before you pay or file. We describe the steps; we do not decide what applies to your business. Something out of date? <a href={fixFormUrl({ page: Astro.url.pathname })}>Tell us</a>.</p>
</Base>
