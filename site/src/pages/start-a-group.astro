---
// Start a nonprofit or community group in West Virginia (#610, part of #280).
// Official steps only, each from a Secretary of State page or form. Form
// CD-1NP and the annual report date and fee are on the incorporation card
// (settled in #1315, closing #798). The IRS step is fact records (#122).
import Base from '../layouts/Base.astro';
import ResourceCard from '../components/ResourceCard.astro';
import Fact from '../components/Fact.astro';
import { factsFor } from '../lib/facts.mjs';
import Route from '../components/Route.astro';
import Milepost from '../components/Milepost.astro';
import { resource } from '../lib/content.mjs';
import { fixFormUrl } from '../lib/group-requests.mjs';
export const page = { door: "community", topic: "community", label: "Start a nonprofit or community group", summary: "State steps to make a group a nonprofit corporation, register before asking for donations, and where federal tax-exempt status starts" };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const r = (slug) => resource(slug);
const fact = factsFor('start-a-group');
---
<Base title="Start a nonprofit or community group in Mon County, WV" description="The official West Virginia steps to start a nonprofit or group in Morgantown or Mon County: incorporate, register before asking for donations, and IRS status.">
  <h1>Start a nonprofit or community group</h1>
  <p class="lede">Want to start a group with your neighbors? The state steps below are for a group that wants to become a nonprofit corporation, or that will ask the public for money. Each step links to the state's own page. Tap a step to open it. We do not give legal or tax advice, so ask the office if you are not sure what applies to your group.</p>

  <Route label="Steps to start a nonprofit or community group">
  <Milepost n={1} title="Become a nonprofit corporation, if you choose to" id="incorporate" open>
  {r('wv-sos-nonprofit-incorporation') && <ResourceCard r={r('wv-sos-nonprofit-incorporation')} showCost />}

  </Milepost>

  <Milepost n={2} title="Register before you ask the public for donations" id="register">
  {r('wv-sos-charity-registration') && <ResourceCard r={r('wv-sos-charity-registration')} showCost />}

  </Milepost>

  <Milepost n={3} title="Federal tax-exempt status is a separate step" id="tax-exempt">
  <Fact f={fact('irs-separate-step')} about="federal tax-exempt status" />
  <Fact f={fact('irs-articles-wording')} about="501(c)(3) wording in your articles" />
  <p>The IRS pages the state links: <a href="https://www.irs.gov/charities-non-profits">Charities and Nonprofits</a> and <a href="https://www.irs.gov/pub/irs-pdf/p557.pdf">Publication 557, Tax-Exempt Status for Your Organization (PDF)</a>.</p>

  </Milepost>
  </Route>

  <p>Looking for a group to join instead? See <a href={`${base}/community-centers/`}>Community centers and halls</a> and <a href={`${base}/make-it-better/`}>Make it better</a>.</p>

  <p class="meta">Sources checked October 30, 2026. Rules and fees can change, so check the state's page before you file. Something out of date? <a href={fixFormUrl({ page: Astro.url.pathname })}>Tell us</a>.</p>
</Base>
