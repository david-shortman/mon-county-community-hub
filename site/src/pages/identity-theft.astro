---
// Identity theft: what to do (#222, the Safety life area). Every step comes
// from USA.gov's identity theft, credit report and credit freeze pages and the
// WV Attorney General's identity theft page, all read 2026-11-01. The FTC's
// consumer site refused our reads, so it is linked only through IdentityTheft.gov
// as USA.gov names it. Credit freeze cost: USA.gov says it is free; the AG page
// says fees may apply, so the page gives USA.gov's rule and the AG's number,
// and the conflict is logged in docs/discoveries/.
// Phone numbers, dollar limits and time rules are fact records in
// content/facts/identity-theft/ (#122), re-read 2026-11-06.
import Base from '../layouts/Base.astro';
import SourceLine from '../components/SourceLine.astro';
import Icon from '../components/Icon.astro';
import Route from '../components/Route.astro';
import Milepost from '../components/Milepost.astro';
import Fact from '../components/Fact.astro';
import { factsFor } from '../lib/facts.mjs';
import { fixFormUrl } from '../lib/group-requests.mjs';
export const page = { door: "living-here", topic: "safety", label: "Identity theft: what to do", summary: "Report it, freeze your credit, call your bank, check your credit reports, and get help from the WV Attorney General" };
const checked = '2026-11-06';
const fact = factsFor('identity-theft');
const usaIt = [{ url: 'https://www.usa.gov/identity-theft', name: 'USAGov', checked }];
---
<Base title="Identity theft in Morgantown and Mon County, WV: what to do" description="If someone used your name, Social Security number or cards: report it at IdentityTheft.gov, freeze your credit, call your bank and call the WV Attorney General.">
  <h1>Identity theft: what to do</h1>
  <p class="lede">Did someone use your name, your Social Security number, or your card or account numbers? Start right away. Report it online at IdentityTheft.gov to get a list of steps to fix it, or call the Federal Trade Commission. The steps below have the numbers. Tap a step to open it.</p>
  <Fact f={fact('lost-wallet')} about="a lost wallet" />

  <h2 id="signs">Warning signs</h2>
  <p>USA.gov lists these signs:</p>
  <ul>
    <li>Bills for things you did not buy</li>
    <li>Debt collectors calling about accounts you did not open</li>
    <li>Accounts you did not open on your credit report</li>
    <li>A loan application turned down</li>
    <li>Mail that stops coming or goes missing</li>
  </ul>
  <SourceLine sources={usaIt} about="warning signs of identity theft" />

  <Route label="Steps after identity theft">
  <Milepost n={1} title="Report it to the FTC" when="Today" id="report" open>
  <Fact f={fact('report-ftc')} about="reporting identity theft" />
  <div class="actions">
    <a class="btn" href="https://www.identitytheft.gov/#/Steps"><Icon name="open" /><span>IdentityTheft.gov steps</span></a>
  </div>
  </Milepost>

  <Milepost n={2} title="Put a fraud alert or credit freeze on your credit" when="Today" id="freeze">
  <Fact f={fact('bureau-phones')} about="the credit reporting companies' phone numbers" />
  <Fact f={fact('credit-freeze')} about="credit freezes" />
  <Fact f={fact('extended-fraud-alert')} about="extended fraud alerts" />
  </Milepost>

  <Milepost n={3} title="Call your bank and card companies" when="Today" id="bank">
  <Fact f={fact('call-card-companies')} about="calling your bank" />
  <p>Reporting fast limits what you may owe, the Attorney General says:</p>
  <ul>
    <Fact tag="li" f={fact('credit-card-limit')} about="what you may owe on a credit card" />
    <Fact tag="li" f={fact('debit-card-limit')} about="what you may owe on a debit or ATM card" />
  </ul>
  </Milepost>

  <Milepost n={4} title="Check your credit reports" when="This week" id="reports">
  <Fact f={fact('free-reports')} about="free credit reports" />
  <Fact f={fact('space-reports')} about="spacing out your free reports" />
  <div class="actions">
    <a class="btn" href="https://www.annualcreditreport.com/"><Icon name="open" /><span>AnnualCreditReport.com</span></a>
  </div>
  </Milepost>

  <Milepost n={5} title="If someone filed taxes in your name" id="taxes">
  <Fact f={fact('tax-affidavit')} about="tax identity theft" />
  <div class="actions">
    <a class="btn" href="https://www.irs.gov/newsroom/when-to-file-an-identity-theft-affidavit"><Icon name="open" /><span>IRS: when to file Form 14039</span></a>
  </div>
  </Milepost>

  <Milepost n={6} title="Get help from the WV Attorney General" id="help">
  <Fact f={fact('ag-help')} about="the Consumer Protection Division" />
  <div class="actions">
    <a class="btn" href="https://ago.wv.gov/consumer-protection/file-complaint-consumer-protection-division"><Icon name="open" /><span>File a complaint</span></a>
  </div>
  </Milepost>
  </Route>

  <h2 id="protect">Protect yourself</h2>
  <p>USA.gov suggests: don't answer calls, texts or messages from people you don't know. Don't share your bank account number, Social Security number or birth date. Pick up your mail every day, and ask the post office to hold it when you are away. Keep your Social Security card in a safe place, not in your wallet.</p>
  <SourceLine sources={usaIt} about="protecting yourself" />

  <p class="meta">Each part shows the date we last checked its source. We describe the official steps; this is not legal advice. Something out of date? <a href={fixFormUrl({ page: Astro.url.pathname })}>Tell us</a>.</p>
</Base>
