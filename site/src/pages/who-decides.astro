    sources: [{ url: 'https://www.mub.org/', checked: day }, { url: 'https://www.morgantownwv.gov/263/Morgantown-Utility-Board-MUB', checked: day }, { url: 'https://www.morgantownwv.gov/210/Volunteer-Opportunities', checked: day }],
