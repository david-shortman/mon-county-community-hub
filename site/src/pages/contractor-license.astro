---
// Contractor and trade licenses in West Virginia, working inside Morgantown
// city limits, and checking a contractor before you hire (#604, #605, #608,
// part of #276). Every fact is from the board's, the state's or the city's
// own page. Held back until a person confirms them (#603): the state dollar
// amount that makes a job need a contractor license, board and city license
// fees, electrician license classes, and union locals. The page links the
// law instead of restating it. Permits for property owners are a separate
// page, /permits/ (#661), linked from the city section.
//
// Facts from the law, the Division of Labor, the Fire Marshal and the city
// are records in content/facts/contractor-license/ (#122), re-read November
// 14, 2026. The Contractor Licensing Board's own pages (how to apply, hours,
// license search, complaints) stay typed here: wvclboard.wv.gov asks robots
// not to read it, so a person re-reads them on the monthly person sources
// checklist (content/checklists/person-sources.yaml).
import Base from '../layouts/Base.astro';
import SourceLine from '../components/SourceLine.astro';
import ResourceCard from '../components/ResourceCard.astro';
import Icon from '../components/Icon.astro';
import { loadDir, telHref } from '../lib/content.mjs';
import { factsFor, factHtml, isDue } from '../lib/facts.mjs';
import { fixFormUrl } from '../lib/group-requests.mjs';
export const page = { door: "family", topic: "work", label: "Contractor and trade licenses", summary: "State contractor license, plumber, HVAC and electrician licenses, working in Morgantown city limits, and how to check a contractor before you hire" };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = loadDir('resources');
const r = (slug) => all.find((e) => e.slug === slug);
const fact = factsFor('contractor-license');
const permitFact = factsFor('permits');
// A group of facts shown as paragraphs with one source line: every source
// once, newest date, and "may be out of date" when any fact is due.
const group = (...facts) => {
  const m = new Map();
  for (const x of facts.flatMap((f) => f.sources)) if (!m.has(x.url) || x.checked > m.get(x.url).checked) m.set(x.url, x);
  return { items: facts.map((f) => factHtml(f.text, base)), sources: [...m.values()], stale: facts.some((f) => isDue(f)) };
};
const law = group(fact('law-definition'), fact('owner-exemption'), fact('post-license'));
const plumb = group(fact('plumber-license'), fact('plumber-classes'));
const hvac = group(fact('hvac-license'), fact('hvac-classes'));
const sfmContact = fact('fire-marshal-contact');
const sfm = group(fact('electrician-license'), fact('fire-marshal-portal'), sfmContact);
const cityLicense = group(fact('city-license'), fact('city-license-year'));
const cityPermits = group(permitFact('morgantown-apply-online'), permitFact('morgantown-one-per-scope'), fact('license-not-in-portal'));
const cityContact = fact('city-contact');
const cityMore = group(fact('city-limits-viewer'), cityContact);
const trades = group(fact('lookup-trades'));
// Typed: the board's own pages, read by a person (see above).
const checked = '2026-10-30';
const board = [
  { url: 'https://www.wvclboard.wv.gov/account/guide.asp', checked },
  { url: 'https://www.wvclboard.wv.gov/', checked },
];
const boardLookup = [{ url: 'https://www.wvclboard.wv.gov/verify/', checked }];
const complaint = [{ url: 'https://www.wvclboard.wv.gov/complaint/', checked }];
---
<Base title="Contractor licenses and checking a contractor in Morgantown" description="How West Virginia contractors, plumbers, HVAC techs and electricians get licensed, Morgantown's rules, and how to check a contractor or file a complaint.">
  <h1>Contractor and trade licenses</h1>
  <p class="lede">In West Virginia, contractors, plumbers, HVAC technicians and electricians each need their own license. Each one comes from a different state office. Working inside Morgantown city limits also takes a city business license. Hiring someone? See <a href="#check">check a contractor before you hire</a>.</p>

  <h2 id="contractor">State contractor license</h2>
  <p>The <strong>West Virginia Contractor Licensing Board</strong> issues state contractor licenses.</p>
  {law.items.map((h) => <p set:html={h} />)}
  <SourceLine sources={law.sources} about="West Virginia contractor law" stale={law.stale} />

  <h3>How to apply</h3>
  <p>The board's step by step guide says to finish steps 1 to 6 before you send your application:</p>
  <ol>
    <li>Email the board your scope of work at <a href="mailto:CLBoard@wv.gov">CLBoard@wv.gov</a>. The board tells you which license classification (the kind of work your license covers) and which exams you need.</li>
    <li>Take the exam through PROV, Inc. The person taking it must be an officer, member, owner, or full-time employee. A full-time employee needs payroll records as proof.</li>
    <li>Get a state tax number for your business, called a Business Registration Tax Number, from the West Virginia State Tax Department.</li>
    <li>Register with the West Virginia Secretary of State, if your business is required to. You can register online through the WV One Stop Business Center.</li>
    <li>Show proof of workers' compensation and unemployment compensation for all employees working in West Virginia. The guide also lists general liability insurance.</li>
    <li>Send a signed form about your wage bond status with your application. If you do commercial building work with employees, the guide says to check your status with the Division of Labor's Wage and Hour Section.</li>
    <li>Apply online, or download a PDF to fill in and mail.</li>
  </ol>
  <p>The guide lists a phone number for each office in these steps. The board is open Monday to Friday, 8 a.m. to 5 p.m. Call to confirm.</p>
  <SourceLine sources={board} about="the Contractor Licensing Board" />
  <div class="actions">
    <a class="btn" href="tel:+13045587890"><Icon name="phone" /><span>Call the board: (304) 558-7890</span></a>
    <a class="btn" href="https://www.wvclboard.wv.gov/account/guide.asp"><Icon name="open" /><span>Board's step by step guide</span></a>
  </div>

  <h2 id="plumber">Plumbers</h2>
  {plumb.items.map((h) => <p set:html={h} />)}
  <SourceLine sources={plumb.sources} about="plumber licenses" stale={plumb.stale} />
  <div class="actions">
    <a class="btn" href="https://labor.wv.gov/licensing/plumber-certification"><Icon name="open" /><span>Plumber license page</span></a>
  </div>

  <h2 id="hvac">Heating and cooling (HVAC)</h2>
  {hvac.items.map((h) => <p set:html={h} />)}
  <SourceLine sources={hvac.sources} about="HVAC certification" stale={hvac.stale} />
  <div class="actions">
    <a class="btn" href="https://labor.wv.gov/licensing/hvac-technician-certification"><Icon name="open" /><span>HVAC certification page</span></a>
  </div>

  <h2 id="electrician">Electricians</h2>
  {sfm.items.map((h) => <p set:html={h} />)}
  <SourceLine sources={sfm.sources} about="electrician licenses" stale={sfm.stale} />
  <div class="actions">
    <a class="btn" href={telHref(sfmContact.phone)}><Icon name="phone" /><span>{sfmContact.phone_label}: {sfmContact.phone}</span></a>
    <a class="btn" href="https://firemarshal.wv.gov/regulatory-and-licensing-division"><Icon name="open" /><span>Electrician licenses and exam dates</span></a>
  </div>

  <h2 id="morgantown">Working inside Morgantown city limits</h2>
  {cityLicense.items.map((h) => <p set:html={h} />)}
  <SourceLine sources={cityLicense.sources} org="city-of-morgantown" about="city business licenses" stale={cityLicense.stale} />
  <p>Building permits in the city:</p>
  <ul>
    {cityPermits.items.map((h) => <li set:html={h} />)}
  </ul>
  <SourceLine sources={cityPermits.sources} org="city-of-morgantown" about="city building permits" stale={cityPermits.stale} />
  <p>Outside Morgantown, or a property owner asking who issues permits? See <a href={`${base}/permits/`}>do I need a building permit?</a></p>
  {cityMore.items.map((h) => <p set:html={h} />)}
  <SourceLine sources={cityMore.sources} org="city-of-morgantown" about="city limits and City Hall" stale={cityMore.stale} />
  <div class="actions">
    <a class="btn" href="https://www.morgantownwv.gov/747/Permitting-Licensing-Registration"><Icon name="open" /><span>Morgantown Access Portal</span></a>
    <a class="btn" href={telHref(cityContact.phone)}><Icon name="phone" /><span>{cityContact.phone_label}: {cityContact.phone}</span></a>
  </div>
  {r('morgantown-business-license') && <ResourceCard r={r('morgantown-business-license')} showCost />}
  <p>Starting or growing a business? See <a href={`${base}/business/`}>start or grow a business</a> for free coaching and classes.</p>

  <h2 id="check">Check a contractor before you hire</h2>
  <p>You can look up a West Virginia contractor's license for free on the <strong>Contractor Licensing Board</strong> site. Search by license number (it starts with "WV"), or by classification, company name, city or county. The board says the search is updated in real time.</p>
  <SourceLine sources={boardLookup} about="the board's license search" />
  {trades.items.map((h) => <p set:html={h} />)}
  <p>The three buttons below are, in order: contractors, plumbers and HVAC, and electricians.</p>
  <SourceLine sources={trades.sources} about="plumber, HVAC and electrician searches" stale={trades.stale} />
  <div class="actions">
    <a class="btn" href="https://www.wvclboard.wv.gov/verify/"><Icon name="search" /><span>Contractor license search</span></a>
    <a class="btn" href="https://labor.wv.gov/database-search"><Icon name="search" /><span>Plumber and HVAC search</span></a>
    <a class="btn" href="https://sfm-permit-public.wvoasis.gov/publicdata/LicenseeSearch"><Icon name="search" /><span>Electrician search</span></a>
  </div>

  <h3>File a complaint with the board</h3>
  <p>The board takes complaints about contractors who are not licensed, and licensed contractors working outside their classification, on jobs above a set total cost. The amounts are on the board's complaint page. Anyone can file. The board does not take anonymous complaints.</p>
  <p>Include the contractor's name, address and phone number, where the job is, and copies of canceled checks, contracts or invoices. Do not send photos.</p>
  <p>The board says it cannot help with building code violations, contract disagreements, misused money or the quality of the work.</p>
  <SourceLine sources={complaint} about="board complaints" />
  <div class="actions">
    <a class="btn" href="https://www.wvclboard.wv.gov/complaint/"><Icon name="open" /><span>Board complaint page</span></a>
  </div>

  <p class="meta">Each source line says when we last read that page. We describe these rules and link the official pages; we do not decide whether a job needs a license. Something out of date? <a href={fixFormUrl({ page: Astro.url.pathname })}>Tell us</a>.</p>
</Base>
