---
// Disability and aging (#227, part of #210). Who serves Mon County, from each
// group's own site. Devices, school, rights, recreation and caregiver help
// added in #579, #581, #582, #583 and #584 (research: docs/groups/disability-caregivers.md).
// Home changes, leaving a nursing home and getting around: #578, #580, #562.
import Base from '../layouts/Base.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { loadDir } from '../lib/content.mjs';
import { fixFormUrl } from '../lib/group-requests.mjs';
export const page = { door: "family", topic: "disability", label: "Disability and aging", summary: "Independent living, home changes, devices, getting around, special education, your rights, recreation, caregiver help and Medicare help" };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = loadDir('resources');
const r = (slug) => all.find((e) => e.slug === slug);
---
<Base title="Disability and aging help in Morgantown and Mon County" description="Free independent living help from LiveAbility in Morgantown, help with ramps and home changes, free device loans from WVATS, accessible buses and half fares on Mountain Line, special education contacts, Disability Rights of WV, SteppingStones and Special Olympics, dementia caregiver groups, job help from DRS, and free Medicare help from WV SHIP.">
  <h1>Help with a disability, or as you get older</h1>
  <p class="lede">For help living on your own terms with a disability, call LiveAbility in Morgantown. For help getting or keeping a job, call DRS. For Medicare questions, call WV SHIP.</p>

  <h2>Living on your own terms</h2>
  {r('liveability-morgantown') && <ResourceCard r={r('liveability-morgantown')} />}

  <h2>Try, borrow or get a free used device</h2>
  {r('wvats-device-loans') && <ResourceCard r={r('wvats-device-loans')} />}

  <h2>Change your home or car</h2>
  {r('liveability-clsp') && <ResourceCard r={r('liveability-clsp')} />}

  <h2>Care at home instead of a nursing home</h2>
  <p>West Virginia Medicaid has four programs that pay for care at home for people who would otherwise need a nursing home or other facility. See <a href={`${base}/medicaid-waivers/`}>Getting care at home through Medicaid</a>: who each is for, how to start, and who to call.</p>
  {r('liveability-transition') && <ResourceCard r={r('liveability-transition')} />}

  <h2>Getting around without a car</h2>
  {r('mountain-line-access-and-half-fare') && <ResourceCard r={r('mountain-line-access-and-half-fare')} showCost />}
  {r('mountain-line-gold-card') && <ResourceCard r={r('mountain-line-gold-card')} showCost />}
  {r('mountain-line-deviations') && <ResourceCard r={r('mountain-line-deviations')} showCost />}
  {r('senior-monongalians-rides') && <ResourceCard r={r('senior-monongalians-rides')} />}
  <p>Going to a doctor? See <a href={`${base}/medical-rides/`}>Ride to a medical visit</a> for Medicaid rides and bus routes to the hospitals.</p>

  <h2>Getting or keeping a job</h2>
  {r('drs-morgantown-office') && <ResourceCard r={r('drs-morgantown-office')} showCost />}

  <h2>Special education at school</h2>
  {r('mcs-special-education') && <ResourceCard r={r('mcs-special-education')} />}
  <p>For children under 3, see <a href={`${base}/families-and-kids/`}>Families and kids</a> for WV Birth to Three.</p>

  <h2>Know your rights</h2>
  {r('drwv-intake') && <ResourceCard r={r('drwv-intake')} />}

  <h2>Sports, swimming and fun</h2>
  {r('steppingstones-recreation') && <ResourceCard r={r('steppingstones-recreation')} showCost />}
  {r('sowv-become-an-athlete') && <ResourceCard r={r('sowv-become-an-athlete')} />}

  <h2>If you care for someone with dementia</h2>
  {r('alz-wv-caregiver-groups') && <ResourceCard r={r('alz-wv-caregiver-groups')} />}

  <h2>Medicare and getting older</h2>
  {r('wv-ship-medicare-counseling') && <ResourceCard r={r('wv-ship-medicare-counseling')} />}
  <p>See also <a href={`${base}/turning-65/`}>Turning 65 or on Medicare</a> and <a href={`${base}/staying-well/`}>Staying well</a>. Veterans: see <a href={`${base}/veterans/`}>help for veterans</a>.</p>

  <p class="meta">Sources checked October 30, 2026. An older web address for a local disability center now belongs to an unrelated site, so we link only to each group's current site. Something out of date? <a href={fixFormUrl({ page: Astro.url.pathname })}>Tell us</a>.</p>
</Base>
