---
// Meet people and get a library card (#626, #627, #669; part of #270 and
// #278). Facts come from the resource records, and the neighborhood meeting
// times from the city's own page. Community centers belong to lane 5 and
// volunteering to lane 9; this page links to them. Not here yet: young
// professional and leadership groups, and library makerspace hours (#665).
import Base from '../layouts/Base.astro';
import ResourceCard from '../components/ResourceCard.astro';
import SourceLine from '../components/SourceLine.astro';
import { loadDir } from '../lib/content.mjs';
import { loadPages } from '../lib/pages.mjs';
import { FIX_FORM } from '../lib/group-requests.mjs';
export const page = { door: "community", topic: "community", label: "Meet people and get a library card", summary: "A free library card, free library programs for adults, and Morgantown neighborhood association meetings" };
const all = loadDir('resources');
const r = (slug) => all.find((e) => e.slug === slug);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pages = await loadPages();
const live = (href) => pages.has(href);
const nbhd = r('morgantown-neighborhood-associations');
---
<Base title="Meet people in Morgantown and Mon County: library card, programs, neighborhood groups" description="Ways for new residents and people who work from home to meet people in Morgantown and Monongalia County, WV: a free library card, free library programs for adults, and when each Morgantown neighborhood association meets.">
  <h1>Meet people and get a library card</h1>
  <p class="lede">New here, or working from home and want to get out? The library and your neighborhood association are free places to start.</p>
  <p>See how it could go: <a href={`${base}/meet-people/example/`}>an example first month for someone new in town</a> (a made-up person, real places).</p>

  <h2 id="library-card">Get a library card</h2>
  {r('mpls-library-card') && <ResourceCard r={r('mpls-library-card')} showCost />}

  <h2 id="library-programs">Free library programs for adults</h2>
  {r('mpls-adult-programs') && <ResourceCard r={r('mpls-adult-programs')} />}

  <h2 id="neighborhoods">Morgantown neighborhood associations</h2>
  {nbhd && !nbhd.hidden && (
    <>
      <p>{nbhd.who_it_is_for} {nbhd.what_to_do}</p>
      <ul>
        {(nbhd.meetings ?? []).map((m) => <li><strong>{m.name}:</strong> {m.when}</li>)}
      </ul>
      <p>Meeting times and places can change, so check the city's calendar before you go.</p>
      <div class="actions"><a class="btn" href={nbhd.contact.url}><span>City neighborhood page</span></a></div>
      <SourceLine sources={nbhd.sources} org={nbhd.org} about={nbhd.title} slug={nbhd.slug} />
    </>
  )}
  {nbhd && nbhd.hidden && <ResourceCard r={nbhd} />}

  <h2 id="work-from-home">If you work from home</h2>
  <p>The library's programs and events, above, are open to adults across the county. We have not yet confirmed local groups for young professionals or remote workers on their own pages, so we do not list them yet.</p>
  {live('/internet/') && <p>Need a place to work for a few hours? See <a href={`${base}/internet/#library`}>free Wi-Fi and computers at the library</a>.</p>}

  <h2 id="more">More ways to meet people</h2>
  <ul>
    {live('/community-centers/') && <li><a href={`${base}/community-centers/`}>Community centers and halls</a>: dinners, events and how to join</li>}
    {live('/make-it-better/') && <li><a href={`${base}/make-it-better/`}>Make it better</a>: help improve your town, or serve on a city board</li>}
    <li><a href={`${base}/calendar/`}>Dates</a>: what is coming up in Mon County</li>
  </ul>

  <p class="meta">Sources checked October 30, 2026. Know a group we should add? <a href={FIX_FORM}>Tell us</a>.</p>
</Base>
