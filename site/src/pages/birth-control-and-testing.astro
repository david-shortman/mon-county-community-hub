---
// Birth control, pregnancy tests and STI testing (#482, rank 11 in #475).
// Facts are in content/resources/monchd-reproductive-health.yaml and
// health-right-clinic.yaml, read 2026-10-30. Describe only, no advice.
import Base from '../layouts/Base.astro';
import { fixFormUrl } from '../lib/group-requests.mjs';
import ResourceCard from '../components/ResourceCard.astro';
import { loadDir } from '../lib/content.mjs';
export const page = { door: "care", topic: "health", label: "Birth control and testing", summary: "Free or low cost birth control, pregnancy tests and STI testing" };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = loadDir('resources');
const r = (slug) => all.find((e) => e.slug === slug);
---
<Base title="Birth control, pregnancy tests and STI testing in Morgantown and Mon County" description="Free or low cost, confidential birth control, pregnancy tests and STI testing in Morgantown at the Monongalia County Health Department, including for teens.">
  <h1>Birth control, pregnancy tests and STI testing</h1>
  <p class="lede">The Monongalia County Health Department offers free or low cost, confidential birth control, pregnancy tests and STI testing, including for teens. Call <a href="tel:3045985119">304-598-5119</a> for an appointment.</p>

  {r('monchd-reproductive-health') && <ResourceCard r={r('monchd-reproductive-health')} showCost headingLevel={2} />}

  <h2>Pregnant?</h2>
  <p>See <a href={`${base}/pregnant-or-new-baby/`}>Pregnant or new baby</a> for health coverage, WIC and help after the baby comes.</p>

  <p class="meta">Sources checked October 30, 2026. We describe these services; we do not give medical advice. Something out of date? <a href={fixFormUrl({ page: Astro.url.pathname })}>Tell us</a>.</p>
</Base>
