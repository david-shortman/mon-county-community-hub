{
  "name": "mon-county-community-hub-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "pagefind --site dist && node scripts/check-pages.mjs && node scripts/check-contrast.mjs && node scripts/check-weight.mjs && node scripts/check-api.mjs && node scripts/test-ics.mjs && node ../apps/mcp/test/smoke.mjs dist/api/v1",
    "check-pages": "node scripts/check-pages.mjs",
    "preview": "astro preview",
    "check-content": "node scripts/check-content.mjs && node scripts/check-needs.mjs",
    "check-sources": "node scripts/check-sources.mjs",
    "update-feeds": "node scripts/update-feeds.mjs",
    "health": "node scripts/health.mjs",
    "check-a11y": "node scripts/check-a11y.mjs",
    "check-contrast": "node scripts/check-contrast.mjs",
    "check-weight": "node scripts/check-weight.mjs",
    "check-api": "node scripts/check-api.mjs && node scripts/test-ics.mjs && node ../apps/mcp/test/smoke.mjs dist/api/v1",
    "secondhand-due": "node scripts/secondhand-due.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^5.18.2",
    "qrcode-generator": "^2.0.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "axe-core": "4.10.2",
    "pagefind": "1.5.2",
    "playwright": "1.63.0"
  }
}
